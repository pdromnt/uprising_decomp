START_SCRIPT_FILE

VDECL VINT DONE_SETUP 		0
VDECL VINT ACTION_TIME		0
VDECL VINT POWERUP		0
VDECL VINT TURRET			0
VDECL VINT TURSWAP		0
VDECL VINT POWERUP1		0
VDECL VINT PLAYER_SLOT     	0
VDECL VINT MISSION_FAILED  	0

VDECL VLOC TUR1_CLOSEPT LOC (218, 104, 3350)
VDECL VLOC TUR2_CLOSEPT LOC (214, 80, 3588)
VDECL VLOC TURRET LOC (214, 91, 2600)
VDECL VLOC TURSWAP1 LOC (151, 44, 0)
VDECL VLOC TURSWAP2 LOC (151, 44, 0)
VDECL VLOC TURSWAP3 LOC (151, 44, 0)


IF ( VBL_TEST DONE_SETUP EQUAL 0 ) THEN
(
	SET_USE_DEFAULT_VICTORY 0
	CHANGE_VBL DONE_SETUP SET 1
)

IF (VBL_TEST POWERUP EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_A 0 LOC(239, 49, 1566) PU_BOMBERS 2
	CHANGE_VBL POWERUP SET 1
)

IF (VBL_TEST POWERUP1 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_B 0 LOC(30, 211, 0) PU_BOMBERS 1

	CHANGE_VBL POWERUP1 SET 1
)

IF (VBL_TEST TURRET EQUAL 0) THEN
(
	IF (OR ((CLOSE_PT HTANK 0 TUR1_CLOSEPT 7)(CLOSE_PT HTANK 0 TUR2_CLOSEPT 7)) ) THEN
	(		
		CREATE_UNIT TURRET1 5 HEAVY_TURRET TURRET YAW (0) NULL NULL
		CHANGE_VBL TURRET SET 1
	)
) 

IF (VBL_TEST TURSWAP EQUAL 0) THEN
(
	CREATE_UNIT TURSWAP1 5 HEAVY_TURRET TURSWAP1 YAW (0) NULL NULL
 	CHANGE_VBL TURSWAP SET 1
)

IF (AND ((LIVED_AND_DIED TURSWAP1)(VBL_TEST TURSWAP EQUAL 1)) ) THEN
(
	CHANGE_VBL ACTION_TIME SET GAME_TIME
	CHANGE_VBL ACTION_TIME ADD 1
	CHANGE_VBL TURSWAP SET 2	
)

IF (AND ((VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME)(VBL_TEST TURSWAP EQUAL 2)) )  THEN
(	
	CREATE_UNIT TURSWAP2 5 HEAVY_TURRET TURSWAP2 YAW (0) NULL NULL
	CHANGE_VBL TURSWAP SET 3	
)
		
	IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
	(
		CHANGE_VBL MISSION_FAILED SET 1
	)
	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT ALL ) THEN
		(
			END_MISSION PLAYER_SLOT 1 5 {MISSION ACCOMPLISHED}
			CHANGE_VBL MISSION_FAILED SET 1
		)
	)


	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
		(

			IF ( NOT ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT 0 ) ) THEN
			(
				END_MISSION PLAYER_SLOT 0 5 {MISSION FAILED}
			)
		)
	)


END_SCRIPT_FILE
