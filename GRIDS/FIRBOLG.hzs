START_SCRIPT_FILE

START_SECTION_OPTIONAL

############- VARIABLE DECLARATIONS -###############################################################
#  C-O-N-S-T-A-N-T-S
VDECL VLOC LEADER00_START_LOC LOC ( 52, 64, 0 ) 
VDECL VLOC ESCORTTANK00_START_LOC LOC ( 48, 67, 0 )
VDECL VLOC ESCORTTANK01_START_LOC LOC ( 56, 67, 0 )
VDECL VLOC ESCORTAAV00_START_LOC LOC ( 48, 66, 0 )
VDECL VLOC ESCORTAAV01_START_LOC LOC ( 56, 66, 0 )
 
VDECL VLOC LEADER10_START_LOC LOC ( 144, 132, 0 )
VDECL VLOC ESCORTTANK10_START_LOC LOC ( 140, 135, 0 )
VDECL VLOC ESCORTTANK11_START_LOC LOC ( 148, 135, 0 )
VDECL VLOC ESCORTAAV10_START_LOC LOC ( 140, 135, 0 )
VDECL VLOC ESCORTAAV11_START_LOC LOC ( 148, 135, 0 )

VDECL VLOC LEADER20_START_LOC LOC ( 204, 184, 0 )
VDECL VLOC ESCORTTANK20_START_LOC LOC ( 200, 189, 0 )
VDECL VLOC ESCORTTANK21_START_LOC LOC ( 208, 189, 0 )
VDECL VLOC ESCORTAAV20_START_LOC LOC ( 200, 189, 0 )
VDECL VLOC ESCORTAAV21_START_LOC LOC ( 208, 189, 0 )

VDECL VINT UNIT_CREATION_CONSTANT0 	60
VDECL VINT UNIT_CREATION_CONSTANT1 	60
VDECL VINT UNIT_CREATION_CONSTANT2 	60

VDECL VINT MAP_LOSS_CONSTANT 		10
VDECL VINT TPORT_TIME_CONST 		5

VDECL VINT TELEPORT_RADIUS 		3
VDECL VINT ACTIVATION_RADIUS 		6

VDECL VINT LEADER00_NAV_VAR 		1
VDECL VINT LEADER10_NAV_VAR 		2
VDECL VINT LEADER20_NAV_VAR 		3


#  D-Y-N-A-M-I-C-S

VDECL VINT END_GAME_DELAY 		0

VDECL VINT LEADER00_OWNER 		4
VDECL VINT LEADER10_OWNER 		4
VDECL VINT LEADER20_OWNER 		4 

VDECL VINT UNIT_CREATION_TIME0 	0
VDECL VINT UNIT_CREATION_TIME1 	0
VDECL VINT UNIT_CREATION_TIME2 	0

VDECL VINT UNITS_TELEPORTED_TOTAL 	0
VDECL VINT UNITS_TELEPORTED_TOTAL0 	0
VDECL VINT UNITS_TELEPORTED_TOTAL1 	0
VDECL VINT UNITS_TELEPORTED_TOTAL2 	0
VDECL VINT UNITS_TELEPORTED_TOTAL3 	0

VDECL VINT TIME_TO_SHOW_COUNT 	0
VDECL VINT TIME_TO_SHOW_COUNT0 	0
VDECL VINT TIME_TO_SHOW_COUNT1 	0
VDECL VINT TIME_TO_SHOW_COUNT2 	0
VDECL VINT TIME_TO_SHOW_COUNT3 	0

VDECL VINT END_TPORT_TIME0 		0
VDECL VINT END_TPORT_TIME1 		0
VDECL VINT END_TPORT_TIME2 		0

VDECL VINT BONUS_PLACED00 		0
VDECL VINT BONUS_PLACED01 		0
VDECL VINT BONUS_PLACED02 		0

VDECL VINT PLAYER 			0

VDECL VINT CIT_COUNT 			0
VDECL VINT LOOPCIT			0



START_SECTION_SP_ONLY


CHANGE_VBL CIT_COUNT SET 0
FOR LOOPCIT EQUAL 0 TO 2 DO
(
	IF ( CITADEL_OWNED 4 LOOPCIT ) THEN
	(
		CHANGE_VBL CIT_COUNT ADD 1
	)
)

IF ( VBL_TEST CIT_COUNT LESS_THAN_EQUAL 1 ) THEN
(

	CHANGE_VBL LFL_SETTINGS ATTACK_PLAYER_RATE SET 45
	CHANGE_VBL LFL_SETTINGS IMPERIUM_DEFENSIVE_SOLDIER_CAP SET 9
	CHANGE_VBL LFL_SETTINGS IMPERIUM_DEFENSIVE_TANK_CAP SET 5
	CHANGE_VBL LFL_SETTINGS IMPERIUM_DEFENSIVE_SOLDIERS SET 7
	CHANGE_VBL LFL_SETTINGS IMPERIUM_DEFENSIVE_TANKS SET 3
	CHANGE_VBL LFL_SETTINGS IMPERIUM_DEFENSIVE_AAVS SET 1

)




SET_USE_DEFAULT_VICTORY 1

############- MARCH ON MY GIBBLING MASSES OF DESTRUCTION -###########################################


SET_TPORT_OWNER TPORT00 4

# RESET TELEPORTER
IF ( VBL_TEST END_TPORT_TIME0 LESS_THAN_EQUAL GAME_TIME ) THEN
(
	IF ( VBL_TEST END_TPORT_TIME1 LESS_THAN_EQUAL GAME_TIME ) THEN
	(
		IF ( VBL_TEST END_TPORT_TIME2 LESS_THAN_EQUAL GAME_TIME ) THEN
		(
			SET_TELEPORTER TPORT00 0
		)
	)
)


#**CITADEL0*******************************************************************************************
IF ( VBL_TEST BONUS_PLACED00 LESS_THAN 0  ) THEN
(
	IF ( NOT ( CITADEL_OWNED 4 0 ) ) THEN
	(
		CHANGE_VBL BONUS_PLACED00 ADD 1
		CREATE_FIXED_PU NULL 0 LEADER00_START_LOC PU_BOMBERS 1
		CREATE_FIXED_PU NULL 0 ESCORTTANK00_START_LOC PU_AAVS 1
		CREATE_FIXED_PU NULL 0 ESCORTTANK01_START_LOC PU_TANKS 1
	)
)

	
IF (VBL_TEST END_TPORT_TIME0 LESS_THAN_EQUAL GAME_TIME ) THEN
(
	
# CHECK TO SEE IF THE LEADER00 HAS REACHED THE TELEPORTER
IF ( CLOSE_PT  LEADER00 LOC ( 32, 228, 0 ) 3 ) THEN
(

		# SET TELEPORT RESET TIME
		CHANGE_VBL END_TPORT_TIME0 SET GAME_TIME
		CHANGE_VBL END_TPORT_TIME0 ADD TPORT_TIME_CONST


		# REMOVE UNIT
		KILLER_SAT LEADER00_OWNER LOC ( 32, 228, 0 )
		REMOVE_UNIT LEADER00

		# REMOVE ALL ESCORTS
		REMOVE_UNIT ESCORT_AAV00
		REMOVE_UNIT ESCORT_AAV01
		REMOVE_UNIT ESCORT_TANK00
		REMOVE_UNIT ESCORT_TANK01
			 
		# ADD ONE TO THE TELEPORTED UNITS TOTAL
		CHANGE_VBL UNITS_TELEPORTED_TOTAL ADD 1
		CHANGE_VBL TIME_TO_SHOW_COUNT SET 1

)
)


# CHECK TO SEE IF LEADER00 IS NOT ALIVE
IF ( NOT ( IS_ALIVE LEADER00 ) ) THEN
(


	# turn off teleporter immediately
	CHANGE_VBL END_TPORT_TIME0 SET 0

	# KILL ESCORTS
	DESTROY_UNIT ESCORT_AAV00
	DESTROY_UNIT ESCORT_AAV01
	DESTROY_UNIT ESCORT_TANK00
	DESTROY_UNIT ESCORT_TANK01


	# CHECK TO SEE IF THE CITADEL ASSOCIATED WITH THE PATH TO TELEPORTER IS OWNED BY IMPERIUM
	IF ( CITADEL_OWNED 4 0 ) THEN
	(

		# CHECKING HOW LONG IT'S BEEN SINCE THE LEADER00 WAS GENERATED
		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL UNIT_CREATION_TIME0 ) THEN
		(
	
			# CREATE LEADER00 AND ASSIGN TO PATH
			CREATE_UNIT LEADER00 4 CONVOY_TRUCK LEADER00_START_LOC YAW (90)  NULL  ESCORT_AAV00 
			SET_MOVEMENT_PATH LEADER00 TPATH0

			# SET NEW LEADER00 CREATION TIME
			CHANGE_VBL UNIT_CREATION_TIME0 SET GAME_TIME
			CHANGE_VBL UNIT_CREATION_TIME0 ADD UNIT_CREATION_CONSTANT0

			# CREATE ESCORT ESCORT_TANK00 AND ASSIGN TO LEADER00
			CREATE_UNIT  ESCORT_TANK00 5 AI_TANK ESCORTTANK00_START_LOC YAW (90)  LEADER00  ESCORT_TANK01 
			SET_MOVEMENT_PATH ESCORT_TANK00 AAVPATH00 

			# CREATE ESCORT ESCORT_TANK01 AND ASSIGN TO LEADER01
			CREATE_UNIT  ESCORT_TANK01 5 AI_TANK ESCORTTANK01_START_LOC YAW (90)  ESCORT_TANK00  ESCORT_AAV00  
			SET_MOVEMENT_PATH ESCORT_TANK01 AAVPATH01

			# CREATE ESCORT AAV00 AND ASSIGN TO LEADER00
			CREATE_UNIT  ESCORT_AAV00 5 AAV ESCORTAAV00_START_LOC YAW (90)  ESCORT_TANK01  ESCORT_AAV01 
			SET_MOVEMENT_PATH ESCORT_AAV00 AAVPATH00 

			# CREATE ESCORT AAV01 AND ASSIGN TO LEADER01
			CREATE_UNIT  ESCORT_AAV01 5 AAV ESCORTAAV01_START_LOC YAW (90)  ESCORT_AAV00  NULL  
			SET_MOVEMENT_PATH ESCORT_AAV01 AAVPATH01

			# CREATE BOMBER AND ASSIGN TO LEADER01
			CREATE_UNIT  BOMBER01 5 BOMBER LEADER00_START_LOC YAW (90) NULL  NULL  
			SET_MOVEMENT_PATH BOMBER01 BOMBER01


		)

	)

)



#**CITADEL1*********************************************************************************


IF ( VBL_TEST BONUS_PLACED00 LESS_THAN 0  ) THEN
(
	IF ( NOT ( CITADEL_OWNED 4 1 ) ) THEN
	(
		CHANGE_VBL BONUS_PLACED00 ADD 1
		CREATE_FIXED_PU NULL 0 LEADER10_START_LOC PU_BOMBERS 1
		CREATE_FIXED_PU NULL 0 ESCORTTANK10_START_LOC PU_AAVS 1
		CREATE_FIXED_PU NULL 0 ESCORTTANK11_START_LOC PU_TANKS 1
	)
)




IF (VBL_TEST END_TPORT_TIME0 LESS_THAN_EQUAL GAME_TIME ) THEN
(
	
# CHECK TO SEE IF THE LEADER10 HAS REACHED THE TELEPORTER
IF ( CLOSE_PT  LEADER10 LOC ( 32, 228, 0 ) 3 ) THEN
(

		# SET TELEPORT RESET TIME
		CHANGE_VBL END_TPORT_TIME1 SET GAME_TIME
		CHANGE_VBL END_TPORT_TIME1 ADD TPORT_TIME_CONST


		# REMOVE UNIT
		KILLER_SAT LEADER10_OWNER LOC ( 32, 228, 0 )
		REMOVE_UNIT LEADER10
		 
		# KILL ESCORTS
		REMOVE_UNIT ESCORT_AAV10
		REMOVE_UNIT ESCORT_AAV11
		REMOVE_UNIT ESCORT_TANK10
		REMOVE_UNIT ESCORT_TANK11

		# ADD ONE TO THE TELEPORTED UNITS TOTAL
		CHANGE_VBL UNITS_TELEPORTED_TOTAL ADD 1
		CHANGE_VBL TIME_TO_SHOW_COUNT SET 1

)
)

# CHECK TO SEE IF LEADER10 IS NOT ALIVE
IF ( NOT ( IS_ALIVE LEADER10 ) ) THEN
(


	# turn off teleporter immediately
	CHANGE_VBL END_TPORT_TIME1 SET 0

	# KILL ESCORTS
	DESTROY_UNIT ESCORT_AAV10
	DESTROY_UNIT ESCORT_AAV11
	DESTROY_UNIT ESCORT_TANK10
	DESTROY_UNIT ESCORT_TANK11


	# CHECK TO SEE IF THE CITADEL ASSOCIATED WITH THE PATH TO TELEPORTER IS OWNED BY IMPERIUM
	IF ( CITADEL_OWNED 4 1 ) THEN
	(

		# CHECKING HOW LONG IT'S BEEN SINCE THE LEADER10 WAS GENERATED
		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL UNIT_CREATION_TIME1 ) THEN
		(
	
			# CREATE LEADER10 AND ASSIGN TO PATH
			CREATE_UNIT LEADER10 4 CONVOY_TRUCK LEADER10_START_LOC YAW (90)  NULL  ESCORT_AAV10 
			SET_MOVEMENT_PATH LEADER10 TPATH1

			# SET NEW LEADER10 CREATION TIME
			CHANGE_VBL UNIT_CREATION_TIME1 SET GAME_TIME
			CHANGE_VBL UNIT_CREATION_TIME1 ADD UNIT_CREATION_CONSTANT1

			# CREATE ESCORT ESCORT_TANK10 AND ASSIGN TO LEADER10
			CREATE_UNIT  ESCORT_TANK10 5 AI_TANK ESCORTTANK10_START_LOC YAW (90)  LEADER10  ESCORT_TANK11 
			SET_MOVEMENT_PATH ESCORT_TANK10 AAVPATH10 

			# CREATE ESCORT ESCORT_TANK11 AND ASSIGN TO LEADER10
			CREATE_UNIT  ESCORT_TANK11 5 AI_TANK ESCORTTANK11_START_LOC YAW (90)  ESCORT_TANK10  ESCORT_AAV10  
			SET_MOVEMENT_PATH ESCORT_TANK11 AAVPATH11

			# CREATE ESCORT AAV00 AND ASSIGN TO LEADER10
			CREATE_UNIT  ESCORT_AAV10 5 AAV ESCORTAAV10_START_LOC YAW (90)  ESCORT_TANK11  ESCORT_AAV11 
			SET_MOVEMENT_PATH ESCORT_AAV10 AAVPATH10 

			# CREATE ESCORT AAV01 AND ASSIGN TO LEADER10
			CREATE_UNIT  ESCORT_AAV11 5 AAV ESCORTAAV11_START_LOC YAW (90)  ESCORT_AAV10  NULL  
			SET_MOVEMENT_PATH ESCORT_AAV11 AAVPATH11


			CREATE_UNIT  BOMBER11 5 BOMBER LEADER10_START_LOC YAW (90) NULL  NULL  
			SET_MOVEMENT_PATH BOMBER11 BOMBER11




		)

	)

)



#**CITADEL2***********************************************************************************

IF ( VBL_TEST BONUS_PLACED00 LESS_THAN 0  ) THEN
(
	IF ( NOT ( CITADEL_OWNED 4 2 ) ) THEN
	(
		CHANGE_VBL BONUS_PLACED00 ADD 1
		CREATE_FIXED_PU NULL 0 LEADER20_START_LOC PU_BOMBERS 1
		CREATE_FIXED_PU NULL 0 ESCORTTANK20_START_LOC PU_AAVS 1
		CREATE_FIXED_PU NULL 0 ESCORTTANK21_START_LOC PU_TANKS 1
	)
)


IF (VBL_TEST END_TPORT_TIME0 LESS_THAN_EQUAL GAME_TIME ) THEN
(
	
# CHECK TO SEE IF THE LEADER20 HAS REACHED THE TELEPORTER
IF ( CLOSE_PT  LEADER20 LOC ( 32, 228, 0 ) 3 ) THEN
(

		# SET TELEPORT RESET TIME
		CHANGE_VBL END_TPORT_TIME2 SET GAME_TIME
		CHANGE_VBL END_TPORT_TIME2 ADD TPORT_TIME_CONST

		# REMOVE UNIT
		KILLER_SAT LEADER20_OWNER LOC ( 32, 228, 0 )
		REMOVE_UNIT LEADER20

		# REMOVE ESCORTS		 
		REMOVE_UNIT ESCORT_AAV20
		REMOVE_UNIT ESCORT_AAV21
		REMOVE_UNIT ESCORT_TANK20
		REMOVE_UNIT ESCORT_TANK21

		# ADD ONE TO THE TELEPORTED UNITS TOTAL
		CHANGE_VBL UNITS_TELEPORTED_TOTAL ADD 1
		CHANGE_VBL TIME_TO_SHOW_COUNT SET 1
	)
)


# CHECK TO SEE IF LEADER20 IS NOT ALIVE
IF ( NOT ( IS_ALIVE LEADER20 ) ) THEN
(


	# turn off teleporter immediately
	CHANGE_VBL END_TPORT_TIME2 SET 0

	# DESTROY ESCORTS 
	DESTROY_UNIT ESCORT_AAV20
	DESTROY_UNIT ESCORT_AAV21
	DESTROY_UNIT ESCORT_TANK20
	DESTROY_UNIT ESCORT_TANK21

	# CHECK TO SEE IF THE CITADEL ASSOCIATED WITH THE PATH TO TELEPORTER IS OWNED BY IMPERIUM
	IF ( CITADEL_OWNED 4 2 ) THEN
	(

		# CHECKING HOW LONG IT'S BEEN SINCE THE LEADER20 WAS GENERATED
		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL UNIT_CREATION_TIME2 ) THEN
		(
	
# CREATE LEADER20 AND ASSIGN TO PATH
			CREATE_UNIT LEADER20 4 CONVOY_TRUCK LEADER20_START_LOC YAW (90)  NULL  ESCORT_AAV20 
			SET_MOVEMENT_PATH LEADER20 TPATH2

			# SET NEW LEADER20 CREATION TIME
			CHANGE_VBL UNIT_CREATION_TIME2 SET GAME_TIME
			CHANGE_VBL UNIT_CREATION_TIME2 ADD UNIT_CREATION_CONSTANT2

			# CREATE ESCORT ESCORT_TANK20 AND ASSIGN TO LEADER20
			CREATE_UNIT  ESCORT_TANK20 5 AI_TANK ESCORTTANK20_START_LOC YAW (90)  LEADER20  ESCORT_TANK21 
			SET_MOVEMENT_PATH ESCORT_TANK20 AAVPATH20 

			# CREATE ESCORT ESCORT_TANK21 AND ASSIGN TO LEADER20
			CREATE_UNIT  ESCORT_TANK21 5 AI_TANK ESCORTTANK21_START_LOC YAW (90)  ESCORT_TANK20  ESCORT_AAV20  
			SET_MOVEMENT_PATH ESCORT_TANK21 AAVPATH21

			# CREATE ESCORT AAV00 AND ASSIGN TO LEADER20
			CREATE_UNIT  ESCORT_AAV20 5 AAV ESCORTAAV20_START_LOC YAW (90)  ESCORT_TANK21  ESCORT_AAV21 
			SET_MOVEMENT_PATH ESCORT_AAV20 AAVPATH20 

			# CREATE ESCORT AAV01 AND ASSIGN TO LEADER01
			CREATE_UNIT  ESCORT_AAV21 5 AAV ESCORTAAV21_START_LOC YAW (90)  ESCORT_AAV20  NULL  
			SET_MOVEMENT_PATH ESCORT_AAV21 AAVPATH21


			CREATE_UNIT  BOMBER21 5 BOMBER LEADER20_START_LOC YAW (90) NULL  NULL  
			SET_MOVEMENT_PATH BOMBER21 BOMBER21




		)

	)

)

##### UPDATE LEADER NAV POINTS #################################################

UPDATE_NP LEADER00 LEADER00_NAV_VAR 
UPDATE_NP LEADER10 LEADER10_NAV_VAR 
UPDATE_NP LEADER20 LEADER20_NAV_VAR 

# AAH! THE END OF ALL THAT CONFUSING NONSENSE ABOUT UNITS TELEPORTING AND STUFF 


#############- GAME ENDING CONDITIONS -########################################################
# CHECKING FOR LOSS CONDITION
IF ( VBL_TEST UNITS_TELEPORTED_TOTAL GREATER_THAN_EQUAL MAP_LOSS_CONSTANT ) THEN
(
	
	# ENDING GAME ------ YOU LOSE SUCKER!!!!!
	END_MISSION 0 0 10 {10 UNITS HAVE TELEPORTED TO THE MOTHERSHIP \N You lose sucker!!!}

)



# CHECKING FOR VICTORY CONDITIONS
IF ( CITADEL_OWNED_W_STRG_TOWER 0 ALL ) THEN
(
	IF ( 	AND ( NOT ( IS_ALIVE LEADER20 )    
		AND ( NOT ( IS_ALIVE LEADER10 ) 
		NOT ( IS_ALIVE LEADER00 ) ))) THEN
	(

		IF ( VBL_TEST UNITS_TELEPORTED_TOTAL LESS_THAN MAP_LOSS_CONSTANT ) THEN	
		(
	
			# ENDING GAME ------ YOU WIN!!!!!
			SHOW_BILLBOARD {Congratulations you've prevented the imperium from amassing enough units to defeat us.}
			END_MISSION 0 1 15 {Congratulations you've prevented the imperium from amassing enough units to defeat us.}
	
			
		)

	)

)


#############################################################################################################
# TELEPORTED TANK COUNTS

IF ( VBL_TEST  TIME_TO_SHOW_COUNT EQUAL 1 ) THEN
(
	
	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  1 ) THEN
	(
	
		SHOW_BILLBOARD { 1 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  2 ) THEN
	(
	
		SHOW_BILLBOARD { 2 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)


	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  3 ) THEN
	(
	
		SHOW_BILLBOARD { 3 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  4 ) THEN
	(
	
		SHOW_BILLBOARD { 4 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  5 ) THEN
	(
	
		SHOW_BILLBOARD { 5 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  6 ) THEN
	(
	
		SHOW_BILLBOARD { 6 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  7 ) THEN
	(
	
		SHOW_BILLBOARD { 7 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  8 ) THEN
	(
	
		SHOW_BILLBOARD { 8 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  9 ) THEN
	(
	
		SHOW_BILLBOARD { 9 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  10 ) THEN
	(
	
		SHOW_BILLBOARD { 10 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  11 ) THEN
	(
	
		SHOW_BILLBOARD { 11 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  12 ) THEN
	(
	
		SHOW_BILLBOARD { 12 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  13 ) THEN
	(
	
		SHOW_BILLBOARD { 13 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  14 ) THEN
	(
	
		SHOW_BILLBOARD { 14 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  15 ) THEN
	(
	
		SHOW_BILLBOARD { 15 I.P.B. MISSLE TELEPORTED TO THE ENEMY FLAGSHIP } 5

	)

	IF ( VBL_TEST  UNITS_TELEPORTED_TOTAL  EQUAL  16 ) THEN
	(
	
