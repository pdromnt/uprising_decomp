###### TELEPORTING IN PLAYER UNITS #############################################
###### CITADEL01 #########################################################

IF (  AND( NOT ( IS_ALIVE TROOP_TRANS011 ) 
	AND( NOT ( IS_ALIVE TROOP_TRANS012 )
	AND( NOT ( IS_ALIVE TANK011 ) 
	AND( NOT ( IS_ALIVE TANK012 )
	AND( NOT ( IS_ALIVE TANK013 ) 
	AND( NOT ( IS_ALIVE TANK014 )
	AND( NOT ( IS_ALIVE AAV11 ) 
	AND( NOT ( IS_ALIVE AAV12 )
	AND( NOT ( IS_ALIVE AAV13 )
	NOT (IS_ALIVE AAV14 )))) )))) ))) THEN
(
		CHANGE_VBL UNITS_CREATED01 SET 0
)

IF ( VBL_TEST UNITS_CREATED01 GREATER_THAN_EQUAL 10 ) THEN
(
		CHANGE_VBL CITADEL_REFRESH01 SET GAME_TIME
		CHANGE_VBL CITADEL_REFRESH01 ADD REFRESH_CONST 
)

#### REMOVE SUPERFLUOS UNITS ###################################################
IF ( OR ( 
AND (CLOSE_PT TANK011 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN011 5)
AND (CLOSE_PT TANK011 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN011 7))) THEN
(
		REMOVE_UNIT TANK011
)

IF ( OR ( 
AND (CLOSE_PT TANK012 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN011 5)
AND (CLOSE_PT TANK012 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN011 7))) THEN
(
		REMOVE_UNIT TANK012
)

IF ( OR ( 
AND (CLOSE_PT TANK013 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN011 5)
AND (CLOSE_PT TANK013 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN011 7))) THEN
(
		REMOVE_UNIT TANK013
)

IF ( OR ( 
AND (CLOSE_PT TANK014 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN012 5)
AND (CLOSE_PT TANK014 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN012 7))) THEN
(
		REMOVE_UNIT TANK014
)

IF ( OR ( 
AND (CLOSE_PT AAV11 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN011 5)
AND (CLOSE_PT AAV11 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN011 7))) THEN
(
		REMOVE_UNIT AAV11
)

IF ( OR ( 
AND (CLOSE_PT AAV12 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN011 5)
AND (CLOSE_PT AAV12 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN011 7))) THEN
(
		REMOVE_UNIT AAV12
)

IF ( OR ( 
AND (CLOSE_PT AAV13 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN012 5)
AND (CLOSE_PT AAV13 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN012 7))) THEN
(
		REMOVE_UNIT AAV13
)

IF ( OR ( 
AND (CLOSE_PT AAV14 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN012 5)
AND (CLOSE_PT AAV14 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN012 7))) THEN
(
		REMOVE_UNIT AAV14
)

IF ( OR ( 
AND (CLOSE_PT TROOP_TRANS011 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN011 5)
AND (CLOSE_PT TROOP_TRANS011 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN011 7))) THEN
(
		REMOVE_UNIT TROOP_TRANS011
)

IF ( OR ( 
AND (CLOSE_PT TROOP_TRANS012 CLAIM05 64 CITADEL_OWNED TROOP_TRANS_OWN012 5)
AND (CLOSE_PT TROOP_TRANS012 CLAIM07 64 CITADEL_OWNED TROOP_TRANS_OWN012 7))) THEN
(
		REMOVE_UNIT TROOP_TRANS012
)





IF ( VBL_TEST CITADEL_REFRESH01 LESS_THAN_EQUAL GAME_TIME ) THEN
(

	###### INFORM PLAYER WHEN UNITS ARE READY FOR TELEPORTATION ########
	IF ( CITADEL_OWNED PLAYER 1 ) THEN
	(
		IF ( VBL_TEST MESSAGE01 EQUAL 0 ) THEN
		(
			IF ( NOT ( AND ( CITADEL_OWNED PLAYER 7 CITADEL_OWNED PLAYER 5 ))) THEN
			(
				SHOW_BILLBOARD PLAYER { TELEPORTATION LOCK ESTABLISHED J-9 \n TARGET CITADELS AT F-10 AND J-5 }
				CHANGE_VBL MESSAGE01 SET 1
			)

			IF ( AND ( CITADEL_OWNED PLAYER 7 NOT ( CITADEL_OWNED PLAYER 5 ))) THEN
			(
				SHOW_BILLBOARD PLAYER { TELEPORTATION LOCK ESTABLISHED J-9 \n TARGET REALLOCATION CITADEL F-10 }
				CHANGE_VBL MESSAGE01 SET 1
			)

			IF ( AND ( CITADEL_OWNED PLAYER 5 NOT ( CITADEL_OWNED PLAYER 7 ))) THEN
			(
				SHOW_BILLBOARD PLAYER { TELEPORTATION LOCK ESTABLISHED J-9 \n TARGET REALLOCATION CITADEL J-5 }
				CHANGE_VBL MESSAGE01 SET 1
			)

		)
	)

	IF ( AND ( CITADEL_OWNED PLAYER 1  CLOSE_PT HTANK PLAYER CLAIM01 5 ) ) THEN
	(
		IF ( AND ( CITADEL_OWNED PLAYER 5 CITADEL_OWNED PLAYER 7 ) ) THEN
		(
			SHOW_BILLBOARD PLAYER { All destination citadels are already owned by you. }

		)
		ELSE
		(	


			IF ( VBL_TEST UNIT_REFRESH01 LESS_THAN_EQUAL GAME_TIME ) THEN
			(

				IF ( NOT ( OR ( IS_ALIVE TANK012  IS_ALIVE TANK011 ) ) ) THEN
				(
					CHANGE_VBL UNITS_CREATED01 ADD 2
					CHANGE_VBL MESSAGE01 SET 0
					CHANGE_VBL UNIT_REFRESH01 SET GAME_TIME
					CHANGE_VBL UNIT_REFRESH01 ADD TANK_DELAY 

					IF ( NOT ( CITADEL_OWNED PLAYER 5 ) ) THEN
					(
						CREATE_UNIT TANK012 PLAYER AI_TANK TA12 YAW (180) NULL NULL
						CREATE_UNIT TANK011 PLAYER AI_TANK TA13 YAW (180) NULL NULL 
						SET_MOVEMENT_PATH TANK012 PATHTR15
						SET_MOVEMENT_PATH TANK011 PATHTL15
					)
					ELSE
					(
						CREATE_UNIT TANK012 PLAYER AI_TANK TA12 YAW (90) NULL NULL
						CREATE_UNIT TANK011 PLAYER AI_TANK TA11 YAW (90) NULL NULL 
						SET_MOVEMENT_PATH TANK012 PATHTL17
						SET_MOVEMENT_PATH TANK011 PATHTR17
					)

				)

			)


			IF ( VBL_TEST UNIT_REFRESH01 LESS_THAN_EQUAL GAME_TIME ) THEN
			(

				IF ( NOT ( OR ( IS_ALIVE TANK013  IS_ALIVE TANK014 ) ) ) THEN
				(

					CHANGE_VBL UNITS_CREATED01 ADD 2
					CHANGE_VBL MESSAGE01 SET 0
					CHANGE_VBL UNIT_REFRESH01 SET GAME_TIME
					CHANGE_VBL UNIT_REFRESH01 ADD TANK_DELAY 

					IF ( NOT ( CITADEL_OWNED PLAYER 7 ) ) THEN
					(
						CREATE_UNIT TANK013 PLAYER AI_TANK TA11 YAW (90) NULL NULL
						CREATE_UNIT TANK014 PLAYER AI_TANK TA12  YAW (90) NULL NULL 
						SET_MOVEMENT_PATH TANK013 PATHTR17
						SET_MOVEMENT_PATH TANK014 PATHTL17
					)
					ELSE
					(
						CREATE_UNIT TANK013 PLAYER AI_TANK TA12 YAW (180) NULL NULL
						CREATE_UNIT TANK014 PLAYER AI_TANK TA13  YAW (180) NULL NULL 
						SET_MOVEMENT_PATH TANK014 PATHTL15
						SET_MOVEMENT_PATH TANK013 PATHTR15
					)

				)

			)

			IF ( VBL_TEST UNIT_REFRESH01 LESS_THAN_EQUAL GAME_TIME ) THEN
			(
	
				IF ( NOT ( IS_ALIVE TROOP_TRANS011 ) ) THEN
				(
					CHANGE_VBL UNITS_CREATED01 ADD 1
					CHANGE_VBL TROOP_TRANS_OWN011 SET PLAYER 
					CHANGE_VBL MESSAGE01 SET 0
					CHANGE_VBL UNIT_REFRESH01 SET GAME_TIME
					CHANGE_VBL UNIT_REFRESH01 ADD TRANS_DELAY

					IF ( NOT ( CITADEL_OWNED PLAYER 5 ) ) THEN
					(
						CREATE_UNIT TROOP_TRANS011 PLAYER CONVOY_TRUCK CTR11 YAW (180) NULL NULL 
						SET_MOVEMENT_PATH TROOP_TRANS011 PATH15
					)
					ELSE
					(
						CREATE_UNIT TROOP_TRANS011 PLAYER CONVOY_TRUCK CTR11 YAW (90) NULL NULL 
						SET_MOVEMENT_PATH TROOP_TRANS011 PATH17
					)

				)

			)


			IF ( VBL_TEST UNIT_REFRESH01 LESS_THAN_EQUAL GAME_TIME ) THEN
			(

				IF ( NOT ( IS_ALIVE TROOP_TRANS012 ) ) THEN
				(
					CHANGE_VBL UNITS_CREATED01 ADD 1
					CHANGE_VBL TROOP_TRANS_OWN012 SET PLAYER 
					CHANGE_VBL MESSAGE01 SET 0
					CHANGE_VBL UNIT_REFRESH01 SET GAME_TIME
					CHANGE_VBL UNIT_REFRESH01 ADD TRANS_DELAY 

					IF ( NOT ( CITADEL_OWNED PLAYER 7 ) ) THEN
					(
						CREATE_UNIT TROOP_TRANS012 PLAYER CONVOY_TRUCK CTR11 YAW (90) NULL NULL 
						SET_MOVEMENT_PATH TROOP_TRANS012 PATH17
					)
					ELSE
					(
						CREATE_UNIT TROOP_TRANS012 PLAYER CONVOY_TRUCK CTR11 YAW (180) NULL NULL 
						SET_MOVEMENT_PATH TROOP_TRANS012 PATH15
					)

				)

			)

			IF ( VBL_TEST UNIT_REFRESH01 LESS_THAN_EQUAL GAME_TIME ) THEN
			(

				IF ( NOT ( AND ( IS_ALIVE AAV11 IS_ALIVE AAV12 )) ) THEN
				(
					CHANGE_VBL UNITS_CREATED01 ADD 2
					CHANGE_VBL MESSAGE01 SET 0
					CHANGE_VBL UNIT_REFRESH01 SET GAME_TIME
					CHANGE_VBL UNIT_REFRESH01 ADD AAV_DELAY 

					IF ( NOT ( CITADEL_OWNED PLAYER 7 ) ) THEN
					(
						CREATE_UNIT AAV11 PLAYER AAV TA11 YAW (90) NULL NULL 
						CREATE_UNIT AAV12 PLAYER AAV TA12 YAW (90) NULL NULL 
						SET_MOVEMENT_PATH AAV11 PATHTR17
						SET_MOVEMENT_PATH AAV12 PATHTL17
					)
					ELSE
					(
						CREATE_UNIT AAV11 PLAYER AAV TA13 YAW (180) NULL NULL 
						CREATE_UNIT AAV12 PLAYER AAV TA12 YAW (180) NULL NULL 
						SET_MOVEMENT_PATH AAV11 PATHTL15
						SET_MOVEMENT_PATH AAV12 PATHTR15
					)

				)

			)

			IF ( VBL_TEST UNIT_REFRESH01 LESS_THAN_EQUAL GAME_TIME ) THEN
			(

				IF ( NOT ( AND ( IS_ALIVE AAV13 IS_ALIVE AAV14 )) ) THEN
				(
					CHANGE_VBL UNITS_CREATED01 ADD 2
					CHANGE_VBL MESSAGE01 SET 0
					CHANGE_VBL UNIT_REFRESH01 SET GAME_TIME
					CHANGE_VBL UNIT_REFRESH01 ADD AAV_DELAY 

					IF ( NOT ( CITADEL_OWNED PLAYER 5 ) ) THEN
					(
						CREATE_UNIT AAV13 PLAYER AAV TA13 YAW (180) NULL NULL 
						CREATE_UNIT AAV14 PLAYER AAV TA12 YAW (180) NULL NULL 
						SET_MOVEMENT_PATH AAV13 PATHTL15
						SET_MOVEMENT_PATH AAV14 PATHTR15
					)
					ELSE
					(
						CREATE_UNIT AAV13 PLAYER AAV TA11 YAW (90) NULL NULL 
						CREATE_UNIT AAV14 PLAYER AAV TA12 YAW (90) NULL NULL 
						SET_MOVEMENT_PATH AAV13 PATHTR17
						SET_MOVEMENT_PATH AAV14 PATHTL17
					)

				)

			)

		)

	)

)




###### CITADEL02 #########################################################

IF (  AND( NOT ( IS_ALIVE TROOP_TRANS021 ) 
	AND( NOT ( IS_ALIVE TROOP_TRANS022 )
	AND( NOT ( IS_ALIVE TANK021 ) 
	AND( NOT ( IS_ALIVE TANK022 )
	AND( NOT ( IS_ALIVE TANK023 ) 
	AND( NOT ( IS_ALIVE TANK024 )
	AND( NOT ( IS_ALIVE AAV21 ) 
	AND( NOT ( IS_ALIVE AAV22 )
	AND( NOT ( IS_ALIVE AAV23 )
	NOT (IS_ALIVE AAV24 )))) )))) ))) THEN
(
		CHANGE_VBL UNITS_CREATED02  SET 0
)

IF ( VBL_TEST UNITS_CREATED02  GREATER_THAN_EQUAL 10 ) THEN
(
		CHANGE_VBL CITADEL_REFRESH02  SET GAME_TIME
		CHANGE_VBL CITADEL_REFRESH02  ADD REFRESH_CONST 
)

#### REMOVE SUPERFLUOS UNITS ###################################################
