		#Creating SAMs
		IF ( VBL_TEST SAMS EQUAL 0 ) THEN
		(

			FOR A EQUAL 0 TO 3 DO
			(

				IF ( VBL_TEST BUILD EQUAL A ) THEN
				(

					IF ( NOT ( IS_ALIVE RI1_S ) ) THEN
					(
						CREATE_UNIT RI1_S 5 SAMS LOC ( 148, 156, 0 ) YAW (0) NULL NULL
					)
