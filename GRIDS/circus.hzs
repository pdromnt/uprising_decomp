		IF ( VBL_TEST DDD_STRENGTH EQUAL 1 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 10
		)


		IF ( VBL_TEST DDD_STRENGTH EQUAL 2 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 20
		)


		IF ( VBL_TEST DDD_STRENGTH EQUAL 3 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 20
		)


		IF ( VBL_TEST DDD_STRENGTH EQUAL 4 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 30
		)


		IF ( VBL_TEST DDD_STRENGTH EQUAL 5 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 30
		)
	)


	#Increasing foritifcation for EEE making it to the base and teleporting out
	IF ( CLOSE_PT EEE END 2 ) THEN
	(
		REMOVE_UNIT EEE


		IF ( VBL_TEST EEE_STRENGTH EQUAL 0 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 10
		)


		IF ( VBL_TEST EEE_STRENGTH EQUAL 1 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 10
		)


		IF ( VBL_TEST EEE_STRENGTH EQUAL 2 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 20
		)


		IF ( VBL_TEST EEE_STRENGTH EQUAL 3 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 20
		)


		IF ( VBL_TEST EEE_STRENGTH EQUAL 4 ) THEN
		(
