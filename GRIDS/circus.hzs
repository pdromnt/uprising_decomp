			##########Fortification of the Base##########

	#The following calculates the level of fortification
	COUNT_OBJECTS 5 AITANK_GNRTR_BLDG AITANK_GNRTR_COUNT
	COUNT_OBJECTS 5 SLDR_GNRTR_BLDG   SLDR_GNRTR_COUNT
	COUNT_OBJECTS 5 AAV_GNRTR_BLDG    AAV_GNRTR_COUNT
	COUNT_OBJECTS 5 LIGHT_TURRET      LIGHT_TURRET_COUNT
	COUNT_OBJECTS 5 HEAVY_TURRET      HEAVY_TURRET_COUNT
	COUNT_OBJECTS 5 SAMS              SAMS_COUNT

	CHANGE_VBL AITANK_GNRTR_VALUE SET AITANK_GNRTR_COUNT
	CHANGE_VBL SLDR_GNRTR_VALUE   SET SLDR_GNRTR_COUNT
	CHANGE_VBL AAV_GNRTR_VALUE    SET AAV_GNRTR_COUNT
	CHANGE_VBL LIGHT_TURRET_VALUE SET LIGHT_TURRET_COUNT
	CHANGE_VBL HEAVY_TURRET_VALUE SET HEAVY_TURRET_COUNT
	CHANGE_VBL SAMS_VALUE         SET SAMS_COUNT

	CHANGE_VBL AITANK_GNRTR_VALUE MUL 7
	CHANGE_VBL SLDR_GNRTR_VALUE   MUL 4
	CHANGE_VBL AAV_GNRTR_VALUE    MUL 6
	CHANGE_VBL LIGHT_TURRET_VALUE MUL 3
	CHANGE_VBL HEAVY_TURRET_VALUE MUL 5
	CHANGE_VBL SAMS_VALUE         MUL 3

	CHANGE_VBL FORT_CHANGE   SET FORTIFICATION
	CHANGE_VBL FORTIFICATION SET 0
	CHANGE_VBL FORTIFICATION ADD AITANK_GNRTR_VALUE
	CHANGE_VBL FORTIFICATION ADD SLDR_GNRTR_VALUE
	CHANGE_VBL FORTIFICATION ADD AAV_GNRTR_VALUE
	CHANGE_VBL FORTIFICATION ADD LIGHT_TURRET_VALUE
	CHANGE_VBL FORTIFICATION ADD HEAVY_TURRET_VALUE
	CHANGE_VBL FORTIFICATION ADD SAMS_VALUE
	CHANGE_VBL FORT_CHANGE   SUB FORTIFICATION

	#Build is the vbl used to decided what location on the map to place the created unit
	CHANGE_VBL BUILD SET RANDOM_INT 16


	IF ( VBL_TEST LIGHT_TURRET_COUNT LESS_THAN 16 ) THEN
	(
		CHANGE_VBL LIGHT_TURRET SET 0
		CHANGE_VBL SAMS         SET 1
		CHANGE_VBL HEAVY_TURRET SET 1
		CHANGE_VBL INFANTRY     SET 1
		CHANGE_VBL TANK         SET 1
		CHANGE_VBL AAV          SET 1
	)
	ELSE
	(

		IF ( VBL_TEST SAMS_COUNT LESS_THAN 4 ) THEN
		(
			CHANGE_VBL LIGHT_TURRET SET 1
			CHANGE_VBL SAMS         SET 0
			CHANGE_VBL HEAVY_TURRET SET 1
			CHANGE_VBL INFANTRY     SET 1
			CHANGE_VBL TANK         SET 1
			CHANGE_VBL AAV          SET 1
		)
		ELSE
		(

			IF ( VBL_TEST HEAVY_TURRET_COUNT LESS_THAN 12 ) THEN
			(
				CHANGE_VBL LIGHT_TURRET SET 1
				CHANGE_VBL SAMS         SET 1
				CHANGE_VBL HEAVY_TURRET SET 0
				CHANGE_VBL INFANTRY     SET 1
				CHANGE_VBL TANK         SET 1
				CHANGE_VBL AAV          SET 1
			)
			ELSE
			(
				SHOW_BILLBOARD {HEAVY TURRETS ARE BUILT!!}
			)
		)
	)




	#Creating light turrets
	IF ( VBL_TEST FORT_CHANGE GREATER_THAN_EQUAL 3 ) THEN
	(

		IF ( VBL_TEST LIGHT_TURRET EQUAL 0 ) THEN
		(

			IF ( VBL_TEST BUILD EQUAL 0 ) THEN
			(

				IF ( NOT ( IS_ALIVE RO1_LT1 ) ) THEN
				(
					CREATE_UNIT RO1_LT1 5 LIGHT_TURRET LOC ( 112, 204, 0 ) YAW (0) NULL NULL
				)
				ELSE
				(
					CHANGE_VBL LIGHT_TURRET SET 1
				)
			)


			IF ( VBL_TEST BUILD EQUAL 1 ) THEN
