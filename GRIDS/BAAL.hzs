# PLACING SPECIAL AMMO ########################################################
##### DISK AMMO BOX 01 ########################################################

IF ( VBL_TEST DISK_AMMO_TIME01 LESS_THAN_EQUAL GAME_TIME ) THEN
(

	IF ( VBL_TEST DISK_AMMO_TSET01 EQUAL 1 ) THEN
	(

		CREATE_FIXED_PU DISK_AMMO01 0 PU_DROP01 PU_SPECIAL_WEAPON_BOOST 1
		CHANGE_VBL DISK_AMMO_TSET01 SET 0
	)

)

IF ( VBL_TEST DISK_AMMO_TSET01 EQUAL 0 ) THEN
(
	IF ( NOT ( IS_ALIVE DISK_AMMO01 ) ) THEN
	(

			CHANGE_VBL DISK_AMMO_TIME01 SET GAME_TIME
			CHANGE_VBL DISK_AMMO_TIME01 ADD DISK_AMMO_TIME_CONST
			CHANGE_VBL DISK_AMMO_TSET01 SET 1
	)

)



# DISK AMMO BOX 02

IF ( VBL_TEST DISK_AMMO_TIME02 LESS_THAN_EQUAL GAME_TIME ) THEN
(

	IF ( VBL_TEST DISK_AMMO_TSET02 EQUAL 1 ) THEN
