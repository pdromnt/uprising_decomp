##### INITIALIZING TELPORTERS ##################################################

IF ( VBL_TEST TPORT_INIT EQUAL 0 ) THEN
(
	SET_TELEPORTER TELEPORT2 0
	SET_TELEPORTER TELEPORT3 0
	CHANGE_VBL TPORT_INIT SET 1
)

###### START GATE STUFF ########################################################

IF ( CLOSE_PT HTANK 0 LOC ( 237, 9, 0 ) 34 ) THEN
(
	SET_GATE GATESTART 0
)

IF ( CLOSE_PT HTANK 0 LOC ( 165, 8, 0 ) 34 ) THEN
(
	SET_GATE GATESTART 1
)




################################################################################
###### RESUPPLY HTANK ##########################################################

IF ( CLOSE_PT HTANK 0 RSUPPLY01 4 ) THEN
(

	REFRESH_WEAPONS 0

)


IF ( CLOSE_PT HTANK 0 RSUPPLY02 4 ) THEN
(

	REFRESH_WEAPONS 0

)


################################################################################
############### GATE01 STUFF ###################################################

IF ( VBL_TEST GATE_RESET_VAR01 EQUAL 0 ) THEN
(
	IF ( NOT ( OR (IS_ALIVE AAV_GEN01 IS_ALIVE TANK_GEN01))) THEN
	(

		SET_GATE GATE01 0
		CHANGE_VBL GATE_RESET_VAR01 SET 1
		CHANGE_VBL GATE_RESET_TIME01 SET GAME_TIME
		CHANGE_VBL GATE_RESET_TIME01 ADD GATE_RESET_DELAY

	)
)


###### RESETTING GATE01 AND LOCK01 #############################################

IF ( AND ( VBL_TEST GATE_RESET_VAR01 EQUAL 1  VBL_TEST GAME_TIME GREATER_THAN_EQUAL GATE_RESET_TIME01 ) ) THEN
(
	IF ( NOT ( CLOSE_PT HTANK 0 GATE01_LOC 15 ) ) THEN
	(
		IF ( CLOSE_PT HTANK 0 AREA02_LOC 82 ) THEN
		(
			SET_TELEPORTER TELEPORT2 1
			SET_GATE GATE01 1
			CHANGE_VBL GATE_RESET_VAR01 SET 0
			CREATE_UNIT AAV_GEN01 5 AAV_GNRTR_BLDG AAV_GEN01_LOC YAW (270) NULL NULL
			CREATE_UNIT TANK_GEN01 5 AITANK_GNRTR_BLDG TANK_GEN01_LOC YAW (270) NULL NULL

			CHANGE_VBL AREA01_GENERATION_RESET SET 0
			CHANGE_VBL GATE_OPENED01 ADD 1


   			###### RESETTING AREA ONE BONUS SITES ########################
			###### RESETTING FTLD01	
			IF ( NOT ( IS_ALIVE FTLD01 ) ) THEN
			(
				IF ( VBL_TEST BONUS01 GREATER_THAN 1 ) THEN
				(
					CHANGE_VBL BONUS01 SUB 1
				)

				IF ( NOT (CLOSE_PT HTANK 0 DROP11 4 )) THEN
				(
					CREATE_UNIT FTLD01  5  NP_BLDG_TECHCENTER DROP11 YAW (90)  NULL  NULL 

					CHANGE_VBL BONUS_RESET01 SET 0

				)

			)

			###### RESETTING FTLD02	
			IF ( NOT ( IS_ALIVE FTLD02 ) ) THEN
			(

				IF ( VBL_TEST BONUS02 GREATER_THAN 1 ) THEN
				(
					CHANGE_VBL BONUS02 SUB 1
				)

				IF ( NOT (CLOSE_PT HTANK 0 DROP21 4 )) THEN
				(
					CREATE_UNIT FTLD02  5  NP_BLDG_TECHCENTER DROP21 YAW (0)  NULL  NULL 

					CHANGE_VBL BONUS_RESET02 SET 0

				)

			)

			###### RESETTING FTLD03	

			IF ( NOT ( IS_ALIVE FTLD03 ) ) THEN
			(

				IF ( VBL_TEST BONUS03 GREATER_THAN 1 ) THEN
				(
					CHANGE_VBL BONUS03 SUB 1
				)

				IF ( NOT (CLOSE_PT HTANK 0 DROP31 4 )) THEN
				(
					CREATE_UNIT FTLD03  5  NP_BLDG_TECHCENTER DROP31 YAW (270)  NULL  NULL 

					CHANGE_VBL BONUS_RESET03 SET 0

				)

			)

			###### RESETTING FTLD04	
			IF ( NOT ( IS_ALIVE FTLD04 ) ) THEN
			(

				IF ( VBL_TEST BONUS04 GREATER_THAN 1 ) THEN
				(
					CHANGE_VBL BONUS04 SUB 1
				)

				IF ( NOT (CLOSE_PT HTANK 0 DROP41 4 )) THEN
				(
					CREATE_UNIT FTLD04  5  NP_BLDG_TECHCENTER DROP41 YAW (180)  NULL  NULL 

					CHANGE_VBL BONUS_RESET04 SET 0

				)

			)

		)

	)

)


################################################################################
######## GATE02 STUFF ##########################################################

IF ( VBL_TEST GATE_RESET_VAR02 EQUAL 0 ) THEN
(
	IF ( NOT ( OR (IS_ALIVE AAV_GEN02 IS_ALIVE TANK_GEN02 ))) THEN
	(

		SET_GATE GATE02 0
		CHANGE_VBL GATE_RESET_VAR02 SET 1
