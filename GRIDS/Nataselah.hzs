START_SCRIPT_FILE


VDECL VINT SETUP          0
VDECL VINT INITIAL_DELAY  0
VDECL VINT SET_KSWEEP     0
VDECL VINT KSWEEP         0
VDECL VINT LONGER_DELAY   0

VDECL VINT KSAT_DELAY_TIME    0
VDECL VINT KSAT_ATTACK_TIME   0


#These variables are switches for opening and closing the gates
VDECL VINT SWITCH_NORTH_GATE  0
VDECL VINT SWITCH_SOUTH_GATE  0
VDECL VINT SWITCH_EAST_GATE   0
VDECL VINT SWITCH_WEST_GATE   0
VDECL VINT SWITCH_ERAMP       1
VDECL VINT SWITCH_WRAMP       1

#Variables for creating the power-ups
VDECL VINT PU_NW_TIME  0
VDECL VINT PU_NE_TIME  0
VDECL VINT PU_WR_TIME  0


#These variables are for the KSAT1 paths
VDECL VINT KSAT1_WHICH_WAY  0

VDECL VINT KSAT1             0
VDECL VINT SET_KSAT1_START   0
VDECL VINT KSAT1_START       0

VDECL VINT KSAT1_ADDING       999
VDECL VINT KSAT1_SUBTRACTING  999


VDECL VINT KSAT1_POS_NC   999
VDECL VINT KSAT1_POS_NNE  999
VDECL VINT KSAT1_POS_NNW  999
VDECL VINT KSAT1_POS_NO   999

VDECL VINT KSAT1_POS_EC   999
VDECL VINT KSAT1_POS_ENE  999
VDECL VINT KSAT1_POS_ESE  999
VDECL VINT KSAT1_POS_EO   999

VDECL VINT KSAT1_POS_SC   999
VDECL VINT KSAT1_POS_SSE  999
VDECL VINT KSAT1_POS_SSW  999
VDECL VINT KSAT1_POS_SO   999

VDECL VINT KSAT1_POS_WC   999
VDECL VINT KSAT1_POS_WSW  999
VDECL VINT KSAT1_POS_WNW  999
VDECL VINT KSAT1_POS_WO   999

VDECL VINT KSAT1_POS_NE   999
VDECL VINT KSAT1_POS_SE   999
VDECL VINT KSAT1_POS_SW   999
VDECL VINT KSAT1_POS_NW   999



#These variables are for the KSAT2 paths
VDECL VINT KSAT2_WHICH_WAY  0

VDECL VINT KSAT2             0
VDECL VINT SET_KSAT2_START   0
VDECL VINT KSAT2_START       0

VDECL VINT KSAT2_ADDING       999
VDECL VINT KSAT2_SUBTRACTING  999


VDECL VINT KSAT2_POS_NC   999
VDECL VINT KSAT2_POS_NNE  999
VDECL VINT KSAT2_POS_NNW  999
VDECL VINT KSAT2_POS_NO   999

VDECL VINT KSAT2_POS_EC   999
VDECL VINT KSAT2_POS_ENE  999
VDECL VINT KSAT2_POS_ESE  999
VDECL VINT KSAT2_POS_EO   999

VDECL VINT KSAT2_POS_SC   999
VDECL VINT KSAT2_POS_SSE  999
VDECL VINT KSAT2_POS_SSW  999
VDECL VINT KSAT2_POS_SO   999

VDECL VINT KSAT2_POS_WC   999
VDECL VINT KSAT2_POS_WSW  999
VDECL VINT KSAT2_POS_WNW  999
VDECL VINT KSAT2_POS_WO   999

VDECL VINT KSAT2_POS_NE   999
VDECL VINT KSAT2_POS_SE   999
VDECL VINT KSAT2_POS_SW   999
VDECL VINT KSAT2_POS_NW   999




#These variables are for the KSAT3 paths
VDECL VINT KSAT3_WHICH_WAY  0

VDECL VINT KSAT3             0
VDECL VINT SET_KSAT3_START   0
VDECL VINT KSAT3_START       0

VDECL VINT KSAT3_ADDING       999
VDECL VINT KSAT3_SUBTRACTING  999


VDECL VINT KSAT3_POS_NC   999
VDECL VINT KSAT3_POS_NNE  999
VDECL VINT KSAT3_POS_NNW  999
VDECL VINT KSAT3_POS_NO   999

VDECL VINT KSAT3_POS_EC   999
VDECL VINT KSAT3_POS_ENE  999
VDECL VINT KSAT3_POS_ESE  999
VDECL VINT KSAT3_POS_EO   999

VDECL VINT KSAT3_POS_SC   999
VDECL VINT KSAT3_POS_SSE  999
VDECL VINT KSAT3_POS_SSW  999
VDECL VINT KSAT3_POS_SO   999

VDECL VINT KSAT3_POS_WC   999
VDECL VINT KSAT3_POS_WSW  999
VDECL VINT KSAT3_POS_WNW  999
VDECL VINT KSAT3_POS_WO   999

VDECL VINT KSAT3_POS_NE   999
VDECL VINT KSAT3_POS_SE   999
VDECL VINT KSAT3_POS_SW   999
VDECL VINT KSAT3_POS_NW   999








	IF ( VBL_TEST SETUP EQUAL 0 ) THEN
	(
		CHANGE_VBL SETUP SET 1
	)



	IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL KSAT_DELAY_TIME ) THEN
	(

		IF ( VBL_TEST INITIAL_DELAY EQUAL 0 ) THEN
		(
			CHANGE_VBL KSAT_DELAY_TIME SET GAME_TIME
			CHANGE_VBL KSAT_DELAY_TIME ADD 9600
			CHANGE_VBL LFL_SETTINGS IMPERIUM_KSAT_ATTACK_RATE SET 9601
			CHANGE_VBL INITIAL_DELAY SET 1
		)
		ELSE
		(

			IF ( VBL_TEST SET_KSWEEP EQUAL 0 ) THEN
			(
				CHANGE_VBL KSWEEP SET RANDOM_INT 5
				CHANGE_VBL LFL_SETTINGS IMPERIUM_KSAT_ATTACK_RATE SET 2
				CHANGE_VBL KSAT_ATTACK_TIME SET GAME_TIME
				CHANGE_VBL KSAT_ATTACK_TIME ADD 96
				CHANGE_VBL SET_KSWEEP SET 1


				IF ( VBL_TEST KSWEEP LESS_THAN_EQUAL 3 ) THEN
				(
					CHANGE_VBL LFL_SETTINGS IMPERIUM_KSAT_SWEEP_PLATFORM SET 0
				)
				ELSE
				(
					CHANGE_VBL LFL_SETTINGS IMPERIUM_KSAT_SWEEP_PLATFORM SET 1
					CHANGE_VBL LONGER_DELAY SET 0
				)
			)


			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL KSAT_ATTACK_TIME ) THEN
			(
				CHANGE_VBL SET_KSWEEP SET 0
				CHANGE_VBL KSAT_DELAY_TIME SET GAME_TIME
				#This number is ticks, not seconds
				CHANGE_VBL KSAT_DELAY_TIME ADD 8284
				#Three seconds/ninety-six ticks are added to the delay time when SET_KSWEEP is set
				CHANGE_VBL KSAT_ATTACK_TIME SET KSAT_DELAY_TIME
				CHANGE_VBL KSAT_ATTACK_TIME ADD 1
				CHANGE_VBL LFL_SETTINGS IMPERIUM_KSAT_ATTACK_RATE SET KSAT_ATTACK_TIME


				IF ( VBL_TEST LONGER_DELAY EQUAL 0 ) THEN
				(
					CHANGE_VBL KSAT_DELAY_TIME MUL 2
					CHANGE_VBL LONGER_DELAY SET 1
				)
			)
		)
	)



	IF ( AND (( CITADEL_OWNED_W_STRG_TOWER 0 2 ) ( CITADEL_OWNED_W_STRG_TOWER 0 3 )) ) THEN
	(

		IF ( VBL_TEST SWITCH_EAST_GATE EQUAL 0 ) THEN
		(
			CHANGE_VBL SWITCH_EAST_GATE SET 1
			SHOW_BILLBOARD {Inner Gate Lowered \nAccess Gained to Eastern Teleporter} 10
			SET_GATE GATE_EAST 0
		)
	)
	ELSE
	(

		IF ( VBL_TEST SWITCH_EAST_GATE EQUAL 1 ) THEN
		(
			CHANGE_VBL SWITCH_EAST_GATE SET 0
			SHOW_BILLBOARD {Inner Gate Raised \nAccess Lost to Eastern Teleporter} 10
			SET_GATE GATE_EAST 1
		)
	)



	IF ( AND (( CITADEL_OWNED_W_STRG_TOWER 0 3 ) ( CITADEL_OWNED_W_STRG_TOWER 0 4 )) ) THEN
	(

		IF ( VBL_TEST SWITCH_SOUTH_GATE EQUAL 0 ) THEN
		(
			CHANGE_VBL SWITCH_SOUTH_GATE SET 1
			SHOW_BILLBOARD {Inner Gate Lowered \nAccess Gained to Southern Teleporter} 10
			SET_GATE GATE_SOUTH 0
		)
	)
	ELSE
	(

		IF ( VBL_TEST SWITCH_SOUTH_GATE EQUAL 1 ) THEN
		(
			CHANGE_VBL SWITCH_SOUTH_GATE SET 0
			SHOW_BILLBOARD {Inner Gate Raised \nAccess Lost to Southern Teleporter} 10
			SET_GATE GATE_SOUTH 1
		)
	)



	IF ( AND (( CITADEL_OWNED_W_STRG_TOWER 0 4 ) ( CITADEL_OWNED_W_STRG_TOWER 0 5 )) ) THEN
	(

		IF ( VBL_TEST SWITCH_WEST_GATE EQUAL 0 ) THEN
		(
			CHANGE_VBL SWITCH_WEST_GATE SET 1
			SHOW_BILLBOARD {Inner Gate Lowered \nAccess Gained to Western Teleporter} 10
			SET_GATE GATE_WEST 0
		)
	)
	ELSE
	(

		IF ( VBL_TEST SWITCH_WEST_GATE EQUAL 1 ) THEN
		(
			CHANGE_VBL SWITCH_WEST_GATE SET 0
			SHOW_BILLBOARD {Inner Gate Raised \nAccess Lost to Western Teleporter} 10
			SET_GATE GATE_WEST 1
		)
	)




	IF ( AND (( CITADEL_OWNED_W_STRG_TOWER 0 5 ) ( CITADEL_OWNED_W_STRG_TOWER 0 2 )) ) THEN
	(

		IF ( VBL_TEST SWITCH_NORTH_GATE EQUAL 0 ) THEN
		(
			CHANGE_VBL SWITCH_NORTH_GATE SET 1
			SHOW_BILLBOARD {Inner Gate Lowered \nAccess Gained to Northern Teleporter} 10
			SET_GATE GATE_NORTH 0
		)
	)
	ELSE
	(

		IF ( VBL_TEST SWITCH_NORTH_GATE EQUAL 1 ) THEN
		(
			CHANGE_VBL SWITCH_NORTH_GATE SET 0
			SHOW_BILLBOARD {Inner Gate Raised \nAccess Lost to Northern Teleporter} 10
			SET_GATE GATE_NORTH 1
		)
	)



	IF ( CITADEL_OWNED_W_TOWER 4 3 ) THEN
	(

		IF ( VBL_TEST SWITCH_ERAMP EQUAL 0 ) THEN
		(
			SHOW_BILLBOARD {Outer Gate Raised \nRamp Closed to SouthEast Citadel} 10
			SET_GATE GATE_ERAMP 1
			CHANGE_VBL SWITCH_ERAMP SET 1
		)
	)
	ELSE
	(

		IF ( VBL_TEST SWITCH_ERAMP EQUAL 1 ) THEN
		(
			SHOW_BILLBOARD {Outer Gate Lowered \nRamp opened to SouthEast Citadel} 10
			SET_GATE GATE_ERAMP 0
			CHANGE_VBL SWITCH_ERAMP SET 0
		)
	)



	IF ( CITADEL_OWNED_W_TOWER 4 4 ) THEN
	(

		IF ( VBL_TEST SWITCH_WRAMP EQUAL 0 ) THEN
		(
			SHOW_BILLBOARD {Outer Gate Raised \nRamp Closed to SouthWest Citadel} 10
			SET_GATE GATE_WRAMP 1
			CHANGE_VBL SWITCH_WRAMP SET 1
		)
	)
	ELSE
	(

		IF ( VBL_TEST SWITCH_WRAMP EQUAL 1 ) THEN
		(
			SHOW_BILLBOARD {outer Gate Lowered \nRamp Opened to SouthWest Citadel} 10
			SET_GATE GATE_WRAMP 0
			CHANGE_VBL SWITCH_WRAMP SET 0
		)
	)


#######Power-ups
	IF ( NOT ( IS_ALIVE PU_NW ) ) THEN
	(

		IF ( CLOSE_PT HTANK 0 LOC ( 42, 222, 3000 ) 3 ) THEN
		(
			CHANGE_VBL PU_NW_TIME SET GAME_TIME
			CHANGE_VBL PU_NW_TIME ADD 300
		)

		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL PU_NW_TIME	) THEN
		(
			CREATE_FIXED_PU PU_NW 0 LOC ( 42, 222, 3000 ) PU_SPECIAL_WEAPON_BOOST 2
		)
	)



	IF ( NOT ( IS_ALIVE PU_NE ) ) THEN
	(

		IF ( CLOSE_PT HTANK 0 LOC ( 214, 222, 3000 ) 3 ) THEN
		(
			CHANGE_VBL PU_NE_TIME SET GAME_TIME
			CHANGE_VBL PU_NE_TIME ADD 300
		)

		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL PU_NE_TIME	) THEN
		(
			CREATE_FIXED_PU PU_NE 0 LOC ( 214, 222, 3000 ) PU_SPECIAL_WEAPON_BOOST 2
		)
	)



	IF ( CLOSE_PT HTANK 0 LOC ( 52, 150, 5000 ) 3 ) THEN
	(
		REFRESH_WEAPONS 0

		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL PU_WR_TIME ) THEN
		(
			SHOW_BILLBOARD {FULL AMMUNITION REPLENISH} 10
			CHANGE_VBL PU_WR_TIME SET GAME_TIME
			CHANGE_VBL PU_WR_TIME ADD 10
		)
	)



	IF ( CLOSE_PT HTANK 0 LOC ( 204, 150, 5000 ) 3 ) THEN
	(
		REFRESH_WEAPONS 0

		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL PU_WR_TIME ) THEN
		(
			SHOW_BILLBOARD {FULL AMMUNITION REPLENISH} 10
			CHANGE_VBL PU_WR_TIME SET GAME_TIME
			CHANGE_VBL PU_WR_TIME ADD 10
		)
	)





#######Let the KSAT1ing begin!!!
	IF ( VBL_TEST KSAT1 EQUAL 0 ) THEN
	(

		IF ( VBL_TEST SET_KSAT1_START EQUAL 0 ) THEN
		(
			CHANGE_VBL KSAT1_START SET RANDOM_INT 4
			CHANGE_VBL KSAT1_ADDING SET 0

			IF ( VBL_TEST KSAT1_START EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_NC SET 0
				CHANGE_VBL SET_KSAT1_START SET 1
			)


			IF ( VBL_TEST KSAT1_START EQUAL 1 ) THEN
			(
				CHANGE_VBL KSAT1_POS_EC SET 0
				CHANGE_VBL SET_KSAT1_START SET 1
			)


			IF ( VBL_TEST KSAT1_START EQUAL 2 ) THEN
			(
				CHANGE_VBL KSAT1_POS_SC SET 0
				CHANGE_VBL SET_KSAT1_START SET 1
			)


			IF ( VBL_TEST KSAT1_START EQUAL 3 ) THEN
			(
				CHANGE_VBL KSAT1_POS_WC SET 0
				CHANGE_VBL SET_KSAT1_START SET 1
			)
		)
	)


		#This section is for moving through the North_Center passage
		IF ( VBL_TEST KSAT1_POS_NC EQUAL 0 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 140, 0 )


			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_NC ADD 1
			)


			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_WHICH_WAY SET RANDOM_INT 3
				CHANGE_VBL KSAT1_POS_NC SET 999


				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 0 ) THEN
				(
					CHANGE_VBL KSAT1_POS_EC SET 0
					CHANGE_VBL KSAT1_ADDING SET 0
					CHANGE_VBL KSAT1_SUBTRACTING SET 1
				)


				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 1 ) THEN
				(
					CHANGE_VBL KSAT1_POS_SC SET 0
					CHANGE_VBL KSAT1_ADDING SET 0
					CHANGE_VBL KSAT1_SUBTRACTING SET 1
				)


				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 2 ) THEN
				(
					CHANGE_VBL KSAT1_POS_WC SET 0
					CHANGE_VBL KSAT1_ADDING SET 0
					CHANGE_VBL KSAT1_SUBTRACTING SET 1
				)
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_NC EQUAL 1 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 144, 0 )


			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_NC ADD 1
			)


			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_NC SUB 1
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_NC EQUAL 2 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 148, 0 )

			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_NC ADD 1
			)

			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_NC SUB 1
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_NC EQUAL 3 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 152, 0 )

			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_NC ADD 1
			)

			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_NC SUB 1
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_NC EQUAL 4 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 156, 0 )


			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_WHICH_WAY SET RANDOM_INT 2
				CHANGE_VBL KSAT1_POS_NC SET 999

				#KSAT1_ADDING is already set to 0
				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 0 ) THEN
				(
					CHANGE_VBL KSAT1_POS_NNW SET 0
				)
				ELSE
				(
					CHANGE_VBL KSAT1_POS_NNE SET 0
				)
			)


			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_NC SUB 1
			)
		)
) ) ) )




		#This section is for moving through the East_Center passage
		IF ( VBL_TEST KSAT1_POS_EC EQUAL 0 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 140, 0 )


			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_EC ADD 1
			)


			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_WHICH_WAY SET RANDOM_INT 3
				CHANGE_VBL KSAT1_POS_EC SET 999


				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 0 ) THEN
				(
					CHANGE_VBL KSAT1_POS_SC SET 0
					CHANGE_VBL KSAT1_ADDING SET 0
					CHANGE_VBL KSAT1_SUBTRACTING SET 1
				)


				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 1 ) THEN
				(
					CHANGE_VBL KSAT1_POS_WC SET 0
					CHANGE_VBL KSAT1_ADDING SET 0
					CHANGE_VBL KSAT1_SUBTRACTING SET 1
				)


				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 2 ) THEN
				(
					CHANGE_VBL KSAT1_POS_NC SET 0
					CHANGE_VBL KSAT1_ADDING SET 0
					CHANGE_VBL KSAT1_SUBTRACTING SET 1
				)
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_EC EQUAL 1 ) THEN
		(
			KILLER_SAT 4 LOC ( 132, 140, 0 )


			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_EC ADD 1
			)


			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_EC SUB 1
			)
		)
ELSE
(


		IF ( VBL_TEST KSAT1_POS_EC EQUAL 2 ) THEN
		(
			KILLER_SAT 4 LOC ( 136, 140, 0 )

			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_EC ADD 1
			)

			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_EC SUB 1
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_EC EQUAL 3 ) THEN
		(
			KILLER_SAT 4 LOC ( 140, 140, 0 )

			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_EC ADD 1
			)

			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_EC SUB 1
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_EC EQUAL 4 ) THEN
		(
			KILLER_SAT 4 LOC ( 144, 140, 0 )


			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_WHICH_WAY SET RANDOM_INT 2
				CHANGE_VBL KSAT1_POS_EC SET 999

				#KSAT1_ADDING is already set to 0
				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 0 ) THEN
				(
					CHANGE_VBL KSAT1_POS_ENE SET 0
				)
				ELSE
				(
					CHANGE_VBL KSAT1_POS_ESE SET 0
				)
			)


			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_EC SUB 1
			)
		)
) ) ) )



		#This section is for moving through the South_Center passage
		IF ( VBL_TEST KSAT1_POS_SC EQUAL 0 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 140, 0 )


			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_SC ADD 1
			)


			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_WHICH_WAY SET RANDOM_INT 3
				CHANGE_VBL KSAT1_POS_SC SET 999


				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 0 ) THEN
				(
					CHANGE_VBL KSAT1_POS_WC SET 0
					CHANGE_VBL KSAT1_ADDING SET 0
					CHANGE_VBL KSAT1_SUBTRACTING SET 1
				)


				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 1 ) THEN
				(
					CHANGE_VBL KSAT1_POS_NC SET 0
					CHANGE_VBL KSAT1_ADDING SET 0
					CHANGE_VBL KSAT1_SUBTRACTING SET 1
				)


				IF ( VBL_TEST KSAT1_WHICH_WAY EQUAL 2 ) THEN
				(
					CHANGE_VBL KSAT1_POS_EC SET 0
					CHANGE_VBL KSAT1_ADDING SET 0
					CHANGE_VBL KSAT1_SUBTRACTING SET 1
				)
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_SC EQUAL 1 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 136, 0 )


			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_SC ADD 1
			)


			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_SC SUB 1
			)
		)
ELSE
(


		IF ( VBL_TEST KSAT1_POS_SC EQUAL 2 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 132, 0 )

			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_SC ADD 1
			)

			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_SC SUB 1
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_SC EQUAL 3 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 128, 0 )

			IF ( VBL_TEST KSAT1_ADDING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_SC ADD 1
			)

			IF ( VBL_TEST KSAT1_SUBTRACTING EQUAL 0 ) THEN
			(
				CHANGE_VBL KSAT1_POS_SC SUB 1
			)
		)
ELSE
(



		IF ( VBL_TEST KSAT1_POS_SC EQUAL 4 ) THEN
		(
			KILLER_SAT 4 LOC ( 128, 124, 0 )


