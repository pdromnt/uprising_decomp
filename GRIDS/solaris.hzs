START_SCRIPT_FILE

VDECL VINT TURRET				0
VDECL VINT TURRET1			0
VDECL VINT SOLDIER			0
VDECL VINT TANK				0
VDECL VINT POWERUP			0
VDECL VINT GATEDOWN1			0
VDECL VINT CITADEL_COUNT		0
VDECL VINT BILLBOARD1			0
VDECL VINT END_BILLBOARD		0
VDECL VINT SLDR_GNRTR_BLDG_COUNT 	0
VDECL VINT AITANK_GNRTR_BLDG_COUNT 	0
VDECL VINT AAV_GNRTR_BLDG_COUNT 	0
VDECL VINT BOMBER_GNRTR_BLDG_COUNT	0
VDECL VINT COUNT 				0
VDECL VINT PLAYER_SLOT     		0
VDECL VINT MISSION_FAILED  		0
VDECL VINT MULTIGATE			0    

VDECL VLOC TUR_CLOSEPT LOC (107, 98, 20)
VDECL VLOC TUR_CLOSEPT1 LOC (118, 164, 52)
VDECL VLOC TURRET1 LOC (122, 101, 0)
VDECL VLOC TURRET2 LOC (122, 92, 0)
VDECL VLOC TURRET3 LOC (118, 164, 52)
VDECL VLOC TANK1 LOC (184, 73, 0)
VDECL VLOC TANK2 LOC (186, 80, 0)
VDECL VLOC TANK_CLOSEPT LOC (184, 76, 0)
VDECL VLOC SOLD_CLOSEPT LOC (139, 160, 2000)
VDECL VLOC SOLDIER1 LOC (85, 166, 0)
VDECL VLOC SOLDIER2 LOC (83, 166, 0)
VDECL VLOC SOLDIER3 LOC (81, 166, 0)
VDECL VLOC SOLDIER4 LOC (79, 166, 0)
VDECL VLOC SOLDIER5 LOC (85, 158, 0)
VDECL VLOC SOLDIER6 LOC (83, 158, 0)
VDECL VLOC SOLDIER7 LOC (81, 158, 0)
VDECL VLOC SOLDIER8 LOC (79, 158, 0)
VDECL VLOC POWCLOSEPT LOC (74, 217, 515)

START_SECTION_SP_ONLY

IF ( AND ((VBL_TEST TURRET EQUAL 0)(CLOSE_PT HTANK 0 TUR_CLOSEPT 4 )) ) THEN
(		
	CREATE_UNIT TURRET1 5 LIGHT_TURRET TURRET1 YAW (0) NULL NULL
	CREATE_UNIT TURRET2 5 LIGHT_TURRET TURRET2 YAW (0) NULL NULL
	CHANGE_VBL TURRET SET 1
)                  

IF ( AND ((VBL_TEST TURRET1 EQUAL 0)(CLOSE_PT HTANK 0 TUR_CLOSEPT1 14 )) ) THEN
(		
	CREATE_UNIT TURRET3 5 LIGHT_TURRET TURRET3 YAW (0) NULL NULL
	CHANGE_VBL TURRET1 SET 1
)                  
IF ( AND ((VBL_TEST SOLDIER EQUAL 0)(CLOSE_PT HTANK 0 SOLD_CLOSEPT 28 )) ) THEN
(

	CREATE_UNIT SOLDIER1 4 SOLDIER SOLDIER1 YAW (0) NULL NULL
	CREATE_UNIT SOLDIER2 4 SOLDIER SOLDIER2 YAW (0) NULL NULL
	CREATE_UNIT SOLDIER3 4 SOLDIER SOLDIER3 YAW (0) NULL NULL
	CREATE_UNIT SOLDIER4 4 SOLDIER SOLDIER4 YAW (0) NULL NULL
	CREATE_UNIT SOLDIER5 4 SOLDIER SOLDIER5 YAW (0) NULL NULL
	CREATE_UNIT SOLDIER6 4 SOLDIER SOLDIER6 YAW (0) NULL NULL
	CREATE_UNIT SOLDIER7 4 SOLDIER SOLDIER7 YAW (0) NULL NULL
	CREATE_UNIT SOLDIER8 4 SOLDIER SOLDIER8 YAW (0) NULL NULL

	SET_MOVEMENT_PATH SOLDIER1 SOLD1 
	SET_MOVEMENT_PATH SOLDIER2 SOLD2 
	SET_MOVEMENT_PATH SOLDIER3 SOLD3 
	SET_MOVEMENT_PATH SOLDIER4 SOLD4 
	SET_MOVEMENT_PATH SOLDIER5 SOLD5 
	SET_MOVEMENT_PATH SOLDIER6 SOLD6 
	SET_MOVEMENT_PATH SOLDIER7 SOLD7 
	SET_MOVEMENT_PATH SOLDIER8 SOLD8 

	CHANGE_VBL SOLDIER SET 1
)

IF ( AND ((VBL_TEST TANK EQUAL 0)(CLOSE_PT HTANK 0 TANK_CLOSEPT 18 )) ) THEN
(		
	CREATE_UNIT TANK1 5 AI_TANK TANK1 YAW (0) NULL NULL
	CREATE_UNIT TANK2 5 AI_TANK TANK2 YAW (0) NULL NULL
	CHANGE_VBL TANK SET 1
)                  


IF ( AND ((CITADEL_OWNED 0 2)(VBL_TEST BILLBOARD1 EQUAL 0)) ) THEN
(
	SHOW_BILLBOARD {BIN LOCKING DEVICE DEACTIVATED} 7
	CHANGE_VBL BILLBOARD1 SET 1
)

IF (AND ((CITADEL_OWNED 0 2)(CLOSE_PT HTANK 0 POWCLOSEPT 18 )) ) THEN
(
	IF (VBL_TEST GATEDOWN1 EQUAL 0) THEN	
	(	
		SET_GATE GATEPOWER 0
		CHANGE_VBL GATEDOWN1 SET 1
	)	
)

IF ( VBL_TEST COUNT EQUAL 0 ) THEN
(
	COUNT_OBJECTS 5 SLDR_GNRTR_BLDG SLDR_GNRTR_BLDG_COUNT
	COUNT_OBJECTS 5 AITANK_GNRTR_BLDG AITANK_GNRTR_BLDG_COUNT
	COUNT_OBJECTS 5 AAV_GNRTR_BLDG AAV_GNRTR_BLDG_COUNT
	COUNT_OBJECTS 5 BOMBER_GNRTR_BLDG BOMBER_GNRTR_BLDG_COUNT

	IF ( AND(( VBL_TEST SLDR_GNRTR_BLDG_COUNT EQUAL 0 )( VBL_TEST AITANK_GNRTR_BLDG_COUNT EQUAL 0)) ) THEN	
	(
		IF (AND ((VBL_TEST AAV_GNRTR_BLDG_COUNT EQUAL 0)(VBL_TEST BOMBER_GNRTR_BLDG_COUNT EQUAL 0)) ) THEN
		(
			SHOW_BILLBOARD {ALL ENEMY GENERATOR BUILDINGS DESTROYED} 7
			CHANGE_VBL COUNT SET 1		
		)
	)
)



IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
(
	CHANGE_VBL MISSION_FAILED SET 1
)
FOR PLAYER_SLOT EQUAL 0 TO 4 DO
(
	IF  ( AND(( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT ALL )(VBL_TEST COUNT EQUAL 1)) ) THEN
	(
		END_MISSION PLAYER_SLOT 1 5 {MISSION ACCOMPLISHED}
		CHANGE_VBL MISSION_FAILED SET 1
	)
)


FOR PLAYER_SLOT EQUAL 0 TO 4 DO
(
	IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
	(

		IF ( NOT ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT 0 ) ) THEN
		(
			END_MISSION PLAYER_SLOT 0 5 {MISSION FAILED}
		)
	)
)

END_SECTION

START_SECTION_MP_ONLY
		
	IF (VBL_TEST MULTIGATE EQUAL 0) THEN
	(	
		SET_GATE GATEPOWER 0			
		CHANGE_VBL MULTIGATE SET 1
	)

	IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
	(
		CHANGE_VBL MISSION_FAILED SET 1
	)
	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT ALL ) THEN
		(
			END_MISSION PLAYER_SLOT 1 5 {MISSION ACCOMPLISHED}
			CHANGE_VBL MISSION_FAILED SET 1
		)
	)


	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
		(

			IF ( NOT ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT 0 ) ) THEN
			(
				END_MISSION PLAYER_SLOT 0 5 {MISSION FAILED}
			)
		)
	)


END_SECTION



IF (VBL_TEST POWERUP EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_A 0 LOC(75, 218, 0) PU_BOMBERS 1
	CREATE_FIXED_PU PU_B 0 LOC(72, 216, 0) PU_SOLDIERS 1
	CREATE_FIXED_PU PU_C 0 LOC(233, 214, 0) PU_HEALTH 100

	CHANGE_VBL POWERUP SET 1
)




END_SCRIPT_FILE