# VICTORY AND LOSS CONDITIONS##################################################################





SET_USE_DEFAULT_VICTORY 0

# CHECKING VICTORY CONDITION
IF (VBL_TEST PLAYER_MONEY 0 GREATER_THAN_EQUAL ZENERGY_VICTORY_AMOUNT ) THEN
(
	IF ( CLOSE_PT HTANK 0 CLAIM00 5 ) THEN
	(
		KILLER_SAT 0 SAT_DISH_LOC
		SHOW_BILLBOARD 0 { ENERGY TRANSFERRED. \n  REBEL FLOATILLA POWERING UP AND DEPARTING }

		CHANGE_VBL PLAYER_MONEY 0 SUB ZENERGY_VICTORY_AMOUNT
		CHANGE_VBL VICTORY_CONDITION SET 1
	)
	ELSE
	(
		SHOW_BILLBOARD 0 { REQUIRED ENERGY HAS BEEN COLLECTED. \n GO TO CLAIM SQUARE FOR THE CITADEL AT F-6 \n TO TRANSFER ENERGY TO AWAITING FLOTILLA. }
		SET_NAV_POINT CLAIM00 ON
	)
)

IF ( VBL_TEST VICTORY_CONDITION EQUAL 1 ) THEN
(
	CHANGE_VBL VICTORY_DELAY ADD 1
	
	IF ( VBL_TEST VICTORY_DELAY GREATER_THAN_EQUAL 5 ) THEN
	(
		END_MISSION 0 1 15 {FLOATILLA ZENERGY MAXED}
	)
)


# CHECKING LOSS CONDITION ######################################################
##### COUNT REMAINING ENERGY ON MAP ############################################

CHANGE_VBL MAP_ENERGY_TOT SET 0

FOR LOOP EQUAL 0 TO 6 DO
(
	CHANGE_VBL MAP_ENERGY_TOT ADD CITADEL_LODE LOOP	
)

CHANGE_VBL MAP_ENERGY_TOT ADD PLAYER_MONEY 0


IF ( AND ( VBL_TEST MAP_ENERGY_TOT LESS_THAN_EQUAL ZENERGY_VICTORY_AMOUNT VBL_TEST VICTORY_CONDITION EQUAL 0 )) THEN
(

	SHOW_BILLBOARD { THERE IS NOT ENOUGH ENERGY LEFT ON BAAL \n TO COMPLETE THIS MISSION. \n  YOU FAILED!!!!! }
	END_MISSION 0 0 15 { COULDN'T MINE ENOUGH ENERGY TO COMPLETE MISSION }

)



##### CHECKING TO SEE IF PLAYER 0 HAS LOST CITADEL 0 ###########################
IF ( AND ( VBL_TEST GAME_TIME GREATER_THAN 20 VBL_TEST VICTORY_CONDITION EQUAL 0 ) ) THEN
(

	IF ( NOT ( CITADEL_OWNED 0 0 ) ) THEN
	(
	
		SHOW_BILLBOARD 0 { YOU LOST CITADEL YOUR START CITADEL AT F-6 \n YOU LOSE SUCKER!!!!!!}
		END_MISSION 0 0 15 { YOU LOST CITADEL YOUR START CITADEL AT F-6 \n YOU FAILED!!!!!}

	)

)


