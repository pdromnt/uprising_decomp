		)


		IF ( VBL_TEST CCC_STRENGTH EQUAL 5 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 30
		)
	)


	#Increasing foritifcation for DDD making it to the base and teleporting out
	IF ( CLOSE_PT DDD END 2 ) THEN
	(
		REMOVE_UNIT DDD


		IF ( VBL_TEST DDD_STRENGTH EQUAL 0 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 10
