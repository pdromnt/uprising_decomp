			IF ( VBL_TEST BONUS_LOC_INDEX04 EQUAL 4 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC04 SET BONUS_AREA_LOC04
			)
			IF ( VBL_TEST BONUS_LOC_INDEX04 EQUAL 5 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC04 SET BONUS_AREA_LOC05
			)
			IF ( VBL_TEST BONUS_LOC_INDEX04 EQUAL 6 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC04 SET BONUS_AREA_LOC06
			)
			IF ( VBL_TEST BONUS_LOC_INDEX04 EQUAL 7 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC04 SET BONUS_AREA_LOC07
			) 	
			IF ( VBL_TEST BONUS_LOC_INDEX04 EQUAL 8 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC04 SET BONUS_AREA_LOC08
			)

			IF (
OR ( CLOSE_PT HTANK 0 BONUS_LOC04 5
OR ( CLOSE_PT HTANK 1 BONUS_LOC04 5
				OR ( CLOSE_PT HTANK 2 BONUS_LOC04 5
				OR ( CLOSE_PT HTANK 3 BONUS_LOC04 5
				OR ( VBL_TEST BONUS_LOC_INDEX04 EQUAL BONUS_LOC_INDEX01 				OR ( VBL_TEST BONUS_LOC_INDEX04 EQUAL BONUS_LOC_INDEX02 				VBL_TEST BONUS_LOC_INDEX03 EQUAL BONUS_LOC_INDEX04 ))))))) THEN
			(
				CHANGE_VBL BONUS_LOC_INDEX04 ADD 1
				IF ( VBL_TEST BONUS_LOC_INDEX04 GREATER_THAN 8 ) THEN
				(
					CHANGE_VBL BONUS_LOC_INDEX04 SUB 8
				)

			)
			ELSE
			(
				CHANGE_VBL LOOP04 SET 5
			)
		)
	
		CREATE_FIXED_PU BONUS04 0 BONUS_LOC04 PU_RANDOM 1
		CHANGE_VBL GEN_BONUS04 SET 1

	)
)


END_SECTION 


END_SCRIPT_FILE
