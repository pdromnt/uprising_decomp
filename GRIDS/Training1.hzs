START_SCRIPT_FILE

#Begin integer variables

#Sectional On/Off switches
VDECL VINT SETUP         0
VDECL VINT FIRST_MOVE    0
VDECL VINT COMMAND_SITE  2
VDECL VINT MAP           0
VDECL VINT STRAFE        0
VDECL VINT WEAPON        0
VDECL VINT TRIANGLE      0
VDECL VINT CYCLE         0
VDECL VINT TANKS         0
VDECL VINT SWITCH        0
VDECL VINT INFANTRY      0


#Time delays for actions
VDECL VINT ACTION_TIME     0
VDECL VINT ACTION_TIME2    0
VDECL VINT CHECK_TIME      0
VDECL VINT BILLBOARD_TIME  0
#VDECL VINT REP_LEVEL       0
#VDECL VINT REP_ITER        0


#On/Off switches for voices
VDECL VINT VOICE1       0
VDECL VINT VOICE2       0
VDECL VINT VOICE3       0
VDECL VINT VOICE4       0
VDECL VINT VOICE5       0
VDECL VINT VOICE6       0
VDECL VINT VOICE7       0
VDECL VINT VOICE8       0
VDECL VINT VOICE9       0
VDECL VINT VOICE10      0
VDECL VINT VOICE_CHECK  0


#On/Off switches for billboards
VDECL VINT BILLBOARD1  0
VDECL VINT BILLBOARD2  0


#Checks for actions within sections
VDECL VINT CHECK_MAP      0
VDECL VINT DID_CYCLE      0
VDECL VINT CHECK_TANKS    0
VDECL VINT DID_TANKS      0
VDECL VINT CHECK_INFANTRY 0


#Msc variables
VDECL VINT CUPID_WEAPON    0
VDECL VINT SOLDIER_COUNT   0
VDECL VINT LEAVE_TRIANGLE  0


#End integer variables



#Begin location variables

VDECL VLOC COMMAND_SITE_LOC  LOC ( 128, 122, 6000 )
VDECL VLOC INFANTRY_LOC      LOC ( 149, 140, 0 )

#End location variables

IF (VBL_TEST PLAYER_TANK_HEALTH 0 GREATER_THAN 0) THEN
(
	IF ( VBL_TEST SETUP EQUAL 0 ) THEN
	(
		SET_USE_DEFAULT_VICTORY 0
		SET_GATE GATE1 1
		CHANGE_VBL ACTION_TIME SET GAME_TIME
		CHANGE_VBL ACTION_TIME ADD 3
		CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
		CHANGE_VBL BILLBOARD_TIME ADD 1
		CHANGE_VBL SETUP SET 1
	)



	IF ( AND (( VBL_TEST SETUP EQUAL 1 ) ( VBL_TEST FIRST_MOVE EQUAL 0 )) ) THEN
	(

		IF ( NOT ( CLOSE_PT HTANK 0 COMMAND_SITE_LOC 10 ) ) THEN
		(

			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
			(

				IF ( VBL_TEST VOICE1 EQUAL 0 ) THEN
				(
					# "Okay, Commander.  Let's pilot your Wraith down the mountain to the command site."
					PLAY_SOUND TM01
					CHANGE_VBL VOICE1 SET 1
					SET_NAV_POINT COMMAND_SITE_LOC ON
					CHANGE_VBL ACTION_TIME SET GAME_TIME
					CHANGE_VBL ACTION_TIME ADD 10
					CHANGE_VBL ACTION_TIME2 SET GAME_TIME
					CHANGE_VBL ACTION_TIME2 ADD 3
					CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
					CHANGE_VBL BILLBOARD_TIME ADD 4
				)
				ELSE
				(
 #                                       IF (VBL_TEST REP_ITER GREATER_THAN REP_LEVEL) THEN
 #                                       (
 #                                               CHANGE_VBL REP_ITER SET 0
 #                                               CHANGE_VBL REP_LEVEL ADD 1

                                                IF ( VBL_TEST VOICE1 EQUAL 1 ) THEN
                                                (
                                                        # "Find the flashing navigation point on your radar, and move towards it."
                                                        PLAY_SOUND TM02
                                                        CHANGE_VBL VOICE1 SET 2
                                                        CHANGE_VBL ACTION_TIME SET GAME_TIME
                                                        CHANGE_VBL ACTION_TIME ADD 15
                                                        CHANGE_VBL ACTION_TIME2 SET GAME_TIME
                                                        CHANGE_VBL ACTION_TIME2 ADD 2
                                                        CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
                                                        CHANGE_VBL BILLBOARD_TIME ADD 4
                                                )
                                                ELSE
                                                (
                                                        # "Pilot your Wraith down the mountain to the command site, sir."
                                                        PLAY_SOUND TM03
                                                        CHANGE_VBL VOICE1 SET 1
                                                        CHANGE_VBL ACTION_TIME SET GAME_TIME
                                                        CHANGE_VBL ACTION_TIME ADD 15
                                                        CHANGE_VBL ACTION_TIME2 SET GAME_TIME
                                                        CHANGE_VBL ACTION_TIME2 ADD 2
                                                        CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
                                                        CHANGE_VBL BILLBOARD_TIME ADD 4
                                                )
 #                                       )ELSE
 #                                       (
 #                                              CHANGE_VBL REP_ITER ADD 1
 #                                       )
				)
			)


			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
			(
				SHOW_BILLBOARD {MOUSE CONTROLS YOUR VIEW \nUP AND DOWN ARROWS MOVE FORWARD AND BACK} 6
				CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 1
			)
		)
		ELSE
		(

			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME2 ) THEN
			(
				# "You're here, sir."
				PLAY_SOUND TM04
				SHOW_BILLBOARD {DESTINATION REACHED}
				CHANGE_VBL FIRST_MOVE SET 1
				CHANGE_VBL COMMAND_SITE SET 0
				CHANGE_VBL ACTION_TIME SET GAME_TIME
				CHANGE_VBL ACTION_TIME ADD 3
				CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 1
			)
		)
	)



IF ( VBL_TEST COMMAND_SITE EQUAL 0 ) THEN
(

	IF ( CLOSE_PT HTANK 0 COMMAND_SITE_LOC 25 ) THEN
	(
		CHANGE_VBL VOICE_CHECK SET 0
		SET_NAV_POINT COMMAND_SITE_LOC OFF


		IF ( AND (( VBL_TEST FIRST_MOVE EQUAL 1 ) ( VBL_TEST MAP EQUAL 0 )) ) THEN
		(

			IF ( NOT ( PLAYER_PROPS 0 IN_OVERHEAD_MAP ) ) THEN
			(

				IF ( VBL_TEST CHECK_MAP EQUAL 0 ) THEN
				(

					IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
					(

						IF ( VBL_TEST VOICE2 EQUAL 0 ) THEN
						(
							# "Good.  Now let's bring up your satellite map."
							PLAY_SOUND TM10
							CHANGE_VBL VOICE2 SET 1
							CHANGE_VBL ACTION_TIME SET GAME_TIME
                                                        CHANGE_VBL ACTION_TIME ADD 25
							CHANGE_VBL ACTION_TIME2 SET GAME_TIME
                                                        CHANGE_VBL ACTION_TIME2 ADD SOUND_LENGTH TM10
                                                        CHANGE_VBL ACTION_TIME2 ADD 1
							CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
							CHANGE_VBL BILLBOARD_TIME ADD 3
							CHANGE_VBL CHECK_TIME SET GAME_TIME
							CHANGE_VBL CHECK_TIME ADD 5
						)
						ELSE
						(
							#"Bring up your satellite map, Commander."
							PLAY_SOUND TM11
							CHANGE_VBL VOICE2 SET 0
							CHANGE_VBL ACTION_TIME SET GAME_TIME
                                                        CHANGE_VBL ACTION_TIME ADD 25
							CHANGE_VBL ACTION_TIME2 SET GAME_TIME
                                                        CHANGE_VBL ACTION_TIME2 ADD SOUND_LENGTH TM11
                                                        CHANGE_VBL ACTION_TIME2 ADD 4
							CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
							CHANGE_VBL BILLBOARD_TIME ADD 3
							CHANGE_VBL CHECK_TIME SET GAME_TIME
							CHANGE_VBL CHECK_TIME ADD 5
						)
					)


					IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
					(
						SHOW_BILLBOARD {PRESS 'O' FOR SATELLITE MAP} 5
						CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 1
					)
				)
				ELSE
				(

					IF ( VBL_TEST CHECK_MAP EQUAL 1 ) THEN
					(
						CHANGE_VBL MAP SET 1
						CHANGE_VBL ACTION_TIME SET GAME_TIME
						CHANGE_VBL ACTION_TIME SET 7
						CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 1
					)
					ELSE
					(
						GOTO_OVERHEAD 0
					)
				)
			)
			ELSE
			(

				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME2 ) THEN
				(

					IF ( VBL_TEST VOICE3 EQUAL 0 ) THEN
					(
						CHANGE_VBL ACTION_TIME2 SET GAME_TIME
						CHANGE_VBL ACTION_TIME2 ADD 3
						CHANGE_VBL CHECK_MAP SET 1
						CHANGE_VBL VOICE3 SET 1
					)
					ELSE
					(

						IF ( VBL_TEST VOICE3 EQUAL 1 ) THEN
						(
							# "The map shows the terrain you've explore.  You'll also manage your Citadels from here, which we'll cover later."
							PLAY_SOUND TM12
							CHANGE_VBL VOICE3 SET 2
							CHANGE_VBL ACTION_TIME2 SET GAME_TIME
							CHANGE_VBL ACTION_TIME2 ADD 10
							CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
							CHANGE_VBL BILLBOARD_TIME ADD 6
							CHANGE_VBL CHECK_TIME SET GAME_TIME
							CHANGE_VBL CHECK_TIME ADD 5
						)
						ELSE
						(
							# "Let's return to your Wraith, shall we?"
							PLAY_SOUND TM13
							CHANGE_VBL VOICE3 SET 1
							CHANGE_VBL ACTION_TIME2 SET GAME_TIME
							CHANGE_VBL ACTION_TIME2 ADD 10
							CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
							CHANGE_VBL BILLBOARD_TIME ADD 2
							CHANGE_VBL CHECK_TIME SET GAME_TIME
							CHANGE_VBL CHECK_TIME ADD 5
						)
					)
				)


				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
				(

					IF ( VBL_TEST BILLBOARD1 EQUAL 0 ) THEN
					(
						SHOW_BILLBOARD {IN THE MAP, PILOT YOUR WRAITH WITH THE ARROW KEYS} 6
						CHANGE_VBL BILLBOARD1 SET 1
						CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME2
						CHANGE_VBL BILLBOARD_TIME ADD 1
					)
					ELSE
					(
						SHOW_BILLBOARD {IN THE MAP, PILOT YOUR WRAITH WITH THE ARROW KEYS \nPRESS 'O' OR 'ESC' TO EXIT}  7
						CHANGE_VBL BILLBOARD1 SET 0
						CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME2
						CHANGE_VBL BILLBOARD_TIME ADD 1
					)
				)
			)
		)



		IF ( AND (( VBL_TEST MAP EQUAL 1 ) ( VBL_TEST WEAPON EQUAL 0 )) ) THEN
		(

			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
			(
				# "Your primary weapons are set to lasers, and your secondary weapons are set to missiles.  Try them if you like."
				PLAY_SOUND TM06
				CHANGE_VBL ACTION_TIME SET GAME_TIME
                                CHANGE_VBL ACTION_TIME ADD 4
                                CHANGE_VBL ACTION_TIME ADD SOUND_LENGTH TM06
				CHANGE_VBL ACTION_TIME2 SET GAME_TIME
                                CHANGE_VBL ACTION_TIME2 ADD SOUND_LENGTH TM06
                                CHANGE_VBL ACTION_TIME2 ADD 2
				CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 6
				CHANGE_VBL CHECK_TIME SET GAME_TIME
				CHANGE_VBL CHECK_TIME ADD 5
			)


			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
			(
				SHOW_BILLBOARD {LEFT CLICK FIRES PRIMARY \nRIGHT CLICK FIRES SECONDARY} 5
				CHANGE_VBL WEAPON SET 1
				CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 1
			)
		)



		IF ( AND (( VBL_TEST WEAPON EQUAL 1 ) ( VBL_TEST TRIANGLE EQUAL 0 )) ) THEN
		(

			IF ( NOT ( PLAYER_PROPS 0 IN_POWER_TRI ) ) THEN
			(

				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME2 ) THEN
				(
					# "The energy triangle customizes your Wraith's performance.  Bring it up now."
					PLAY_SOUND TM07
					CHANGE_VBL ACTION_TIME2 SET GAME_TIME
                                        CHANGE_VBL ACTION_TIME2 ADD 10
					CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
					CHANGE_VBL BILLBOARD_TIME ADD 3
					CHANGE_VBL CHECK_TIME SET GAME_TIME
					CHANGE_VBL CHECK_TIME ADD 5
				)


				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
				(
					SHOW_BILLBOARD {PRESS 'X' FOR ENERGY TRIANGLE} 5
					CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME2
					CHANGE_VBL BILLBOARD_TIME ADD 1
				)
			)
			ELSE
			(
				CHANGE_VBL TRIANGLE SET 1
				CHANGE_VBL ACTION_TIME SET GAME_TIME
				CHANGE_VBL ACTION_TIME ADD 4
				CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 1
				CHANGE_VBL CHECK_TIME SET GAME_TIME
				CHANGE_VBL CHECK_TIME ADD 5
			)
		)



		IF ( AND (( VBL_TEST TRIANGLE EQUAL 1 ) ( VBL_TEST CYCLE EQUAL 0 )) ) THEN
		(

			IF ( PLAYER_PROPS 0 IN_POWER_TRI ) THEN
			(

				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
				(

					IF ( VBL_TEST VOICE10 EQUAL 0 ) THEN
					(
						# "Adjusting the triangle redistributes power to the Wraith's weaponss, shields, or engines.  Try cycling through the settings."
						PLAY_SOUND TM08
						CHANGE_VBL ACTION_TIME SET GAME_TIME
						CHANGE_VBL ACTION_TIME ADD 10
						CHANGE_VBL VOICE10 SET 1
						CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 6
						CHANGE_VBL CHECK_TIME SET GAME_TIME
						CHANGE_VBL CHECK_TIME ADD 5
					)
					ELSE
					(
						# "Allocate all energy to firepower and close the traingle, sir."
						PLAY_SOUND TM09
						CHANGE_VBL DID_CYCLE SET 1
						CHANGE_VBL VOICE10 SET 0
						CHANGE_VBL ACTION_TIME SET GAME_TIME
						CHANGE_VBL ACTION_TIME ADD 15
						CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 2
						CHANGE_VBL CHECK_TIME SET GAME_TIME
						CHANGE_VBL CHECK_TIME ADD 5
					)
				)


				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
				(

					IF ( VBL_TEST BILLBOARD2 EQUAL 0 ) THEN
					(
						SHOW_BILLBOARD {PRESS 'C' TO CYCLE THROUGH SETTINGS \nLEFT CLICK MANUALLY ADJUSTS \nRIGHT CLICK EQUALIZES} 8
						CHANGE_VBL BILLBOARD2 SET 1
						CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 1
					)
					ELSE
					(
						SHOW_BILLBOARD {PRESS 'C' TO CYCLE THROUGH SETTINGS \nPRESS 'X' TO EXIT AND CONFIRM \nPRESS 'ESC' TO EXIT AND CANCEL} 7
						CHANGE_VBL BILLBOARD2 SET 2
						CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 1
					)
				)
			)
			ELSE
			(

				IF ( VBL_TEST PLAYER_WEPN_SETTING 0 EQUAL 100 ) THEN
				(
					CHANGE_VBL CYCLE SET 1
					CHANGE_VBL ACTION_TIME SET GAME_TIME
					CHANGE_VBL ACTION_TIME ADD 4
					CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
					CHANGE_VBL BILLBOARD_TIME ADD 1
					CHANGE_VBL CHECK_TIME SET GAME_TIME
					CHANGE_VBL CHECK_TIME ADD 5
				)
				ELSE
				(
					GOTO_PTRI 0
				)
			)
		)



		IF ( AND (( VBL_TEST CYCLE EQUAL 1 ) ( VBL_TEST STRAFE EQUAL 0 )) ) THEN
		(

			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
			(
				# "Besides moving forward and back, your Wraith can strafe from side to side."
				PLAY_SOUND TM05
				CHANGE_VBL ACTION_TIME SET GAME_TIME
				CHANGE_VBL ACTION_TIME ADD 10
				CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 2
				CHANGE_VBL CHECK_TIME SET GAME_TIME
				CHANGE_VBL CHECK_TIME ADD 5
			)


			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
			(
				SHOW_BILLBOARD {STRAFE TO DODGE ENEMY FIRE \nLEFT AND RIGHT ARROWS STRAFE LEFT AND RIGHT} 8
				CHANGE_VBL STRAFE SET 1
				CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 1
			)
		)



		IF ( AND (( VBL_TEST STRAFE EQUAL 1 ) ( VBL_TEST TANKS EQUAL 0 )) ) THEN
		(

			IF ( VBL_TEST CHECK_TANKS EQUAL 0 ) THEN
			(

				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
				(

					IF ( VBL_TEST VOICE4 EQUAL 0 ) THEN
					(
						# "Now for a battle simulation.  Remember those weapons, because you're about to face three enemy tanks."
						PLAY_SOUND TM14
						CHANGE_VBL VOICE4 SET 1
						CHANGE_VBL ACTION_TIME SET GAME_TIME
						CHANGE_VBL ACTION_TIME ADD 5
						CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 3
						CHANGE_VBL CHECK_TIME SET GAME_TIME
						CHANGE_VBL CHECK_TIME ADD 5
					)
					ELSE
					(

						IF ( VBL_TEST VOICE4 EQUAL 1 ) THEN
						(
							# "Here they come."
							PLAY_SOUND TM20
							CHANGE_VBL VOICE4 SET 2
							CHANGE_VBL ACTION_TIME SET GAME_TIME
							CHANGE_VBL ACTION_TIME ADD 1
							CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
							CHANGE_VBL BILLBOARD_TIME ADD 1
							CHANGE_VBL CHECK_TIME SET GAME_TIME
							CHANGE_VBL CHECK_TIME ADD 5
						)
						ELSE
						(
							CREATE_UNIT TANK1 5 AI_TANK LOC ( 101, 118, 0 ) YAW (0) NULL NULL
							CREATE_UNIT TANK2 5 AI_TANK LOC ( 120, 97, 0 )  YAW (0) NULL NULL
							CREATE_UNIT TANK3 5 AI_TANK LOC ( 100, 101, 0 ) YAW (0) NULL NULL
							SET_MOVEMENT_PATH TANK1 TANK1PATH
							SET_MOVEMENT_PATH TANK2 TANK2PATH
							SET_MOVEMENT_PATH TANK3 TANK3PATH
							CHANGE_VBL CHECK_TANKS SET 1
							CHANGE_VBL ACTION_TIME SET GAME_TIME
							CHANGE_VBL ACTION_TIME ADD 10
							CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
							CHANGE_VBL BILLBOARD_TIME ADD 1
						)
					)
				)


				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
				(
					SHOW_BILLBOARD {LEFT CLICK FIRES PRIMARY \nRIGHT CLICK FIRES SECONDARY} 5
					CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
					CHANGE_VBL BILLBOARD_TIME ADD 1
				)
			)
			ELSE
			(

				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
				(

					IF ( VBL_TEST VOICE5 EQUAL 0 ) THEN
					(
						# "Finsh off those enemy tanks, sir."
						PLAY_SOUND TM15
						CHANGE_VBL VOICE5 SET 1
						CHANGE_VBL ACTION_TIME SET GAME_TIME
                                                CHANGE_VBL ACTION_TIME ADD 30
						CHANGE_VBL CHECK_TIME SET GAME_TIME
						CHANGE_VBL CHECK_TIME ADD 5
					)
					ELSE
					(
						#"Sir, those tanks are still active."
						PLAY_SOUND TM16
						CHANGE_VBL VOICE5 SET 0
						CHANGE_VBL ACTION_TIME SET GAME_TIME
                                                CHANGE_VBL ACTION_TIME ADD 30
						CHANGE_VBL CHECK_TIME SET GAME_TIME
						CHANGE_VBL CHECK_TIME ADD 5
					)
				)


				IF ( AND (( LIVED_AND_DIED TANK1 ) ( LIVED_AND_DIED TANK2 )) ) THEN
				(

					IF ( LIVED_AND_DIED TANK3 ) THEN
					(
						CHANGE_VBL TANKS SET 1
						CHANGE_VBL ACTION_TIME SET GAME_TIME
						CHANGE_VBL ACTION_TIME ADD 2
						CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 1
						CHANGE_VBL CHECK_TIME SET GAME_TIME
						CHANGE_VBL CHECK_TIME ADD 5
					)
				)
			)
		)



		IF ( AND (( VBL_TEST TANKS EQUAL 1 ) ( VBL_TEST SWITCH EQUAL 0 )) ) THEN
		(

			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
			(

				IF ( VBL_TEST VOICE6 EQUAL 0 ) THEN
				(
					# "Well done.  Now switch your secondary weapon to the cupid Missile system."
					PLAY_SOUND TM17
					CHANGE_VBL VOICE6 SET 1
					CHANGE_VBL ACTION_TIME SET GAME_TIME
					CHANGE_VBL ACTION_TIME ADD 10
					CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
					CHANGE_VBL BILLBOARD_TIME ADD 3
					CHANGE_VBL CHECK_TIME SET GAME_TIME
					CHANGE_VBL CHECK_TIME ADD 5
				)
				ELSE
				(
					# "Commander, please switch to Cupid Missiles"
					PLAY_SOUND TM18
					CHANGE_VBL VOICE6 SET 0
					CHANGE_VBL ACTION_TIME SET GAME_TIME
                                        CHANGE_VBL ACTION_TIME ADD 30
					CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
					CHANGE_VBL BILLBOARD_TIME ADD 2
					CHANGE_VBL CHECK_TIME SET GAME_TIME
					CHANGE_VBL CHECK_TIME ADD 5
				)
			)


			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
			(
				SHOW_BILLBOARD {PRESS 'ENTER' FOR WEAPONS MENU \nLEFT CLICK TO CHOOSE WEAPON} 6
				CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 1
			)


			CURRENT_WEAPON 0 RIGHT CUPID_WEAPON
                        IF ( VBL_TEST CUPID_WEAPON EQUAL 5 ) THEN
			(
				CHANGE_VBL SWITCH SET 1
				CHANGE_VBL COMMAND_SITE SET 1
				CHANGE_VBL ACTION_TIME SET GAME_TIME
				CHANGE_VBL ACTION_TIME ADD 5
				CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 1
				CHANGE_VBL CHECK_TIME SET GAME_TIME
				CHANGE_VBL CHECK_TIME ADD 5
			)
		)
	)
	ELSE
	(
		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL CHECK_TIME ) THEN
		(

			IF ( VBL_TEST VOICE_CHECK EQUAL 0 ) THEN
			(
				# "Sir, please return to your command site."
				PLAY_SOUND TM24
				CHANGE_VBL VOICE_CHECK SET 1
				SET_NAV_POINT COMMAND_SITE_LOC ON
				CHANGE_VBL CHECK_TIME SET GAME_TIME
				CHANGE_VBL CHECK_TIME ADD 10
				CHANGE_VBL ACTION_TIME SET GAME_TIME
				CHANGE_VBL ACTION_TIME ADD 5
				CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 2
			)
			ELSE
			(
				# "Follow the flashing nav point on your radar, Commander."
				PLAY_SOUND TM25
				CHANGE_VBL VOICE_CHECK SET 1
				CHANGE_VBL CHECK_TIME SET GAME_TIME
				CHANGE_VBL CHECK_TIME ADD 10
				CHANGE_VBL ACTION_TIME SET GAME_TIME
				CHANGE_VBL ACTION_TIME ADD 5
				CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
				CHANGE_VBL BILLBOARD_TIME ADD 3
			)
		)


		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
		(
			SHOW_BILLBOARD {FOLLOW FLASHING NAV POINT ON RADAR} 5
			CHANGE_VBL BILLBOARD_TIME SET CHECK_TIME
			CHANGE_VBL BILLBOARD_TIME ADD 1
		)
	)
)



	IF ( AND (( VBL_TEST SWITCH EQUAL 1 ) ( VBL_TEST INFANTRY EQUAL 0 )) ) THEN
	(

		IF ( VBL_TEST CHECK_INFANTRY EQUAL 0 ) THEN
		(

			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
			(

				IF ( VBL_TEST VOICE7 EQUAL 0 ) THEN
				(
					# "Okay, let's use those missiles to wipe out a squad of troops coming your way."
					PLAY_SOUND TM19
					CHANGE_VBL VOICE7 SET 1
					CHANGE_VBL ACTION_TIME SET GAME_TIME
					CHANGE_VBL ACTION_TIME ADD 5
					CHANGE_VBL BILLBOARD_TIME SET GAME_TIME
					CHANGE_VBL BILLBOARD_TIME ADD 3
				)
				ELSE
				(

					IF ( VBL_TEST VOICE7 EQUAL 1 ) THEN
					(
						# "Here they come."
						PLAY_SOUND TM20
						CHANGE_VBL VOICE7 SET 2
						CHANGE_VBL ACTION_TIME SET GAME_TIME
						CHANGE_VBL ACTION_TIME ADD 2
						CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 1
					)
					ELSE
					(
						CREATE_UNIT INF01 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF02 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF03 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF04 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF05 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF06 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF07 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF08 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF09 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF10 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF11 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF12 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF13 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF14 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF15 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF16 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF17 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF18 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF19 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF20 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF21 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF22 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CREATE_UNIT INF23 5 SOLDIER INFANTRY_LOC YAW (0) NULL NULL
						CHANGE_VBL CHECK_INFANTRY SET 1
						CHANGE_VBL ACTION_TIME SET GAME_TIME
						CHANGE_VBL ACTION_TIME ADD 5
						CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
						CHANGE_VBL BILLBOARD_TIME ADD 1
					)
				)
			)


			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BILLBOARD_TIME ) THEN
			(

				CURRENT_WEAPON 0 RIGHT CUPID_WEAPON
				IF ( VBL_TEST CUPID_WEAPON EQUAL 6 ) THEN
				(
					SHOW_BILLBOARD {RIGHT CLICK FIRES CUPID MISSILES} 5
					CHANGE_VBL BILLBOARD_TIME SET ACTION_TIME
					CHANGE_VBL BILLBOARD_TIME ADD 1
				)
			)
		)
		ELSE
		(
			COUNT_OBJECTS 5 SOLDIER SOLDIER_COUNT

			IF ( VBL_TEST SOLDIER_COUNT GREATER_THAN 0 ) THEN
			(

				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
				(

					IF ( VBL_TEST VOICE8 EQUAL 0 ) THEN
					(
						# "Sir, take out the troops with your cupid missiles."
						PLAY_SOUND TM21
						CHANGE_VBL VOICE8 SET 1
						CHANGE_VBL ACTION_TIME SET GAME_TIME
                                                CHANGE_VBL ACTION_TIME ADD 30
						CHANGE_VBL ACTION_TIME2 SET GAME_TIME
                                                CHANGE_VBL ACTION_TIME2 ADD SOUND_LENGTH TM21
                                                CHANGE_VBL ACTION_TIME2 ADD 1
					)
					ELSE
					(
						#"We're picking up some survivors on radar, Commander."
						PLAY_SOUND TM22
						CHANGE_VBL VOICE8 SET 0
						CHANGE_VBL ACTION_TIME SET GAME_TIME
                                                CHANGE_VBL ACTION_TIME ADD 30
						CHANGE_VBL ACTION_TIME2 SET GAME_TIME
                                                CHANGE_VBL ACTION_TIME2 ADD SOUND_LENGTH TM22
                                                CHANGE_VBL ACTION_TIME2 ADD 1
                                        )
				)
                        )
			ELSE
			(

				IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME2 ) THEN
				(

					IF ( VBL_TEST VOICE9 EQUAL 0 ) THEN
					(
                                                END_MISSION 0 1 20 {\n CONGRATULATIONS ON YOUR SUCCESSFUL COMPLETION OF TRAINING MISSION 1. \n \n TRAINING MISSION 2 WILL INTRODUCE YOU TO SUPPORT UNITS AND LAYING SIEGE TO BUILDINGS. }
						CHANGE_VBL ACTION_TIME2 SET GAME_TIME
						CHANGE_VBL ACTION_TIME2 ADD 2
						CHANGE_VBL VOICE9 SET 1
					)
					ELSE
					(

                                                IF ( VBL_TEST VOICE9 EQUAL 1 ) THEN
						(
                                                        # "Congratulations, Commander.  You've completed your first mission."
							PLAY_SOUND TM23
							CHANGE_VBL ACTION_TIME2 SET GAME_TIME
							CHANGE_VBL ACTION_TIME2 ADD SOUND_LENGTH TM23
							CHANGE_VBL ACTION_TIME2 ADD 1
							CHANGE_VBL VOICE9 SET 2
						)
						ELSE
						(
							SET_GATE GATE1 0
							CHANGE_VBL INFANTRY SET 1
						)
					)
				)
			)
		)
	)

)

END_SCRIPT_FILE

