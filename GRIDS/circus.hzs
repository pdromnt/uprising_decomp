	#Increasing foritifcation for FFF making it to the base and teleporting out
	IF ( CLOSE_PT FFF END 2 ) THEN
	(
		REMOVE_UNIT FFF


		IF ( VBL_TEST FFF_STRENGTH EQUAL 0 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 10
		)


		IF ( VBL_TEST FFF_STRENGTH EQUAL 1 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 10
		)


		IF ( VBL_TEST FFF_STRENGTH EQUAL 2 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 20
		)


		IF ( VBL_TEST FFF_STRENGTH EQUAL 3 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 20
		)


		IF ( VBL_TEST FFF_STRENGTH EQUAL 4 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 30
		)


		IF ( VBL_TEST FFF_STRENGTH EQUAL 5 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 30
		)
	)



	IF ( IS_ALIVE AAA ) THEN
	(
		CHANGE_VBL AAA_PU SET 0
		GET_LOCATION AAA AAA_LOC
	)



	IF ( VBL_TEST AAA_PU EQUAL 0 ) THEN
	(

		IF ( DIED_VIOLENT AAA ) THEN
		(

			IF ( VBL_TEST AAA_STRENGTH EQUAL 0 ) THEN
			(
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST AAA_STRENGTH EQUAL 1 ) THEN
			(
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST AAA_STRENGTH EQUAL 2 ) THEN
			(
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST AAA_STRENGTH EQUAL 3 ) THEN
			(
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST AAA_STRENGTH EQUAL 4 ) THEN
			(
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST AAA_STRENGTH EQUAL 5 ) THEN
			(
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 AAA_LOC PU_RANDOM 1
			)

			CHANGE_VBL AAA_ESCORT_TIME SET GAME_TIME
			CHANGE_VBL AAA_ESCORT_TIME ADD 30
			CHANGE_VBL AAA_ESCORT SET 0
			CHANGE_VBL AAA_PU SET 1
		)
	)



	IF ( VBL_TEST AAA_ESCORT EQUAL 0 ) THEN
	(

		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL AAA_ESCORT_TIME ) THEN
		(
			REMOVE_UNIT AAATANK1
			REMOVE_UNIT AAATANK2
			CHANGE_VBL AAA_ESCORT SET 1
		)
	)



	IF ( IS_ALIVE BBB ) THEN
	(
		CHANGE_VBL BBB_PU SET 0
		GET_LOCATION BBB BBB_LOC
	)




	IF ( VBL_TEST BBB_PU EQUAL 0 ) THEN
	(

		IF ( DIED_VIOLENT BBB ) THEN
		(

			IF ( VBL_TEST BBB_STRENGTH EQUAL 0 ) THEN
			(
				CREATE_FIXED_PU NULL 0 BBB_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST BBB_STRENGTH EQUAL 1 ) THEN
			(
				CREATE_FIXED_PU NULL 0 BBB_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 BBB_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST BBB_STRENGTH EQUAL 2 ) THEN
			(
				CREATE_FIXED_PU NULL 0 BBB_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 BBB_LOC PU_RANDOM 1
