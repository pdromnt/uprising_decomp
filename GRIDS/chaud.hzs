START_SCRIPT_FILE

VDECL VINT DONE_SETUP  		0
VDECL VINT ACTION_TIME 		0
VDECL VINT AID  			0
VDECL VINT ATTACK1    		0
VDECL VINT CLOSEPT    		0
VDECL VINT FRONTLEFT    	0
VDECL VINT FRONTRIGHT  		0
VDECL VINT BACKLEFT		0
VDECL VINT SOLDIER 		0
VDECL VINT BILLBOARD		0
VDECL VINT SWOOP			0
VDECL VINT GATE			0
VDECL VINT COUNT			0
VDECL VINT  PU_A  		0
VDECL VINT  PU_B  		0
VDECL VINT PU_A_TIME  		0
VDECL VINT PU_B_TIME  		0
VDECL VINT POWERUP1		0
VDECL VINT POWERUP2		0
VDECL VINT POWERUP3		0
VDECL VINT CITADEL_COUNT 	0
VDECL VINT END_BILLBOARD 	0
VDECL VINT PLAYER_SLOT     	0
VDECL VINT MISSION_FAILED 	0
VDECL VINT MULTIGATE		0



VDECL VLOC AID LOC (62, 62, 0)
VDECL VLOC ATTACK1 LOC (65, 68, 0)
VDECL VLOC DAVE1 LOC (45, 227, 0)
VDECL VLOC DAVE2 LOC (48, 226, 0)
VDECL VLOC DAVE3 LOC (187, 127, 0)
VDECL VLOC DAVE4 LOC (191, 125, 0)
VDECL VLOC SEIGE1 LOC (43, 91, 0)
VDECL VLOC SEIGE2 LOC (48, 91, 0)
VDECL VLOC SEIGE3 LOC (113, 42, 0)
VDECL VLOC SEIGE4 LOC (113, 36, 0)
VDECL VLOC SPRINT1 LOC (74, 114, 0)
VDECL VLOC SPRINT2 LOC (118, 32, 0)
VDECL VLOC SPRINT3 LOC (143, 233, 0)
VDECL VLOC CLOSEPT1 LOC (59, 60, 0)
VDECL VLOC SOLDIER1 LOC (62, 71, 0)
VDECL VLOC SOLDIER2 LOC (62, 73, 0)
VDECL VLOC SOLDIER3 LOC (62, 75, 0)
VDECL VLOC SOLDIER4 LOC (69, 68, 0)
VDECL VLOC SOLDIER5 LOC (71, 68, 0)
VDECL VLOC SOLDIER6 LOC (73, 68, 0)
VDECL VLOC CLOSEPT2 LOC (172, 164, 0)
VDECL VLOC SWOOP1 LOC (214, 108, 0)
VDECL VLOC SWOOP2 LOC (235, 147, 0)
VDECL VLOC GATEFINAL LOC (183, 170, 0)





IF ( VBL_TEST AID EQUAL 0 ) THEN
(
	CHANGE_VBL ACTION_TIME SET GAME_TIME
	CHANGE_VBL ACTION_TIME ADD 1
	CHANGE_VBL AID SET 1
)

IF (AND ((VBL_TEST AID EQUAL 1)(VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME)) ) THEN
(
	CREATE_UNIT INF01 0 SOLDIER AID YAW (0) NULL NULL
	CREATE_UNIT INF02 0 SOLDIER AID YAW (0) NULL NULL
	CREATE_UNIT INF03 0 SOLDIER AID YAW (0) NULL NULL
	CREATE_UNIT INF04 0 SOLDIER AID YAW (0) NULL NULL
	SET_MOVEMENT_PATH INF01 AID 
	SET_MOVEMENT_PATH INF02 AID
	SET_MOVEMENT_PATH INF03 AID 
	SET_MOVEMENT_PATH INF04 AID 
	CHANGE_VBL AID SET 2
)

IF ( AND (( VBL_TEST ATTACK1 EQUAL 0)(CITADEL_OWNED 0 1)) ) THEN
(
	CREATE_UNIT ITANK1 4 AI_TANK ATTACK1 YAW (0) NULL NULL
	CREATE_UNIT ITANK2 4 AI_TANK ATTACK1 YAW (0) NULL NULL
	CREATE_UNIT ITANK3 4 AI_TANK ATTACK1 YAW (0) NULL NULL
	CREATE_UNIT YOAAV  4 AAV ATTACK1 YAW (0) NULL NULL
	CREATE_UNIT IMINF1 4 SOLDIER ATTACK1 YAW (0) NULL NULL
	CREATE_UNIT IMINF2 4 SOLDIER ATTACK1 YAW (0) NULL NULL
	CREATE_UNIT IMINF3 4 SOLDIER ATTACK1 YAW (0) NULL NULL
	SET_MOVEMENT_PATH ITANK1 ATTACK1 
	SET_MOVEMENT_PATH ITANK2 ATTACK1 
	SET_MOVEMENT_PATH ITANK3 ATTACK1 
	SET_MOVEMENT_PATH YOAAV ATTACK1 
	SET_MOVEMENT_PATH IMINF1 ATTACK1 
	SET_MOVEMENT_PATH IMINF2 ATTACK1 
	SET_MOVEMENT_PATH IMINF3 ATTACK1 
	CHANGE_VBL ATTACK1 SET 1 	
)

IF ( AND ((CITADEL_OWNED 0 1)(CLOSE_PT HTANK 0 CLOSEPT1 10 )) ) THEN
(
	IF (VBL_TEST CLOSEPT EQUAL 0)  THEN
	(
		CREATE_UNIT IMPINF1 4 SOLDIER SOLDIER1 YAW (0) NULL NULL
		CREATE_UNIT IMPINF2 4 SOLDIER SOLDIER2 YAW (0) NULL NULL
		CREATE_UNIT IMPINF3 4 SOLDIER SOLDIER3 YAW (0) NULL NULL
		CREATE_UNIT IMPINF4 4 SOLDIER SOLDIER4 YAW (0) NULL NULL
		CREATE_UNIT IMPINF5 4 SOLDIER SOLDIER5 YAW (0) NULL NULL
		CREATE_UNIT IMPINF6 4 SOLDIER SOLDIER6 YAW (0) NULL NULL
		CHANGE_VBL CLOSEPT SET 1
	)
)
 


IF ( AND (( VBL_TEST FRONTLEFT EQUAL 0)(CITADEL_OWNED 0 3)) ) THEN
(
	CREATE_UNIT IAAV1 4 AAV DAVE1 YAW (0) NULL NULL
	CREATE_UNIT IAAV2 4 AAV DAVE2 YAW (0) NULL NULL
	CREATE_UNIT IMPTANK1 4 AI_TANK SEIGE1 YAW (0) NULL NULL
	CREATE_UNIT IMPTANK2 4 AI_TANK SEIGE2 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD1 4 SOLDIER SPRINT1 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD2 4 SOLDIER SPRINT1 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD3 4 SOLDIER SPRINT1 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD4 4 SOLDIER SPRINT1 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD5 4 SOLDIER SPRINT1 YAW (0) NULL NULL
	SET_MOVEMENT_PATH IAAV1 DAVE1 
	SET_MOVEMENT_PATH IAAV2 DAVE2 
	SET_MOVEMENT_PATH IMPTANK1 SEIGE1 
	SET_MOVEMENT_PATH IMPTANK2 SEIGE2
	SET_MOVEMENT_PATH IMPSOLD1 SPRINT1 
	SET_MOVEMENT_PATH IMPSOLD2 SPRINT1 
	SET_MOVEMENT_PATH IMPSOLD3 SPRINT1 
	SET_MOVEMENT_PATH IMPSOLD4 SPRINT1 
	SET_MOVEMENT_PATH IMPSOLD5 SPRINT1 
	CHANGE_VBL FRONTLEFT SET 1 
)

IF ( AND (( VBL_TEST FRONTRIGHT EQUAL 0)(CITADEL_OWNED 0 2)) ) THEN
(
	CREATE_UNIT IAAV3 4 AAV DAVE3 YAW (0) NULL NULL
	CREATE_UNIT IAAV4 4 AAV DAVE4 YAW (0) NULL NULL
	CREATE_UNIT IMPTANK3 4 AI_TANK SEIGE3 YAW (0) NULL NULL
	CREATE_UNIT IMPTANK4 4 AI_TANK SEIGE4 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD6 4 SOLDIER SPRINT2 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD7 4 SOLDIER SPRINT2 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD8 4 SOLDIER SPRINT2 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD9 4 SOLDIER SPRINT2 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD10 4 SOLDIER SPRINT2 YAW (0) NULL NULL
	SET_MOVEMENT_PATH IAAV3 DAVE3 
	SET_MOVEMENT_PATH IAAV4 DAVE4
	SET_MOVEMENT_PATH IMPTANK3 SEIGE3 
	SET_MOVEMENT_PATH IMPTANK4 SEIGE4
	SET_MOVEMENT_PATH IMPSOLD6 SPRINT2 
	SET_MOVEMENT_PATH IMPSOLD7 SPRINT2 
	SET_MOVEMENT_PATH IMPSOLD8 SPRINT2 
	SET_MOVEMENT_PATH IMPSOLD9 SPRINT2 
	SET_MOVEMENT_PATH IMPSOLD10 SPRINT2   
	CHANGE_VBL FRONTRIGHT SET 1 
)

IF ( AND (( VBL_TEST BACKLEFT EQUAL 0)(CITADEL_OWNED 0 0)) ) THEN
(

	CREATE_UNIT IMPSOLD11 4 SOLDIER SPRINT3 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD12 4 SOLDIER SPRINT3 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD13 4 SOLDIER SPRINT3 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD14 4 SOLDIER SPRINT3 YAW (0) NULL NULL
	CREATE_UNIT IMPSOLD15 4 SOLDIER SPRINT3 YAW (0) NULL NULL
	SET_MOVEMENT_PATH IMPSOLD11 SPRINT3 
	SET_MOVEMENT_PATH IMPSOLD12 SPRINT3 
	SET_MOVEMENT_PATH IMPSOLD13 SPRINT3 
	SET_MOVEMENT_PATH IMPSOLD14 SPRINT3 
	SET_MOVEMENT_PATH IMPSOLD15 SPRINT3   
	CHANGE_VBL BACKLEFT SET 1 
)

IF ( VBL_TEST PU_A EQUAL 0 ) THEN
(
	CREATE_FIXED_PU PU_A 0 LOC(63, 193, 0) PU_HEALTH 50
	CHANGE_VBL PU_A SET 1
)

IF ( VBL_TEST PU_A EQUAL 1 ) THEN
(

	IF ( NOT ( IS_ALIVE PU_A ) ) THEN
	(
		CHANGE_VBL PU_A_TIME SET GAME_TIME
		CHANGE_VBL PU_A_TIME ADD 10
		CHANGE_VBL PU_A SET 2
	)
)

IF ( VBL_TEST PU_A EQUAL 2 ) THEN
(

	IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL PU_A_TIME ) THEN
	(
		CHANGE_VBL PU_A SET 0
	)
)

IF ( VBL_TEST PU_B EQUAL 0 ) THEN
(
	CREATE_FIXED_PU PU_B 0 LOC(187, 90, 0) PU_HEALTH 50
	CHANGE_VBL PU_B SET 1
)


IF ( VBL_TEST PU_B EQUAL 1 ) THEN
(

	IF ( NOT ( IS_ALIVE PU_B ) ) THEN
	(
		CHANGE_VBL PU_B_TIME SET GAME_TIME
		CHANGE_VBL PU_B_TIME ADD 20
		CHANGE_VBL PU_B SET 2
	)
)

IF ( VBL_TEST PU_B EQUAL 2 ) THEN
(

	IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL PU_B_TIME ) THEN
	(
		CHANGE_VBL PU_B SET 0
	)
)

IF (AND ((VBL_TEST SWOOP EQUAL 0)(CLOSE_PT HTANK 0 CLOSEPT2 15 )) ) THEN
(
	CREATE_UNIT BUGGER1 4 AAV SWOOP1 YAW (0) NULL NULL
	CREATE_UNIT BUGGER2 4 AAV SWOOP2 YAW (0) NULL NULL
	SET_MOVEMENT_PATH BUGGER1 SWOOP1 
	SET_MOVEMENT_PATH BUGGER2 SWOOP2
	CHANGE_VBL SWOOP SET 1
)

IF ( AND ((CITADEL_OWNED 0 0)(VBL_TEST BILLBOARD EQUAL 0)) ) THEN
(
	IF (CITADEL_OWNED 0 5) THEN
	(
		SHOW_BILLBOARD {NORTH GATE IS DEACTIVATED} 7
		CHANGE_VBL BILLBOARD SET 1
	)
)		

IF (AND ((CITADEL_OWNED 0 0)(VBL_TEST BILLBOARD EQUAL 1)) ) THEN
( 
	IF (AND ((CITADEL_OWNED 0 5)(CLOSE_PT HTANK 0 GATEFINAL 10)) ) THEN
	(
		SET_GATE GATEFINAL 0
		CHANGE_VBL BILLBOARD SET 2
	)
)

IF (VBL_TEST POWERUP1 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_C 0 LOC(44, 240, 0) PU_BOMBERS 1
	CHANGE_VBL POWERUP1 SET 1
)

IF (VBL_TEST POWERUP2 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_D 0 LOC(244, 64, 0) PU_SPECIAL_WEAPON_BOOST 1
	CHANGE_VBL POWERUP2 SET 1
)

IF (VBL_TEST POWERUP3 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_E 0 LOC(120, 108, 0) PU_BOMBERS 1
	CHANGE_VBL POWERUP3 SET 1
)


	IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
	(
		CHANGE_VBL MISSION_FAILED SET 1
	)
	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT ALL  ) THEN
		(
			END_MISSION PLAYER_SLOT 1 10 {MISSION ACCOMPLISHED}
			CHANGE_VBL MISSION_FAILED SET 1
		)
	)


	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
		(

			IF ( NOT ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT 0 ) ) THEN
			(
				END_MISSION PLAYER_SLOT 0 10 {MISSION FAILED}
			)
		)
	)

START_SECTION_MP_ONLY
		
	IF (VBL_TEST MULTIGATE EQUAL 0) THEN
	(	
		SET_GATE GATEFINAL 0	
		CHANGE_VBL MULTIGATE SET 1
	)

END_SECTION


END_SCRIPT_FILE


