				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
			)

			CHANGE_VBL DDD_ESCORT_TIME SET GAME_TIME
			CHANGE_VBL DDD_ESCORT_TIME ADD 30
			CHANGE_VBL DDD_ESCORT SET 0
			CHANGE_VBL DDD_PU SET 1
		)
	)



	IF ( VBL_TEST DDD_ESCORT EQUAL 0 ) THEN
	(

		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL DDD_ESCORT_TIME ) THEN
		(
			REMOVE_UNIT DDDTANK1
			REMOVE_UNIT DDDTANK2
			CHANGE_VBL DDD_ESCORT SET 1
		)
	)



