	)
	IF ( CLOSE_PT CCC SOUTH_GATE 5 ) THEN
	(
		SET_MOVEMENT_PATH CCC END
		REMOVE_UNIT CCCTANK1
		REMOVE_UNIT CCCTANK2
	)


	#Setting DDD to move to the teleport pad
	IF ( OR (( CLOSE_PT DDD NORTH_GATE 5 ) ( CLOSE_PT DDD WEST_GATE 5 )) ) THEN
	(
		SET_MOVEMENT_PATH DDD END_WEST
		REMOVE_UNIT DDDTANK1
		REMOVE_UNIT DDDTANK2
	)
