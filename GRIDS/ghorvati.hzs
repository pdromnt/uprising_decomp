START_SCRIPT_FILE

VDECL VINT DONE_SETUP  		0
VDECL VINT ACTION_TIME 		0
VDECL VINT VISTA  		0
VDECL VINT CITADEL1    		0
VDECL VINT CITADEL2    		0
VDECL VINT BILLBOARD1  		0
VDECL VINT GATEDOWN1		0
VDECL VINT GATEDOWN2      	0
VDECL VINT HTURRET		0
VDECL VINT COUNT 			0
VDECL VINT FINAL			0
VDECL VINT CITADEL_COUNT	0
VDECL VINT COUNTER		0
VDECL VINT BOMBER			0
VDECL VINT POWERUP1		0
VDECL VINT POWERUP2		0
VDECL VINT PU_A  			0
VDECL VINT PU_B  			0
VDECL VINT PU_A_TIME  		0
VDECL VINT PU_B_TIME  		0
VDECL VINT END_BILLBOARD	0
VDECL VINT PLAYER_SLOT     	0
VDECL VINT MISSION_FAILED 	0



VDECL VLOC FIRST_OFFENSE LOC (28, 55, 0)
VDECL VLOC SECOND_OFFENSE LOC (30, 49, 0)
VDECL VLOC THIRD_OFFENSE LOC (33,41, 0)
VDECL VLOC MYAAV_START LOC (17, 6, 2500)
VDECL VLOC MYAAV2_START LOC (22, 5, 2500)
VDECL VLOC IAAV_START1 LOC (103, 76, 700)
VDECL VLOC IAAV_START2 LOC (105, 74, 700)
VDECL VLOC IAAV2_START1 LOC (66, 98, 2500)
VDECL VLOC ITANK_START1 LOC (80, 144, 0)
VDECL VLOC ITANK_START2 LOC (80, 144, 0)
VDECL VLOC ITANK_START3 LOC (80, 144, 0)
VDECL VLOC VISTA LOC (93, 161, 0)
VDECL VLOC BOWL1 LOC (89, 175, 500)
VDECL VLOC BOWL2 LOC (100, 170, 500)
VDECL VLOC BOWL3 LOC (113, 162, 500)
VDECL VLOC GATE1 LOC (162, 184, 0)
VDECL VLOC GATE2 LOC (212, 174, 0)
VDECL VLOC HTURRET LOC (176, 201, 0)
VDECL VLOC TUR1 LOC (168, 194,  0)
VDECL VLOC TUR2 LOC (170, 193, 0)
VDECL VLOC FINAL_CLOSEPT LOC (214, 162, 369)
VDECL VLOC BOMBER1 LOC (254, 195, 0)
VDECL VLOC BOMBER2 LOC (239, 192, 0)
VDECL VLOC BOMBER3 LOC (225, 195, 0)
VDECL VLOC BOMBER4 LOC (191, 205, 0)
VDECL VLOC BOMBER5 LOC (182, 185, 0)
VDECL VLOC BOMBER6 LOC (157, 180, 0)
VDECL VLOC BOMBER7 LOC (218, 195, 0)
VDECL VLOC BOMBER8 LOC (212, 195, 0)
VDECL VLOC BOMBER9 LOC (203, 195, 0)





IF ( VBL_TEST DONE_SETUP EQUAL 0 ) THEN
(
	CHANGE_VBL ACTION_TIME SET GAME_TIME
	CHANGE_VBL ACTION_TIME ADD 3
	CHANGE_VBL DONE_SETUP SET 1
)

IF (AND ((VBL_TEST DONE_SETUP EQUAL 1)(VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME)) ) THEN
(
	CREATE_UNIT INF01 0 SOLDIER FIRST_OFFENSE YAW (0) NULL NULL
	CREATE_UNIT INF02 0 SOLDIER SECOND_OFFENSE YAW (0) NULL NULL
	CREATE_UNIT INF03 0 SOLDIER THIRD_OFFENSE YAW (0) NULL NULL
	CREATE_UNIT TANK1 0 AI_TANK FIRST_OFFENSE YAW (0) NULL NULL
	#CREATE_UNIT TANK2 0 AI_TANK SECOND_OFFENSE YAW (0) NULL NULL
	#CREATE_UNIT TANK3 0 AI_TANK THIRD_OFFENSE YAW (0) NULL NULL
	CREATE_UNIT MYAAV1 0 AAV MYAAV_START YAW (0) NULL NULL
	#CREATE_UNIT MYAAV2 0 AAV MYAAV2_START YAW (0) NULL NULL
	SET_MOVEMENT_PATH MYAAV1 MYAAV1 
	#SET_MOVEMENT_PATH MYAAV2 MYAAV2 
	CHANGE_VBL DONE_SETUP SET 2
)

IF ( AND (( VBL_TEST CITADEL1 EQUAL 0)(CITADEL_OWNED 0 2)) ) THEN
(

	CREATE_UNIT IAAV1 4 AAV IAAV_START1 YAW (0) NULL NULL
	CREATE_UNIT IAAV2 4 AAV IAAV_START2 YAW (0) NULL NULL
	SET_MOVEMENT_PATH IAAV1 IAAV1 
	SET_MOVEMENT_PATH IAAV2 IAAV2 
	CHANGE_VBL CITADEL1 SET 1 
	
)

IF ( AND (( VBL_TEST CITADEL2 EQUAL 0)(CITADEL_OWNED 0 4)) ) THEN
(
	CREATE_UNIT ITANK1 4 AI_TANK ITANK_START1 YAW (0) NULL NULL
	CREATE_UNIT ITANK2 4 AI_TANK ITANK_START2 YAW (0) NULL NULL
	CREATE_UNIT ITANK3 4 AI_TANK ITANK_START3 YAW (0) NULL NULL
	CREATE_UNIT ITANK4 4 AI_TANK ITANK_START3 YAW (0) NULL NULL
	CREATE_UNIT RAAV1 5 AAV IAAV2_START1 YAW (0) NULL NULL
	CREATE_UNIT RAAV2 5 AAV IAAV2_START1 YAW (0) NULL NULL
	SET_MOVEMENT_PATH ITANK1 DAVE 
	SET_MOVEMENT_PATH ITANK2 DAVE2 
	SET_MOVEMENT_PATH ITANK3 DAVE3
	SET_MOVEMENT_PATH ITANK4 DAVE3
	CHANGE_VBL CITADEL2 SET 1 
)

IF ( AND ((VBL_TEST VISTA EQUAL 0)(CLOSE_PT HTANK 0 VISTA 15 )) ) THEN
( 
#	CREATE_UNIT IAAV3 4 AAV BOWL1 YAW (0) NULL NULL
	CHANGE_VBL ACTION_TIME SET GAME_TIME
	CHANGE_VBL ACTION_TIME ADD 1
	CHANGE_VBL VISTA SET 1
)

IF ( AND (( VBL_TEST VISTA EQUAL 1)(VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME)) ) THEN
(
	CREATE_UNIT IAAV4 4 AAV BOWL2 YAW (0) NULL NULL
	CHANGE_VBL ACTION_TIME SET GAME_TIME
	CHANGE_VBL ACTION_TIME ADD 1
	CHANGE_VBL VISTA SET 2
)

IF ( AND ((CITADEL_OWNED 0 1)(VBL_TEST BILLBOARD1 EQUAL 0)) ) THEN
(
	SHOW_BILLBOARD {GATE LOCKING MECHANISM IS DEACTIVATED} 7
	CHANGE_VBL BILLBOARD1 SET 1
)

IF (AND ((CITADEL_OWNED 0 1)(CLOSE_PT HTANK 0 GATE1 10 )) ) THEN
(
	IF (VBL_TEST GATEDOWN1 EQUAL 0) THEN	
	(	
		SET_GATE GATE01 0
		CHANGE_VBL GATEDOWN1 SET 1
	)	
)
IF (AND ((VBL_TEST HTURRET EQUAL 0)(CLOSE_PT HTANK 0 HTURRET 6 )) ) THEN
(	
	CREATE_UNIT T1 4 AI_TANK TUR1 YAW (0) NULL NULL
	CREATE_UNIT T2 4 AI_TANK TUR2 YAW (0) NULL NULL
	CREATE_UNIT T3 4 AI_TANK TUR2 YAW (0) NULL NULL
	CHANGE_VBL HTURRET SET 1		
)


IF ( AND ((CITADEL_OWNED 0 0)(VBL_TEST BILLBOARD1 EQUAL 1)) ) THEN
(
	SHOW_BILLBOARD {GATE LOCKING MECHANISM IS DEACTIVATED} 7
	CHANGE_VBL BILLBOARD1 SET 2
)

IF (AND ((CITADEL_OWNED 0 0)(CLOSE_PT HTANK 0 GATE2 24)) ) THEN
(
	IF (VBL_TEST GATEDOWN2 EQUAL 0) THEN
	(
		SET_GATE GATE02 0
		CHANGE_VBL GATEDOWN2 SET 1
	)
)

IF ( AND ((VBL_TEST COUNTER EQUAL 0)(CLOSE_PT HTANK 0 FINAL_CLOSEPT 3 )) ) THEN
( 
	SHOW_BILLBOARD {HELP IS ON THE WAY\nALLIED BOMBER STRIKE COMMENCING\nDESTROY ANTI-AIRCRAFT DEFENSES}7
	CHANGE_VBL ACTION_TIME SET GAME_TIME
	CHANGE_VBL ACTION_TIME ADD 20
	CHANGE_VBL COUNTER SET 1
)

IF (AND ((VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME)(VBL_TEST COUNTER EQUAL 1)) ) THEN
(
	SHOW_BILLBOARD {ALLIED BOMBER STRIKE APPROACHING\n30 TICKS AND COUNTING...} 6
	CHANGE_VBL ACTION_TIME SET GAME_TIME
	CHANGE_VBL ACTION_TIME ADD 15
	CHANGE_VBL COUNTER SET 2
)

		
 IF (AND ((VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME)(VBL_TEST COUNTER EQUAL 2)) ) THEN
(
	IF (VBL_TEST BOMBER EQUAL 0)  THEN
	(
		SHOW_BILLBOARD {ALLIED BOMBER STRIKE IMPENDING \n15 TICKS AND COUNTING...} 6
		CHANGE_VBL ACTION_TIME SET GAME_TIME
		CHANGE_VBL ACTION_TIME ADD 10
		CREATE_UNIT BOMBER1 0 BOMBER BOMBER1 YAW (0) NULL NULL
		CREATE_UNIT BOMBER2 0 BOMBER BOMBER2 YAW (0) NULL NULL
		CREATE_UNIT BOMBER3 0 BOMBER BOMBER3 YAW (0) NULL NULL
		CREATE_UNIT BOMBER4 0 BOMBER BOMBER4 YAW (0) NULL NULL
		CREATE_UNIT BOMBER5 0 BOMBER BOMBER5 YAW (0) NULL NULL
		CREATE_UNIT BOMBER6 0 BOMBER BOMBER6 YAW (0) NULL NULL
		CREATE_UNIT BOMBER7 0 BOMBER BOMBER7 YAW (0) NULL NULL
		CREATE_UNIT BOMBER8 0 BOMBER BOMBER8 YAW (0) NULL NULL
		CREATE_UNIT BOMBER9 0 BOMBER BOMBER9 YAW (0) NULL NULL
		SET_MOVEMENT_PATH BOMBER1 BOMBER1 
		SET_MOVEMENT_PATH BOMBER2 BOMBER2 
		SET_MOVEMENT_PATH BOMBER3 BOMBER3 
		SET_MOVEMENT_PATH BOMBER4 BOMBER4 
		SET_MOVEMENT_PATH BOMBER5 BOMBER5 
		SET_MOVEMENT_PATH BOMBER6 BOMBER6
		SET_MOVEMENT_PATH BOMBER7 BOMBER7 
		SET_MOVEMENT_PATH BOMBER8 BOMBER8 
		SET_MOVEMENT_PATH BOMBER9 BOMBER9  
		CHANGE_VBL COUNTER SET 3
		CHANGE_VBL BOMBER SET 1
	)
)

IF (VBL_TEST POWERUP1 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_C 0 LOC( 236, 92, 0) PU_BOMBERS 1
	CHANGE_VBL POWERUP1 SET 1
)

IF (VBL_TEST POWERUP2 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_D 0 LOC( 191, 92, 0 ) PU_SPECIAL_WEAPON_BOOST 1
	CHANGE_VBL POWERUP2 SET 1
)

IF ( VBL_TEST PU_A EQUAL 0 ) THEN
(
	CREATE_FIXED_PU PU_A 0 LOC(244, 29, 1000)PU_HEALTH 100
	CHANGE_VBL PU_A SET 1
)

IF ( VBL_TEST PU_A EQUAL 1 ) THEN
(

	IF ( NOT ( IS_ALIVE PU_A ) ) THEN
	(
		CHANGE_VBL PU_A_TIME SET GAME_TIME
		CHANGE_VBL PU_A_TIME ADD 40
		CHANGE_VBL PU_A SET 2
	)
)

IF ( VBL_TEST PU_A EQUAL 2 ) THEN
(

	IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL PU_A_TIME ) THEN
	(
		CHANGE_VBL PU_A SET 0
	)
)

IF ( VBL_TEST PU_B EQUAL 0 ) THEN
(
	CREATE_FIXED_PU PU_B 0 LOC(180, 33, 1000) PU_SPECIAL_WEAPON_BOOST 1
	CHANGE_VBL PU_B SET 1
)


IF ( VBL_TEST PU_B EQUAL 1 ) THEN
(

	IF ( NOT ( IS_ALIVE PU_B ) ) THEN
	(
		CHANGE_VBL PU_B_TIME SET GAME_TIME
		CHANGE_VBL PU_B_TIME ADD 40
		CHANGE_VBL PU_B SET 2
	)
)

IF ( VBL_TEST PU_B EQUAL 2 ) THEN
(

	IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL PU_B_TIME ) THEN
	(
		CHANGE_VBL PU_B SET 0
	)
)

				
	IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
	(
		CHANGE_VBL MISSION_FAILED SET 1
	)
	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( CITADEL_OWNED_W_STRG_TOWER 0 3 ) THEN
		(
			END_MISSION PLAYER_SLOT 1 10 {MISSION ACCOMPLISHED}
			CHANGE_VBL MISSION_FAILED SET 1
		)
	)


	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
		(

			IF ( NOT ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT 0 ) ) THEN
			(
				END_MISSION PLAYER_SLOT 0 10 {MISSION FAILED}
			)
		)
	)




END_SCRIPT_FILE
