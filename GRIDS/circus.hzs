		GET_LOCATION DDD DDD_LOC
	)




	IF ( VBL_TEST DDD_PU EQUAL 0 ) THEN
	(

		IF ( DIED_VIOLENT DDD ) THEN
		(

			IF ( VBL_TEST DDD_STRENGTH EQUAL 0 ) THEN
			(
				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST DDD_STRENGTH EQUAL 1 ) THEN
			(
				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST DDD_STRENGTH EQUAL 2 ) THEN
			(
				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
				CREATE_FIXED_PU NULL 0 DDD_LOC PU_RANDOM 1
			)


			IF ( VBL_TEST DDD_STRENGTH EQUAL 3 ) THEN
			(
