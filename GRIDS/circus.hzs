				(

					IF ( VBL_TEST AITANK_GNRTR_COUNT LESS_THAN 7 ) THEN
					(
						CHANGE_VBL LIGHT_TURRET SET 1
						CHANGE_VBL SAMS         SET 1
						CHANGE_VBL HEAVY_TURRET SET 1
						CHANGE_VBL INFANTRY     SET 1
						CHANGE_VBL TANK         SET 0
						CHANGE_VBL AAV          SET 1
					)
					ELSE
					(

						IF ( VBL_TEST AAV_GNRTR_COUNT LESS_THAN 3 ) THEN
						(
							CHANGE_VBL LIGHT_TURRET SET 1
							CHANGE_VBL SAMS         SET 1
							CHANGE_VBL HEAVY_TURRET SET 1
							CHANGE_VBL INFANTRY     SET 1
							CHANGE_VBL TANK         SET 1
							CHANGE_VBL AAV          SET 0
						)
						ELSE
						(
							SHOW_BILLBOARD {FUCKING DONE!!!}
						)
					)
				)
			)
		)
	)
