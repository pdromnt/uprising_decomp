# Embed unmodified AMD MIT sources; no runtime shader-file dependency.
function(uprising_embed_shader path symbol)
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${path}" shader)
    string(LENGTH "${shader}" size)
    set(chunks "")
    set(offset 0)
    while(offset LESS size)
        string(SUBSTRING "${shader}" ${offset} 12000 chunk)
        string(REPLACE "\\" "\\\\" chunk "${chunk}")
        string(REPLACE "\"" "\\\"" chunk "${chunk}")
        string(REPLACE "\r" "" chunk "${chunk}")
        string(REPLACE "\n" "\\n" chunk "${chunk}")
        string(APPEND chunks "\"${chunk}\",\n")
        math(EXPR offset "${offset} + 12000")
    endwhile()
    set(${symbol} "${chunks}" PARENT_SCOPE)
endfunction()
uprising_embed_shader(third_party/fsr/ffx_a.h FSR_PORTABILITY)
uprising_embed_shader(third_party/fsr/ffx_fsr1.h FSR_ALGORITHM)
configure_file(cmake/fsr_sources.h.in generated/fsr_sources.h @ONLY)
