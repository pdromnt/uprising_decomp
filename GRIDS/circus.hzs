START_SCRIPT_FILE


##########Integer Variables##########

VDECL VINT SETUP          0
VDECL VINT CREATE1        0
VDECL VINT CREATE2        0
VDECL VINT CREATE_CONVOY  0

VDECL VINT ACTION_TIME         0
VDECL VINT SET_CONVOY_TIME     0
VDECL VINT CREATE_CONVOY_TIME  0

VDECL VINT FORTIFICATION    0
VDECL VINT CONVOY_STRENGTH  0
VDECL VINT WHICH_PAD        0
VDECL VINT FORT_CHANGE      0
VDECL VINT BUILD            0
VDECL VINT WHICH_BUILD      0

#Represnt the value of the cargo as well as the strength of the escort force
VDECL VINT AAA_STRENGTH  0
VDECL VINT BBB_STRENGTH  0
VDECL VINT CCC_STRENGTH  0
VDECL VINT DDD_STRENGTH  0
VDECL VINT EEE_STRENGTH  0
VDECL VINT FFF_STRENGTH  0

#Switches for creating the power-ups left behind at the site of a destroyed convoy
VDECL VINT AAA_PU  0
VDECL VINT BBB_PU  0
VDECL VINT CCC_PU  0
VDECL VINT DDD_PU  0
VDECL VINT EEE_PU  0
VDECL VINT FFF_PU  0

#Switching the gates on or off once (not consistantly) depending upon game state
VDECL VINT ALL_GATE_SWITCH    0
VDECL VINT NORTH_GATE_SWITCH  0
VDECL VINT EAST_GATE_SWITCH   0
VDECL VINT SOUTH_GATE_SWITCH  0
VDECL VINT WEST_GATE_SWITCH   0

#Switches and delays for removing the tanks after a given time if their convoy unit was destroyed
VDECL VINT AAA_ESCORT       0
VDECL VINT AAA_ESCORT_TIME  0
VDECL VINT BBB_ESCORT       0
VDECL VINT BBB_ESCORT_TIME  0
VDECL VINT CCC_ESCORT       0
VDECL VINT CCC_ESCORT_TIME  0
VDECL VINT DDD_ESCORT       0
VDECL VINT DDD_ESCORT_TIME  0
VDECL VINT EEE_ESCORT       0
VDECL VINT EEE_ESCORT_TIME  0
VDECL VINT FFF_ESCORT       0
VDECL VINT FFF_ESCORT_TIME  0

#Counts for rabble objects
VDECL VINT AITANK_GNRTR_COUNT  0
VDECL VINT SLDR_GNRTR_COUNT    0
VDECL VINT AAV_GNRTR_COUNT     0
VDECL VINT LIGHT_TURRET_COUNT  0
VDECL VINT HEAVY_TURRET_COUNT  0
VDECL VINT SAMS_COUNT          0

#Values for rabble objects, used to calculate fortification
VDECL VINT AITANK_GNRTR_VALUE  0
VDECL VINT SLDR_GNRTR_VALUE    0
VDECL VINT AAV_GNRTR_VALUE     0
VDECL VINT LIGHT_TURRET_VALUE  0
VDECL VINT HEAVY_TURRET_VALUE  0
VDECL VINT SAMS_VALUE          0

#Switches for what type of object to build
VDECL VINT LIGHT_TURRET  0
VDECL VINT HEAVY_TURRET  0
VDECL VINT SAMS          0
VDECL VINT INFANTRY      0
VDECL VINT TANK          0
VDECL VINT AAV           0

#For loop variables
VDECL VINT A  0
VDECL VINT B  0
VDECL VINT C  0
VDECL VINT D  0



##########Location Variables##########

VDECL VLOC CONVOY_PAD LOC ( 1, 1, 1 )
VDECL VLOC TANK1_PAD  LOC ( 1, 1, 1 )
VDECL VLOC TANK2_PAD  LOC ( 1, 1, 1 )

#Locations of cargo ship landing pads.  In order: 0-NW, 1-W, 2-SW, 3-SE, 4-E, 5-NE
VDECL VLOC PAD0_0 LOC ( 176, 232, 0 )
VDECL VLOC PAD0_1 LOC ( 172, 224, 0 )
VDECL VLOC PAD0_2 LOC ( 180, 224, 0 )
VDECL VLOC PAD1_0 LOC ( 236, 132, 0 )
VDECL VLOC PAD1_1 LOC ( 230, 132, 0 )
VDECL VLOC PAD1_2 LOC ( 242, 132, 0 )
VDECL VLOC PAD2_0 LOC ( 176,  28, 0 )
VDECL VLOC PAD2_1 LOC ( 180,  36, 0 )
VDECL VLOC PAD2_2 LOC ( 172,  36, 0 )
VDECL VLOC PAD3_0 LOC (  80,  28, 0 )
VDECL VLOC PAD3_1 LOC (  84,  36, 0 )
VDECL VLOC PAD3_2 LOC (  76,  36, 0 )
VDECL VLOC PAD4_0 LOC (  20, 132, 0 )
VDECL VLOC PAD4_1 LOC (  14, 132, 0 )
VDECL VLOC PAD4_2 LOC (  26, 132, 0 )
VDECL VLOC PAD5_0 LOC (  80, 232, 0 )
VDECL VLOC PAD5_1 LOC (  76, 224, 0 )
VDECL VLOC PAD5_2 LOC (  84, 224, 0 )

#Locations of convoy units
VDECL VLOC AAA_LOC  LOC  ( 1, 1, 1 )
VDECL VLOC BBB_LOC  LOC  ( 1, 1, 1 )
VDECL VLOC CCC_LOC  LOC  ( 1, 1, 1 )
VDECL VLOC DDD_LOC  LOC  ( 1, 1, 1 )
VDECL VLOC EEE_LOC  LOC  ( 1, 1, 1 )
VDECL VLOC FFF_LOC  LOC  ( 1, 1, 1 )

#Locations of the four gates and the teleport pad
VDECL VLOC NORTH_GATE LOC ( 128, 151, 0 )
VDECL VLOC EAST_GATE  LOC ( 149, 136, 0 )
VDECL VLOC SOUTH_GATE LOC ( 128, 117, 0 )
VDECL VLOC WEST_GATE  LOC ( 107, 136, 0 )
VDECL VLOC END        LOC ( 128, 128, 0 )


##########Setup Stuff##########

	IF ( VBL_TEST SETUP EQUAL 0 ) THEN
	(
		SET_USE_DEFAULT_VICTORY 0
		CHANGE_VBL ACTION_TIME SET GAME_TIME
		CHANGE_VBL ACTION_TIME ADD 1
		CHANGE_VBL SET_CONVOY_TIME SET GAME_TIME
		CHANGE_VBL SET_CONVOY_TIME ADD 5
		CHANGE_VBL CREATE_CONVOY_TIME SET SET_CONVOY_TIME
		CHANGE_VBL CREATE_CONVOY_TIME ADD 1
		CHANGE_VBL SETUP SET 1
	)


	#Inital AAV and Bomber attck on Imperium Citadel
	IF ( AND  (( VBL_TEST SETUP EQUAL 1 ) ( VBL_TEST CREATE1 EQUAL 0 )) ) THEN
	(

		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
		(
			CREATE_UNIT AAV1 0 AAV LOC ( 132, 2, 0 ) YAW (0) NULL NULL
			CREATE_UNIT AAV2 0 AAV LOC ( 132, 2, 0 ) YAW (0) NULL NULL
			CREATE_UNIT AAV3 0 AAV LOC ( 132, 2, 0 ) YAW (0) NULL NULL
			SET_MOVEMENT_PATH AAV1 AAV1
			SET_MOVEMENT_PATH AAV2 AAV2
			SET_MOVEMENT_PATH AAV3 AAV3
			CHANGE_VBL ACTION_TIME SET GAME_TIME
			CHANGE_VBL ACTION_TIME ADD 1
			CHANGE_VBL CREATE1 SET 1
		)
	)



	IF ( AND (( VBL_TEST CREATE1 EQUAL 1 ) ( VBL_TEST CREATE2 EQUAL 0 )) ) THEN
	(

		IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL ACTION_TIME ) THEN
		(
			CREATE_UNIT AAV4 0 AAV LOC ( 140, 2, 0 ) YAW (115) NULL NULL
			CREATE_UNIT AAV5 0 AAV LOC ( 140, 2, 0 ) YAW (115) NULL NULL
			CREATE_UNIT AAV6 0 AAV LOC ( 140, 2, 0 ) YAW (115) NULL NULL
			SET_MOVEMENT_PATH AAV4 AAV4
			SET_MOVEMENT_PATH AAV5 AAV5
			SET_MOVEMENT_PATH AAV6 AAV6
			CHANGE_VBL CREATE2 SET 1
		)
	)


	#Setting locations for and strengths for the next created convoy/escort
	IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL SET_CONVOY_TIME ) THEN
	(
		CHANGE_VBL CONVOY_STRENGTH SET RANDOM_INT 6
		CHANGE_VBL WHICH_PAD SET RANDOM_INT 6


		#Setting variable CHOSEN_PAD
		IF ( VBL_TEST WHICH_PAD EQUAL 0 ) THEN
		(
			CHANGE_LOC_VBL CONVOY_PAD SET PAD0_0
			CHANGE_LOC_VBL TANK1_PAD  SET PAD0_1
			CHANGE_LOC_VBL TANK2_PAD  SET PAD0_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 1 ) THEN
		(
			CHANGE_LOC_VBL CONVOY_PAD SET PAD1_0
			CHANGE_LOC_VBL TANK1_PAD  SET PAD1_1
			CHANGE_LOC_VBL TANK2_PAD  SET PAD1_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 2 ) THEN
		(
			CHANGE_LOC_VBL CONVOY_PAD SET PAD2_0
			CHANGE_LOC_VBL TANK1_PAD  SET PAD2_1
			CHANGE_LOC_VBL TANK2_PAD  SET PAD2_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 3 ) THEN
		(
			CHANGE_LOC_VBL CONVOY_PAD SET PAD3_0
			CHANGE_LOC_VBL TANK1_PAD  SET PAD3_1
			CHANGE_LOC_VBL TANK2_PAD  SET PAD3_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 4 ) THEN
		(
			CHANGE_LOC_VBL CONVOY_PAD SET PAD4_0
			CHANGE_LOC_VBL TANK1_PAD  SET PAD4_1
			CHANGE_LOC_VBL TANK2_PAD  SET PAD4_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 5 ) THEN
		(
			CHANGE_LOC_VBL CONVOY_PAD SET PAD5_0
			CHANGE_LOC_VBL TANK1_PAD  SET PAD5_1
			CHANGE_LOC_VBL TANK2_PAD  SET PAD5_2
		)


		CHANGE_VBL SET_CONVOY_TIME SET GAME_TIME
		CHANGE_VBL SET_CONVOY_TIME ADD 28
		CHANGE_VBL CREATE_CONVOY_TIME SET GAME_TIME
		CHANGE_VBL CREATE_CONVOY_TIME ADD 2
	)


	#Creating convoy AAA and its escorts
	IF ( AND (( VBL_TEST CREATE_CONVOY EQUAL 0 ) ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL CREATE_CONVOY_TIME )) ) THEN
	(
		CREATE_UNIT AAA 4 CONVOY_TRUCK CONVOY_PAD YAW (0) NULL NULL
		CHANGE_VBL AAA_STRENGTH SET CONVOY_STRENGTH


		IF ( OR (( VBL_TEST AAA_STRENGTH EQUAL 2 ) ( VBL_TEST AAA_STRENGTH EQUAL 3 )) ) THEN
		(
			CREATE_UNIT AAATANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {AAA WITH 1}
		)


		IF ( OR (( VBL_TEST AAA_STRENGTH EQUAL 4 ) ( VBL_TEST AAA_STRENGTH EQUAL 5 )) ) THEN
		(
			CREATE_UNIT AAATANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			CREATE_UNIT AAATANK2 4 AI_TANK TANK2_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {AAA WITH 2}
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 0 ) THEN
		(
			SET_MOVEMENT_PATH AAA PATH0_0
			SET_MOVEMENT_PATH AAATANK1 PATH0_1
			SET_MOVEMENT_PATH AAATANK2 PATH0_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 1 ) THEN
		(
			SET_MOVEMENT_PATH AAA PATH1_0
			SET_MOVEMENT_PATH AAATANK1 PATH1_1
			SET_MOVEMENT_PATH AAATANK2 PATH1_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 2 ) THEN
		(
			SET_MOVEMENT_PATH AAA PATH2_0
			SET_MOVEMENT_PATH AAATANK1 PATH2_1
			SET_MOVEMENT_PATH AAATANK2 PATH2_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 3 ) THEN
		(
			SET_MOVEMENT_PATH AAA PATH3_0
			SET_MOVEMENT_PATH AAATANK1 PATH3_1
			SET_MOVEMENT_PATH AAATANK2 PATH3_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 4 ) THEN
		(
			SET_MOVEMENT_PATH AAA PATH4_0
			SET_MOVEMENT_PATH AAATANK1 PATH4_1
			SET_MOVEMENT_PATH AAATANK2 PATH4_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 5 ) THEN
		(
			SET_MOVEMENT_PATH AAA PATH5_0
			SET_MOVEMENT_PATH AAATANK1 PATH5_1
			SET_MOVEMENT_PATH AAATANK2 PATH5_2
		)

		CHANGE_VBL CREATE_CONVOY_TIME SET SET_CONVOY_TIME
		CHANGE_VBL CREATE_CONVOY_TIME ADD 1
		CHANGE_VBL CREATE_CONVOY SET 1
	)


	#Creating convoy BBB and its escorts
	IF ( AND (( VBL_TEST CREATE_CONVOY EQUAL 1 ) ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL CREATE_CONVOY_TIME )) ) THEN
	(
		CREATE_UNIT BBB 4 CONVOY_TRUCK CONVOY_PAD YAW (0) NULL NULL
		CHANGE_VBL BBB_STRENGTH SET CONVOY_STRENGTH


		IF ( OR (( VBL_TEST BBB_STRENGTH EQUAL 2 ) ( VBL_TEST BBB_STRENGTH EQUAL 3 )) ) THEN
		(
			CREATE_UNIT BBBTANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {BBB WITH 1}
		)


		IF ( OR (( VBL_TEST BBB_STRENGTH EQUAL 4 ) ( VBL_TEST BBB_STRENGTH EQUAL 5 )) ) THEN
		(
			CREATE_UNIT BBBTANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			CREATE_UNIT BBBTANK2 4 AI_TANK TANK2_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {BBB WITH 2}
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 0 ) THEN
		(
			SET_MOVEMENT_PATH BBB PATH0_0
			SET_MOVEMENT_PATH BBBTANK1 PATH0_1
			SET_MOVEMENT_PATH BBBTANK2 PATH0_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 1 ) THEN
		(
			SET_MOVEMENT_PATH BBB PATH1_0
			SET_MOVEMENT_PATH BBBTANK1 PATH1_1
			SET_MOVEMENT_PATH BBBTANK2 PATH1_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 2 ) THEN
		(
			SET_MOVEMENT_PATH BBB PATH2_0
			SET_MOVEMENT_PATH BBBTANK1 PATH2_1
			SET_MOVEMENT_PATH BBBTANK2 PATH2_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 3 ) THEN
		(
			SET_MOVEMENT_PATH BBB PATH3_0
			SET_MOVEMENT_PATH BBBTANK1 PATH3_1
			SET_MOVEMENT_PATH BBBTANK2 PATH3_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 4 ) THEN
		(
			SET_MOVEMENT_PATH BBB PATH4_0
			SET_MOVEMENT_PATH BBBTANK1 PATH4_1
			SET_MOVEMENT_PATH BBBTANK2 PATH4_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 5 ) THEN
		(
			SET_MOVEMENT_PATH BBB PATH5_0
			SET_MOVEMENT_PATH BBBTANK1 PATH5_1
			SET_MOVEMENT_PATH BBBTANK2 PATH5_2
		)

		CHANGE_VBL CREATE_CONVOY_TIME SET SET_CONVOY_TIME
		CHANGE_VBL CREATE_CONVOY_TIME ADD 1
		CHANGE_VBL CREATE_CONVOY SET 2
	)


	#Creating convoy CCC and its escorts
	IF ( AND (( VBL_TEST CREATE_CONVOY EQUAL 2 ) ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL CREATE_CONVOY_TIME )) ) THEN
	(
		CREATE_UNIT CCC 4 CONVOY_TRUCK CONVOY_PAD YAW (0) NULL NULL
		CHANGE_VBL CCC_STRENGTH SET CONVOY_STRENGTH


		IF ( OR (( VBL_TEST CCC_STRENGTH EQUAL 2 ) ( VBL_TEST CCC_STRENGTH EQUAL 3 )) ) THEN
		(
			CREATE_UNIT CCCTANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {CCC WITH 1}
		)


		IF ( OR (( VBL_TEST CCC_STRENGTH EQUAL 4 ) ( VBL_TEST CCC_STRENGTH EQUAL 5 )) ) THEN
		(
			CREATE_UNIT CCCTANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			CREATE_UNIT CCCTANK2 4 AI_TANK TANK2_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {CCC WITH 2}
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 0 ) THEN
		(
			SET_MOVEMENT_PATH CCC PATH0_0
			SET_MOVEMENT_PATH CCCTANK1 PATH0_1
			SET_MOVEMENT_PATH CCCTANK2 PATH0_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 1 ) THEN
		(
			SET_MOVEMENT_PATH CCC PATH1_0
			SET_MOVEMENT_PATH CCCTANK1 PATH1_1
			SET_MOVEMENT_PATH CCCTANK2 PATH1_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 2 ) THEN
		(
			SET_MOVEMENT_PATH CCC PATH2_0
			SET_MOVEMENT_PATH CCCTANK1 PATH2_1
			SET_MOVEMENT_PATH CCCTANK2 PATH2_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 3 ) THEN
		(
			SET_MOVEMENT_PATH CCC PATH3_0
			SET_MOVEMENT_PATH CCCTANK1 PATH3_1
			SET_MOVEMENT_PATH CCCTANK2 PATH3_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 4 ) THEN
		(
			SET_MOVEMENT_PATH CCC PATH4_0
			SET_MOVEMENT_PATH CCCTANK1 PATH4_1
			SET_MOVEMENT_PATH CCCTANK2 PATH4_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 5 ) THEN
		(
			SET_MOVEMENT_PATH CCC PATH5_0
			SET_MOVEMENT_PATH CCCTANK1 PATH5_1
			SET_MOVEMENT_PATH CCCTANK2 PATH5_2
		)

		CHANGE_VBL CREATE_CONVOY_TIME SET SET_CONVOY_TIME
		CHANGE_VBL CREATE_CONVOY_TIME ADD 1
		CHANGE_VBL CREATE_CONVOY SET 3
	)


	#Creating convoy DDD and its escorts
	IF ( AND (( VBL_TEST CREATE_CONVOY EQUAL 3 ) ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL CREATE_CONVOY_TIME )) ) THEN
	(
		CREATE_UNIT DDD 4 CONVOY_TRUCK CONVOY_PAD YAW (0) NULL NULL
		CHANGE_VBL DDD_STRENGTH SET CONVOY_STRENGTH


		IF ( OR (( VBL_TEST DDD_STRENGTH EQUAL 2 ) ( VBL_TEST DDD_STRENGTH EQUAL 3 )) ) THEN
		(
			CREATE_UNIT DDDTANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {DDD WITH 1}
		)


		IF ( OR (( VBL_TEST DDD_STRENGTH EQUAL 4 ) ( VBL_TEST DDD_STRENGTH EQUAL 5 )) ) THEN
		(
			CREATE_UNIT DDDTANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			CREATE_UNIT DDDTANK2 4 AI_TANK TANK2_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {DDD WITH 2}
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 0 ) THEN
		(
			SET_MOVEMENT_PATH DDD PATH0_0
			SET_MOVEMENT_PATH DDDTANK1 PATH0_1
			SET_MOVEMENT_PATH DDDTANK2 PATH0_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 1 ) THEN
		(
			SET_MOVEMENT_PATH DDD PATH1_0
			SET_MOVEMENT_PATH DDDTANK1 PATH1_1
			SET_MOVEMENT_PATH DDDTANK2 PATH1_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 2 ) THEN
		(
			SET_MOVEMENT_PATH DDD PATH2_0
			SET_MOVEMENT_PATH DDDTANK1 PATH2_1
			SET_MOVEMENT_PATH DDDTANK2 PATH2_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 3 ) THEN
		(
			SET_MOVEMENT_PATH DDD PATH3_0
			SET_MOVEMENT_PATH DDDTANK1 PATH3_1
			SET_MOVEMENT_PATH DDDTANK2 PATH3_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 4 ) THEN
		(
			SET_MOVEMENT_PATH DDD PATH4_0
			SET_MOVEMENT_PATH DDDTANK1 PATH4_1
			SET_MOVEMENT_PATH DDDTANK2 PATH4_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 5 ) THEN
		(
			SET_MOVEMENT_PATH DDD PATH5_0
			SET_MOVEMENT_PATH DDDTANK1 PATH5_1
			SET_MOVEMENT_PATH DDDTANK2 PATH5_2
		)

		CHANGE_VBL CREATE_CONVOY_TIME SET SET_CONVOY_TIME
		CHANGE_VBL CREATE_CONVOY_TIME ADD 1
		CHANGE_VBL CREATE_CONVOY SET 4
	)


	#Creating convoy EEE and its escorts
	IF ( AND (( VBL_TEST CREATE_CONVOY EQUAL 4 ) ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL CREATE_CONVOY_TIME )) ) THEN
	(
		CREATE_UNIT EEE 4 CONVOY_TRUCK CONVOY_PAD YAW (0) NULL NULL
		CHANGE_VBL EEE_STRENGTH SET CONVOY_STRENGTH


		IF ( OR (( VBL_TEST EEE_STRENGTH EQUAL 2 ) ( VBL_TEST EEE_STRENGTH EQUAL 3 )) ) THEN
		(
			CREATE_UNIT EEETANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {EEE WITH 1}
		)


		IF ( OR (( VBL_TEST EEE_STRENGTH EQUAL 4 ) ( VBL_TEST EEE_STRENGTH EQUAL 5 )) ) THEN
		(
			CREATE_UNIT EEETANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			CREATE_UNIT EEETANK2 4 AI_TANK TANK2_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {EEE WITH 2}
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 0 ) THEN
		(
			SET_MOVEMENT_PATH EEE PATH0_0
			SET_MOVEMENT_PATH EEETANK1 PATH0_1
			SET_MOVEMENT_PATH EEETANK2 PATH0_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 1 ) THEN
		(
			SET_MOVEMENT_PATH EEE PATH1_0
			SET_MOVEMENT_PATH EEETANK1 PATH1_1
			SET_MOVEMENT_PATH EEETANK2 PATH1_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 2 ) THEN
		(
			SET_MOVEMENT_PATH EEE PATH2_0
			SET_MOVEMENT_PATH EEETANK1 PATH2_1
			SET_MOVEMENT_PATH EEETANK2 PATH2_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 3 ) THEN
		(
			SET_MOVEMENT_PATH EEE PATH3_0
			SET_MOVEMENT_PATH EEETANK1 PATH3_1
			SET_MOVEMENT_PATH EEETANK2 PATH3_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 4 ) THEN
		(
			SET_MOVEMENT_PATH EEE PATH4_0
			SET_MOVEMENT_PATH EEETANK1 PATH4_1
			SET_MOVEMENT_PATH EEETANK2 PATH4_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 5 ) THEN
		(
			SET_MOVEMENT_PATH EEE PATH5_0
			SET_MOVEMENT_PATH EEETANK1 PATH5_1
			SET_MOVEMENT_PATH EEETANK2 PATH5_2
		)

		CHANGE_VBL CREATE_CONVOY_TIME SET SET_CONVOY_TIME
		CHANGE_VBL CREATE_CONVOY_TIME ADD 1
		CHANGE_VBL CREATE_CONVOY SET 5
	)


	#Creating convoy FFF and its escorts
	IF ( AND (( VBL_TEST CREATE_CONVOY EQUAL 5 ) ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL CREATE_CONVOY_TIME )) ) THEN
	(
		CREATE_UNIT FFF 4 CONVOY_TRUCK CONVOY_PAD YAW (0) NULL NULL
		CHANGE_VBL FFF_STRENGTH SET CONVOY_STRENGTH


		IF ( OR (( VBL_TEST FFF_STRENGTH EQUAL 2 ) ( VBL_TEST FFF_STRENGTH EQUAL 3 )) ) THEN
		(
			CREATE_UNIT FFFTANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {FFF WITH 1}
		)


		IF ( OR (( VBL_TEST FFF_STRENGTH EQUAL 4 ) ( VBL_TEST FFF_STRENGTH EQUAL 5 )) ) THEN
		(
			CREATE_UNIT FFFTANK1 4 AI_TANK TANK1_PAD YAW (0) NULL NULL
			CREATE_UNIT FFFTANK2 4 AI_TANK TANK2_PAD YAW (0) NULL NULL
			SHOW_BILLBOARD {FFF WITH 2}
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 0 ) THEN
		(
			SET_MOVEMENT_PATH FFF PATH0_0
			SET_MOVEMENT_PATH FFFTANK1 PATH0_1
			SET_MOVEMENT_PATH FFFTANK2 PATH0_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 1 ) THEN
		(
			SET_MOVEMENT_PATH FFF PATH1_0
			SET_MOVEMENT_PATH FFFTANK1 PATH1_1
			SET_MOVEMENT_PATH FFFTANK2 PATH1_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 2 ) THEN
		(
			SET_MOVEMENT_PATH FFF PATH2_0
			SET_MOVEMENT_PATH FFFTANK1 PATH2_1
			SET_MOVEMENT_PATH FFFTANK2 PATH2_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 3 ) THEN
		(
			SET_MOVEMENT_PATH FFF PATH3_0
			SET_MOVEMENT_PATH FFFTANK1 PATH3_1
			SET_MOVEMENT_PATH FFFTANK2 PATH3_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 4 ) THEN
		(
			SET_MOVEMENT_PATH FFF PATH4_0
			SET_MOVEMENT_PATH FFFTANK1 PATH4_1
			SET_MOVEMENT_PATH FFFTANK2 PATH4_2
		)


		IF ( VBL_TEST WHICH_PAD EQUAL 5 ) THEN
		(
			SET_MOVEMENT_PATH FFF PATH5_0
			SET_MOVEMENT_PATH FFFTANK1 PATH5_1
			SET_MOVEMENT_PATH FFFTANK2 PATH5_2
		)

		CHANGE_VBL CREATE_CONVOY_TIME SET SET_CONVOY_TIME
		CHANGE_VBL CREATE_CONVOY_TIME ADD 1
		CHANGE_VBL CREATE_CONVOY SET 0
	)


	#This keeps the fortification level within 0%-100%.  Divide the number by 2 for the percentage that the base is fortified.



	#Switches for gates being up or down
	IF ( VBL_TEST FORTIFICATION GREATER_THAN_EQUAL 160 ) THEN
	(

		IF ( VBL_TEST ALL_GATE_SWITCH EQUAL 0 ) THEN
		(
			SET_GATE GATE_NORTH 0
			SET_GATE GATE_EAST 0
			SET_GATE GATE_SOUTH 0
			SET_GATE GATE_WEST 0
			IMP_GRAB_CITADEL 0
			SHOW_BILLBOARD {IMP GRABBED CITADEL \nALL GATES DROPPED}
			CHANGE_VBL ALL_GATE_SWITCH SET 1
		)
	)
	ELSE
	(
		CHANGE_VBL ALL_GATE_SWITCH SET 0

		#Droping or raising the North Gate
		IF ( OR (( OR (( CLOSE_PT AAA NORTH_GATE 5 ) ( CLOSE_PT BBB NORTH_GATE 5 )) ) ( OR (( CLOSE_PT CCC NORTH_GATE 5 ) ( CLOSE_PT DDD NORTH_GATE 5 )) )) ) THEN
		(

			IF ( VBL_TEST NORTH_GATE_SWITCH EQUAL 0 ) THEN
			(
				SET_GATE GATE_NORTH 0
				CHANGE_VBL NORTH_GATE_SWITCH SET 1
			)
		)
		ELSE
		(

			IF ( OR (( CLOSE_PT EEE NORTH_GATE 5 ) ( CLOSE_PT FFF NORTH_GATE 5 )) ) THEN
			(

				IF ( VBL_TEST NORTH_GATE_SWITCH EQUAL 0 ) THEN
				(
					SET_GATE GATE_NORTH 0
					CHANGE_VBL NORTH_GATE_SWITCH SET 1
				)
			)
			ELSE
			(

				IF ( VBL_TEST NORTH_GATE_SWITCH EQUAL 1 ) THEN
				(
					SET_GATE GATE_NORTH 1
					CHANGE_VBL NORTH_GATE_SWITCH SET 0
				)
			)
		)

		#Droping or raising the East Gate
		IF ( OR (( OR (( CLOSE_PT AAA EAST_GATE 5 ) ( CLOSE_PT BBB EAST_GATE 5 )) ) ( OR (( CLOSE_PT CCC EAST_GATE 5 ) ( CLOSE_PT DDD EAST_GATE 5 )) )) ) THEN
		(

			IF ( VBL_TEST EAST_GATE_SWITCH EQUAL 0 ) THEN
			(
				SET_GATE GATE_EAST 0
				CHANGE_VBL EAST_GATE_SWITCH SET 1
			)
		)
		ELSE
		(

			IF ( OR (( CLOSE_PT EEE EAST_GATE 5 ) ( CLOSE_PT FFF EAST_GATE 5 )) ) THEN
			(

				IF ( VBL_TEST EAST_GATE_SWITCH EQUAL 0 ) THEN
				(
					SET_GATE GATE_EAST 0
					CHANGE_VBL EAST_GATE_SWITCH SET 1
				)
			)
			ELSE
			(

				IF ( VBL_TEST EAST_GATE_SWITCH EQUAL 1 ) THEN
				(
					SET_GATE GATE_EAST 1
					CHANGE_VBL EAST_GATE_SWITCH SET 0
				)
			)
		)

		#Droping or raising the South Gate
		IF ( OR (( OR (( CLOSE_PT AAA SOUTH_GATE 5 ) ( CLOSE_PT BBB SOUTH_GATE 5 )) ) ( OR (( CLOSE_PT CCC SOUTH_GATE 5 ) ( CLOSE_PT DDD SOUTH_GATE 5 )) )) ) THEN
		(

			IF ( VBL_TEST SOUTH_GATE_SWITCH EQUAL 0 ) THEN
			(
				SET_GATE GATE_SOUTH 0
				CHANGE_VBL SOUTH_GATE_SWITCH SET 1
			)
		)
		ELSE
		(

			IF ( OR (( CLOSE_PT EEE SOUTH_GATE 5 ) ( CLOSE_PT FFF SOUTH_GATE 5 )) ) THEN
			(

				IF ( VBL_TEST SOUTH_GATE_SWITCH EQUAL 0 ) THEN
				(
					SET_GATE GATE_SOUTH 0
					CHANGE_VBL SOUTH_GATE_SWITCH SET 1
				)

			)
			ELSE
			(

				IF ( VBL_TEST SOUTH_GATE_SWITCH EQUAL 1 ) THEN
				(
					SET_GATE GATE_SOUTH 1
					CHANGE_VBL SOUTH_GATE_SWITCH SET 0
				)
			)
		)

		#Droping or raising the West Gate
		IF ( OR (( OR (( CLOSE_PT AAA WEST_GATE 5 ) ( CLOSE_PT BBB WEST_GATE 5 )) ) ( OR (( CLOSE_PT CCC WEST_GATE 5 ) ( CLOSE_PT DDD WEST_GATE 5 )) )) ) THEN
		(

			IF ( VBL_TEST WEST_GATE_SWITCH EQUAL 0 ) THEN
			(
				SET_GATE GATE_WEST 0
				CHANGE_VBL WEST_GATE_SWITCH SET 1
			)
		)
		ELSE
		(

			IF ( OR (( CLOSE_PT EEE WEST_GATE 5 ) ( CLOSE_PT FFF WEST_GATE 5 )) ) THEN
			(

				IF ( VBL_TEST WEST_GATE_SWITCH EQUAL 0 ) THEN
				(
					SET_GATE GATE_WEST 0
					CHANGE_VBL WEST_GATE_SWITCH SET 1
				)
			)
			ELSE
			(

				IF ( VBL_TEST WEST_GATE_SWITCH EQUAL 1 ) THEN
				(
					SET_GATE GATE_WEST 1
					CHANGE_VBL WEST_GATE_SWITCH SET 0
				)
			)
		)
	)


	#Setting AAA to move to the teleport pad
	IF ( OR (( CLOSE_PT AAA NORTH_GATE 5 ) ( CLOSE_PT AAA WEST_GATE 5 )) ) THEN
	(
		SET_MOVEMENT_PATH AAA END_WEST
		REMOVE_UNIT AAATANK1
		REMOVE_UNIT AAATANK2
	)
	IF ( CLOSE_PT AAA EAST_GATE 5 ) THEN
	(
		SET_MOVEMENT_PATH AAA END_EAST
		REMOVE_UNIT AAATANK1
		REMOVE_UNIT AAATANK2
	)
	IF ( CLOSE_PT AAA SOUTH_GATE 5 ) THEN
	(
		SET_MOVEMENT_PATH AAA END
		REMOVE_UNIT AAATANK1
		REMOVE_UNIT AAATANK2
	)


	#Setting BBB to move to the teleport pad
	IF ( OR (( CLOSE_PT BBB NORTH_GATE 5 ) ( CLOSE_PT BBB WEST_GATE 5 )) ) THEN
	(
		SET_MOVEMENT_PATH BBB END_WEST
		REMOVE_UNIT BBBTANK1
		REMOVE_UNIT BBBTANK2
	)
	IF ( CLOSE_PT BBB EAST_GATE 5 ) THEN
	(
		SET_MOVEMENT_PATH BBB END_EAST
		REMOVE_UNIT BBBTANK1
		REMOVE_UNIT BBBTANK2
	)
	IF ( CLOSE_PT BBB SOUTH_GATE 5 ) THEN
	(
		SET_MOVEMENT_PATH BBB END
		REMOVE_UNIT BBBTANK1
		REMOVE_UNIT BBBTANK2
	)


	#Setting CCC to move to the teleport pad
	IF ( OR (( CLOSE_PT CCC NORTH_GATE 5 ) ( CLOSE_PT CCC WEST_GATE 5 )) ) THEN
	(
		SET_MOVEMENT_PATH CCC END_WEST
		REMOVE_UNIT CCCTANK1
