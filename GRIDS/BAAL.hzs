# CITADEL 04 ###################################################################
##### INITIAL ATTACK ###########################################################
IF ( AND (VBL_TEST GAME_TIME GREATER_THAN FIRST_ASSAULT_TIME04   VBL_TEST FIRST_ASSAULT_OCCURED04 EQUAL 0 )) THEN 
(
	IF (     NOT (   AND (  IS_ALIVE TANK04C   AND ( IS_ALIVE TANK04B  IS_ALIVE TANKO4A )  )   )     )  THEN
	(

		CHANGE_VBL FIRST_ASSAULT_OCCURED04 SET 1
		CHANGE_VBL LAUNCH_ASSAULT_TIME04 SET GAME_TIME
		CHANGE_VBL LAUNCH_ASSAULT_TIME04 ADD LAUNCH_ASSAULT_CONST04

		# GENERATE UNITS AT CITADEL04 TELEPORT IN SITE
		CREATE_UNIT TANK04A 4 AI_TANK LOC ( 58, 71, 0 ) YAW (0)  NULL  NULL  
		SET_MOVEMENT_PATH TANK04A ATTACKPATH04A

		CREATE_UNIT TANK04B 4 AI_TANK LOC ( 61, 74, 0 ) YAW (0)  NULL  NULL  
		SET_MOVEMENT_PATH TANK04B ATTACKPATH04B

		CREATE_UNIT TANK04C 4 AI_TANK LOC ( 61, 68, 0 ) YAW (0)  NULL  NULL  
