END_SECTION


START_SECTION_MP_ONLY

############ MARCH ON MY GIBBLING MASSES OF DESTRUCTION ########################


SET_TPORT_OWNER TPORT00 4

# RESET TELEPORTER
IF ( VBL_TEST END_TPORT_TIME0 LESS_THAN_EQUAL GAME_TIME ) THEN
(
	IF ( VBL_TEST END_TPORT_TIME1 LESS_THAN_EQUAL GAME_TIME ) THEN
	(
		IF ( VBL_TEST END_TPORT_TIME2 LESS_THAN_EQUAL GAME_TIME ) THEN
		(
			SET_TELEPORTER TPORT00 0
		)
	)
)


FOR PLAYER EQUAL 0 TO 4 DO
(

#**CITADEL0*********************************************************************
	
IF (VBL_TEST END_TPORT_TIME0 LESS_THAN_EQUAL GAME_TIME ) THEN
(
	# CHECK TO SEE IF THE LEADER00 HAS REACHED THE TELEPORTER
	IF ( CLOSE_PT  LEADER00 LOC ( 32, 228, 0 ) 3 ) THEN
	(

		# SET TELEPORT RESET TIME
		CHANGE_VBL END_TPORT_TIME0 SET GAME_TIME
		CHANGE_VBL END_TPORT_TIME0 ADD TPORT_TIME_CONST


		# REMOVE UNIT
		KILLER_SAT LEADER00_OWNER LOC ( 32, 228, 0 )
		REMOVE_UNIT LEADER00

		# REMOVE ALL ESCORTS
		REMOVE_UNIT ESCORT_AAV00
		REMOVE_UNIT ESCORT_AAV01
		REMOVE_UNIT ESCORT_TANK00
		REMOVE_UNIT ESCORT_TANK01
			 
		# ADD ONE TO THE TELEPORTED UNITS TOTAL
	
		IF ( VBL_TEST LEADER00_OWNER EQUAL 0 ) THEN
		(
			CHANGE_VBL UNITS_TELEPORTED_TOTAL0 ADD 1
			CHANGE_VBL TIME_TO_SHOW_COUNT0 SET 1
		)
		IF ( VBL_TEST LEADER00_OWNER EQUAL 1 ) THEN
		(
			CHANGE_VBL UNITS_TELEPORTED_TOTAL1 ADD 1
			CHANGE_VBL TIME_TO_SHOW_COUNT1 SET 1
		)
		IF ( VBL_TEST LEADER00_OWNER EQUAL 2 ) THEN
		(
			CHANGE_VBL UNITS_TELEPORTED_TOTAL2 ADD 1
			CHANGE_VBL TIME_TO_SHOW_COUNT2 SET 1
		)
		IF ( VBL_TEST LEADER00_OWNER EQUAL 3 ) THEN
		(
			CHANGE_VBL UNITS_TELEPORTED_TOTAL3 ADD 1
			CHANGE_VBL TIME_TO_SHOW_COUNT3 SET 1
		)
		IF ( VBL_TEST LEADER00_OWNER EQUAL 4 ) THEN
		(
			CHANGE_VBL UNITS_TELEPORTED_TOTAL ADD 1
			CHANGE_VBL TIME_TO_SHOW_COUNT SET 1
		)
	)
