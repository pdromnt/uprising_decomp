###### CHECKING VICTORY ############

CHANGE_VBL CITADEL_COUNT0 SET 0

FOR CITADEL EQUAL 0 TO 8 DO
(
	
	IF ( CITADEL_OWNED 0 CITADEL ) THEN
	(
		CHANGE_VBL CITADEL_COUNT0 ADD 1
	)
	ELSE
	(
		CHANGE_VBL CITADEL_NOT_OWNED0 SET CITADEL
	)
	
)

IF ( AND ( CITADEL_OWNED_W_STRG_TOWER 0 CITADEL_NOT_OWNED0 VBL_TEST CITADEL_COUNT0 GREATER_THAN_EQUAL 8 )) THEN
(
	END_MISSION 0 1 10 { YOU'VE CAPTURED ALL OF THE CITADELS. }
	END_MISSION 1 0 10 { PLAYER 1 CAPTURED ALL OF THE CITADELS. }
	END_MISSION 2 0 10 { PLAYER 1 CAPTURED ALL OF THE CITADELS. }
