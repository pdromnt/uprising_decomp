	IF ( OR (( CLOSE_PT EEE NORTH_GATE 5 ) ( CLOSE_PT EEE WEST_GATE 5 )) ) THEN
	(
		SET_MOVEMENT_PATH EEE END_WEST
		REMOVE_UNIT EEETANK1
		REMOVE_UNIT EEETANK2
	)
	IF ( CLOSE_PT EEE EAST_GATE 5 ) THEN
	(
		SET_MOVEMENT_PATH EEE END_EAST
		REMOVE_UNIT EEETANK1
		REMOVE_UNIT EEETANK2
	)
	IF ( CLOSE_PT EEE SOUTH_GATE 5 ) THEN
	(
		SET_MOVEMENT_PATH EEE END
		REMOVE_UNIT EEETANK1
		REMOVE_UNIT EEETANK2
	)


	#Setting FFF to move to the teleport pad
	IF ( OR (( CLOSE_PT FFF NORTH_GATE 5 ) ( CLOSE_PT FFF WEST_GATE 5 )) ) THEN
	(
		SET_MOVEMENT_PATH FFF END_WEST
		REMOVE_UNIT FFFTANK1
		REMOVE_UNIT FFFTANK2
	)
	IF ( CLOSE_PT FFF EAST_GATE 5 ) THEN
	(
		SET_MOVEMENT_PATH FFF END_EAST
		REMOVE_UNIT FFFTANK1
		REMOVE_UNIT FFFTANK2
	)
	IF ( CLOSE_PT FFF SOUTH_GATE 5 ) THEN
	(
		SET_MOVEMENT_PATH FFF END
		REMOVE_UNIT FFFTANK1
		REMOVE_UNIT FFFTANK2
	)


	#Increasing foritifcation for AAA making it to the base and teleporting out
	IF ( CLOSE_PT AAA END 2 ) THEN
	(
		REMOVE_UNIT AAA


		IF ( VBL_TEST AAA_STRENGTH EQUAL 0 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 10
		)


		IF ( VBL_TEST AAA_STRENGTH EQUAL 1 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 10
		)


		IF ( VBL_TEST AAA_STRENGTH EQUAL 2 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 20
		)


		IF ( VBL_TEST AAA_STRENGTH EQUAL 3 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 20
		)


		IF ( VBL_TEST AAA_STRENGTH EQUAL 4 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 30
		)


		IF ( VBL_TEST AAA_STRENGTH EQUAL 5 ) THEN
		(
			CHANGE_VBL FORTIFICATION ADD 30
		)
	)


	#Increasing foritifcation for BBB making it to the base and teleporting out
	IF ( CLOSE_PT BBB END 2 ) THEN
	(
		REMOVE_UNIT BBB


		IF ( VBL_TEST BBB_STRENGTH EQUAL 0 ) THEN
