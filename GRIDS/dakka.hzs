START_SCRIPT_FILE

VDECL VINT DONE_SETUP  		0
VDECL VINT ACTION_TIME 		0
VDECL VINT GATE			0
VDECL VINT POWERUP1		0
VDECL VINT POWERUP2		0
VDECL VINT POWERUP3		0
VDECL VINT COUNT			0
VDECL VINT CITADEL_COUNT 	0
VDECL VINT END_BILLBOARD 	0
VDECL VINT A  			0
VDECL VINT DAVE			0
VDECL VINT MULTIGATE		0
VDECL VINT AAA			0
VDECL VINT PLAYER_SLOT     	0
VDECL VINT MISSION_FAILED 	0



IF ( AND ((VBL_TEST GATE EQUAL 0)(CITADEL_OWNED 0 0)) ) THEN
(
	IF ( AND ((CITADEL_OWNED 0 1)(CITADEL_OWNED 0 2)) )  THEN
	(
		IF (AND ((CITADEL_OWNED 0 3)(CITADEL_OWNED 0 6)) ) THEN
		(
			SHOW_BILLBOARD {CENTRAL GATES ARE LOWERED} 8
			SET_USE_DEFAULT_VICTORY 0
			SET_GATE GATE1 0
			SET_GATE GATE2 0
			SET_GATE GATE3 0			
			CHANGE_VBL GATE SET 1

		)
	)
)



IF (VBL_TEST DAVE EQUAL 0) THEN
(
	KILLER_SAT 4 LOC ( 142, 142, 0 )
)

	IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
	(
		CHANGE_VBL MISSION_FAILED SET 1
	)
	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT ALL ) THEN
		(
			END_MISSION PLAYER_SLOT 1 10 {MISSION ACCOMPLISHED\nPOWER TRANSFER STATION DEACTIVATED}
			CHANGE_VBL MISSION_FAILED SET 1
			CHANGE_VBL DAVE SET 1
		)
	)


	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
		(

			IF ( NOT ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT 0 ) ) THEN
			(
				END_MISSION PLAYER_SLOT 0 10 {MISSION FAILED}
			)
		)
	)

START_SECTION_MP_ONLY
		
	IF (VBL_TEST MULTIGATE EQUAL 0) THEN
	(	
		SET_GATE GATE1 0
		SET_GATE GATE2 0
		SET_GATE GATE3 0			
		CHANGE_VBL MULTIGATE SET 1
	)

END_SECTION





IF (VBL_TEST POWERUP1 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_A 0 LOC( 71, 240, 0) PU_BOMBERS 1
	CHANGE_VBL POWERUP1 SET 1
)

IF (VBL_TEST POWERUP2 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_B 0 LOC( 224, 225, 0 ) PU_SPECIAL_WEAPON_BOOST 1
	CHANGE_VBL POWERUP2 SET 1
)

IF (VBL_TEST POWERUP3 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_C 0 LOC( 85, 89, 0) PU_SPECIAL_WEAPON_BOOST 1
	CHANGE_VBL POWERUP3 SET 1
)


END_SCRIPT_FILE


