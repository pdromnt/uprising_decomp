START_SCRIPT_FILE

VDECL VINT PU_TIME_DELAY 15
VDECL VINT PU_TIME 0
VDECL VINT RANDOM_LOC 0
VDECL VINT RANDOM_POINT 0

VDECL VINT CITADEL         0
VDECL VINT PLAYER_SLOT     0
VDECL VINT MISSION_FAILED  0

VDECL VINT P1_CIT_COUNT 0
VDECL VINT P2_CIT_COUNT 0
VDECL VINT P3_CIT_COUNT 0
VDECL VINT P4_CIT_COUNT 0
VDECL VINT IM_CIT_COUNT 0

VDECL VINT CIT_COUNT_TIME      0
VDECL VINT CIT_MESSAGE_SWITCH  0


VDECL VLOC PU_N1 LOC(124,234,0)
VDECL VLOC PU_N2 LOC(147,234,0)
VDECL VLOC PU_N3 LOC(160,234,0)
VDECL VLOC PU_N4 LOC(124,212,0)
VDECL VLOC PU_N5 LOC(153,212,0)
VDECL VLOC PU_N6 LOC(160,212,0)
VDECL VLOC PU_S1 LOC(119,27,0)
VDECL VLOC PU_S2 LOC(136,27,0)
VDECL VLOC PU_S3 LOC(156,27,0)
VDECL VLOC PU_S4 LOC(119,47,0)
VDECL VLOC PU_S5 LOC(136,47,0)
VDECL VLOC PU_S6 LOC(156,47,0)
VDECL VLOC PU_W1 LOC(50,143,0)
VDECL VLOC PU_W2 LOC(54,130,0)
VDECL VLOC PU_W3 LOC(46,111,0)
VDECL VLOC PU_W4 LOC(16,111,0)
VDECL VLOC PU_W5 LOC(23,130,0)
VDECL VLOC PU_W6 LOC(13,152,0)
VDECL VLOC PU_E1 LOC(194,110,0)
VDECL VLOC PU_E2 LOC(204,127,0)
VDECL VLOC PU_E3 LOC(190,151,0)
VDECL VLOC PU_E4 LOC(245,108,0)
VDECL VLOC PU_E5 LOC(232,128,0)
VDECL VLOC PU_E6 LOC(243,149,0)


VDECL VINT CENTER_PU_TIME 0
VDECL VINT INDEX 0
VDECL VINT WHICH 0

VDECL VINT PU_C0_INDEX 0
VDECL VINT PU_C1_INDEX 1
VDECL VINT PU_C2_INDEX 2
VDECL VINT PU_C3_INDEX 3

VDECL VLOC PU_C0_LOC LOC ( 1, 1, 1 )
VDECL VLOC PU_C1_LOC LOC ( 1, 1, 1 )
VDECL VLOC PU_C2_LOC LOC ( 1, 1, 1 )
VDECL VLOC PU_C3_LOC LOC ( 1, 1, 1 )

VDECL VLOC C0_LOC LOC ( 139, 129, 0 )
VDECL VLOC C1_LOC LOC ( 144, 124, 0 )
VDECL VLOC C2_LOC LOC ( 139, 119, 0 )
VDECL VLOC C3_LOC LOC ( 134, 124, 0 )


IF(VBL_TEST PU_TIME LESS_THAN GAME_TIME) THEN
(
        CHANGE_VBL PU_TIME SET GAME_TIME
        CHANGE_VBL PU_TIME ADD PU_TIME_DELAY

        CHANGE_VBL RANDOM_LOC   SET RANDOM_INT 9
        CHANGE_VBL RANDOM_POINT SET RANDOM_INT 3

        IF(AND((VBL_TEST RANDOM_LOC EQUAL 0) (NOT(IS_ALIVE PU_1)))) THEN
        (
                IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
                (
                        CREATE_FIXED_PU PU_1 0 PU_N1 PU_RANDOM 1
                )

                IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
                (
                        CREATE_FIXED_PU PU_1 0 PU_N2 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 2) THEN
                (
                        CREATE_FIXED_PU PU_1 0 PU_N3 PU_RANDOM 1
                )
        )
        IF(AND((VBL_TEST RANDOM_LOC EQUAL 1) (NOT(IS_ALIVE PU_2)))) THEN
        (
                IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
                (
                        CREATE_FIXED_PU PU_2 0 PU_N4 PU_RANDOM 1
                )

                IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
                (
                        CREATE_FIXED_PU PU_2 0 PU_N5 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 2) THEN
                (
                        CREATE_FIXED_PU PU_2 0 PU_N6 PU_RANDOM 1
                )
        )
        IF(AND((VBL_TEST RANDOM_LOC EQUAL 2) (NOT(IS_ALIVE PU_3)))) THEN
        (
                IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
                (
                        CREATE_FIXED_PU PU_3 0 PU_S1 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
                (
                        CREATE_FIXED_PU PU_3 0 PU_S2 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 2) THEN
                (
                        CREATE_FIXED_PU PU_3 0 PU_S3 PU_RANDOM 1
                )
        )
        IF(AND((VBL_TEST RANDOM_LOC EQUAL 3) (NOT(IS_ALIVE PU_4)))) THEN
        (
                IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
                (
                        CREATE_FIXED_PU PU_4 0 PU_S4 PU_RANDOM 1
                )

                IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
                (
                        CREATE_FIXED_PU PU_4 0 PU_S5 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 2) THEN
                (
                        CREATE_FIXED_PU PU_4 0 PU_S6 PU_RANDOM 1
                )
        )
        IF(AND((VBL_TEST RANDOM_LOC EQUAL 4) (NOT(IS_ALIVE PU_5)))) THEN
        (
                IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
                (
                        CREATE_FIXED_PU PU_5 0 PU_W1 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
                (
                        CREATE_FIXED_PU PU_5 0 PU_W2 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 2) THEN
                (
                        CREATE_FIXED_PU PU_5 0 PU_W3 PU_RANDOM 1
                )
        )
        IF(AND((VBL_TEST RANDOM_LOC EQUAL 5) (NOT(IS_ALIVE PU_6)))) THEN
        (
                IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
                (
                        CREATE_FIXED_PU PU_6 0 PU_W4 PU_RANDOM 1
                )

                IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
                (
                        CREATE_FIXED_PU PU_6 0 PU_W5 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 2) THEN
                (
                        CREATE_FIXED_PU PU_6 0 PU_W6 PU_RANDOM 1
                )
        )
        IF(AND((VBL_TEST RANDOM_LOC EQUAL 6) (NOT(IS_ALIVE PU_7)))) THEN
        (
                IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
                (
                        CREATE_FIXED_PU PU_7 0 PU_E1 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
                (
                        CREATE_FIXED_PU PU_7 0 PU_E2 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 2) THEN
                (
                        CREATE_FIXED_PU PU_7 0 PU_E3 PU_RANDOM 1
                )
        )
        IF(AND((VBL_TEST RANDOM_LOC EQUAL 7) (NOT(IS_ALIVE PU_8)))) THEN
        (
                IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
                (
                        CREATE_FIXED_PU PU_8 0 PU_E4 PU_RANDOM 1
                )

                IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
                (
                        CREATE_FIXED_PU PU_8 0 PU_E5 PU_RANDOM 1
                )
                IF(VBL_TEST RANDOM_POINT EQUAL 2) THEN
                (
                        CREATE_FIXED_PU PU_8 0 PU_E6 PU_RANDOM 1
                )
        )
)



	IF ( VBL_TEST CENTER_PU_TIME LESS_THAN GAME_TIME ) THEN
	(
		CHANGE_VBL WHICH SET RANDOM_INT 2
		CHANGE_VBL INDEX SET RANDOM_INT 5
		CHANGE_VBL PU_C0_INDEX ADD INDEX
		CHANGE_VBL PU_C1_INDEX ADD INDEX
		CHANGE_VBL PU_C2_INDEX ADD INDEX
		CHANGE_VBL PU_C3_INDEX ADD INDEX

		IF ( NOT ( IS_ALIVE PU_C0 ) ) THEN
		(
			IF ( VBL_TEST PU_C0_INDEX EQUAL 4 ) THEN
			(
				CHANGE_VBL PU_C0_INDEX SET 0
			)
			IF ( VBL_TEST PU_C0_INDEX EQUAL 5 ) THEN
			(
				CHANGE_VBL PU_C0_INDEX SET 1
			)
			IF ( VBL_TEST PU_C0_INDEX EQUAL 6 ) THEN
			(
				CHANGE_VBL PU_C0_INDEX SET 2
			)
			IF ( VBL_TEST PU_C0_INDEX EQUAL 7 ) THEN
			(
				CHANGE_VBL PU_C0_INDEX SET 3
			)

			IF ( VBL_TEST PU_C0_INDEX EQUAL 0 ) THEN
			(
				CHANGE_LOC_VBL PU_C0_LOC SET C0_LOC
			)
			IF ( VBL_TEST PU_C0_INDEX EQUAL 1 ) THEN
			(
				CHANGE_LOC_VBL PU_C0_LOC SET C1_LOC
			)
			IF ( VBL_TEST PU_C0_INDEX EQUAL 2 ) THEN
			(
				CHANGE_LOC_VBL PU_C0_LOC SET C2_LOC
			)
			IF ( VBL_TEST PU_C0_INDEX EQUAL 3 ) THEN
			(
				CHANGE_LOC_VBL PU_C0_LOC SET C3_LOC
			)

			CREATE_FIXED_PU PU_C0 0 PU_C0_LOC PU_LIVES 1
		)


		IF ( NOT ( IS_ALIVE PU_C1 ) ) THEN
		(
			IF ( VBL_TEST PU_C1_INDEX EQUAL 4 ) THEN
			(
				CHANGE_VBL PU_C1_INDEX SET 0
			)
			IF ( VBL_TEST PU_C1_INDEX EQUAL 5 ) THEN
			(
				CHANGE_VBL PU_C1_INDEX SET 1
			)
			IF ( VBL_TEST PU_C1_INDEX EQUAL 6 ) THEN
			(
				CHANGE_VBL PU_C1_INDEX SET 2
			)
			IF ( VBL_TEST PU_C1_INDEX EQUAL 7 ) THEN
			(
				CHANGE_VBL PU_C1_INDEX SET 3
			)

			IF ( VBL_TEST PU_C1_INDEX EQUAL 0 ) THEN
			(
				CHANGE_LOC_VBL PU_C1_LOC SET C0_LOC
			)
			IF ( VBL_TEST PU_C1_INDEX EQUAL 1 ) THEN
			(
				CHANGE_LOC_VBL PU_C1_LOC SET C1_LOC
			)
			IF ( VBL_TEST PU_C1_INDEX EQUAL 2 ) THEN
			(
				CHANGE_LOC_VBL PU_C1_LOC SET C2_LOC
			)
			IF ( VBL_TEST PU_C1_INDEX EQUAL 3 ) THEN
			(
				CHANGE_LOC_VBL PU_C1_LOC SET C3_LOC
			)

			CREATE_FIXED_PU PU_C1 0 PU_C1_LOC PU_MONEY 1000
		)


		IF (AND ( (NOT(IS_ALIVE PU_C21)) (NOT(IS_ALIVE PU_C22)) ) ) THEN
		(
			IF ( VBL_TEST PU_C2_INDEX EQUAL 4 ) THEN
			(
				CHANGE_VBL PU_C2_INDEX SET 0
			)
			IF ( VBL_TEST PU_C2_INDEX EQUAL 5 ) THEN
			(
				CHANGE_VBL PU_C2_INDEX SET 1
			)
			IF ( VBL_TEST PU_C2_INDEX EQUAL 6 ) THEN
			(
				CHANGE_VBL PU_C2_INDEX SET 2
			)
			IF ( VBL_TEST PU_C2_INDEX EQUAL 7 ) THEN
			(
				CHANGE_VBL PU_C2_INDEX SET 3
			)

			IF ( VBL_TEST PU_C2_INDEX EQUAL 0 ) THEN
			(
				CHANGE_LOC_VBL PU_C2_LOC SET C0_LOC
			)
			IF ( VBL_TEST PU_C2_INDEX EQUAL 1 ) THEN
			(
				CHANGE_LOC_VBL PU_C2_LOC SET C1_LOC
			)
			IF ( VBL_TEST PU_C2_INDEX EQUAL 2 ) THEN
			(
				CHANGE_LOC_VBL PU_C2_LOC SET C2_LOC
			)
			IF ( VBL_TEST PU_C2_INDEX EQUAL 3 ) THEN
			(
				CHANGE_LOC_VBL PU_C2_LOC SET C3_LOC
			)

			IF ( VBL_TEST WHICH EQUAL 0 ) THEN
			(
				CREATE_FIXED_PU PU_C21 0 PU_C2_LOC PU_SOLDIERS 5
			)
			IF ( VBL_TEST WHICH EQUAL 1 ) THEN
			(
				CREATE_FIXED_PU PU_C22 0 PU_C2_LOC PU_TANKS 5
			)
		)


		IF (AND ( (NOT(IS_ALIVE PU_C31)) (NOT(IS_ALIVE PU_C32)) ) ) THEN
		(
			IF ( VBL_TEST PU_C3_INDEX EQUAL 4 ) THEN
			(
				CHANGE_VBL PU_C3_INDEX SET 0
			)
			IF ( VBL_TEST PU_C3_INDEX EQUAL 5 ) THEN
			(
				CHANGE_VBL PU_C3_INDEX SET 1
			)
			IF ( VBL_TEST PU_C3_INDEX EQUAL 6 ) THEN
			(
				CHANGE_VBL PU_C3_INDEX SET 2
			)
			IF ( VBL_TEST PU_C3_INDEX EQUAL 7 ) THEN
			(
				CHANGE_VBL PU_C3_INDEX SET 3
			)

			IF ( VBL_TEST PU_C3_INDEX EQUAL 0 ) THEN
			(
				CHANGE_LOC_VBL PU_C3_LOC SET C0_LOC
			)
			IF ( VBL_TEST PU_C3_INDEX EQUAL 1 ) THEN
			(
				CHANGE_LOC_VBL PU_C3_LOC SET C1_LOC
			)
			IF ( VBL_TEST PU_C3_INDEX EQUAL 2 ) THEN
			(
				CHANGE_LOC_VBL PU_C3_LOC SET C2_LOC
			)
			IF ( VBL_TEST PU_C3_INDEX EQUAL 3 ) THEN
			(
				CHANGE_LOC_VBL PU_C3_LOC SET C3_LOC
			)

			IF ( VBL_TEST WHICH EQUAL 0 ) THEN
			(
				CREATE_FIXED_PU PU_C31 0 PU_C3_LOC PU_AAVS 5
			)
			IF ( VBL_TEST WHICH EQUAL 1 ) THEN
			(
				CREATE_FIXED_PU PU_C32 0 PU_C3_LOC PU_BOMBERS 5
			)
		)

		CHANGE_VBL CENTER_PU_TIME SET GAME_TIME
		CHANGE_VBL CENTER_PU_TIME ADD 180
		SHOW_BILLBOARD {POWER-UP DROP DETECTED AT CENTER OF HOTZONE} 10
		CHANGE_VBL CIT_COUNT_TIME SET GAME_TIME
		CHANGE_VBL CIT_COUNT_TIME ADD 10
	)



	CHANGE_VBL P1_CIT_COUNT SET 0
	CHANGE_VBL P2_CIT_COUNT SET 0
	CHANGE_VBL P3_CIT_COUNT SET 0
	CHANGE_VBL P4_CIT_COUNT SET 0
	CHANGE_VBL IM_CIT_COUNT SET 0

	FOR CITADEL EQUAL 0 TO 4 DO
	(

		IF ( CITADEL_OWNED 0 CITADEL ) THEN
		(
			CHANGE_VBL P1_CIT_COUNT ADD 1
		)
		IF ( CITADEL_OWNED 1 CITADEL ) THEN
		(
			CHANGE_VBL P2_CIT_COUNT ADD 1
		)
		IF ( CITADEL_OWNED 2 CITADEL ) THEN
		(
			CHANGE_VBL P3_CIT_COUNT ADD 1
		)
		IF ( CITADEL_OWNED 3 CITADEL ) THEN
		(
			CHANGE_VBL P4_CIT_COUNT ADD 1
		)
		IF ( CITADEL_OWNED 4 CITADEL ) THEN
		(
			CHANGE_VBL IM_CIT_COUNT ADD 1
		)
	)


	IF ( AND (( VBL_TEST CIT_MESSAGE_SWITCH EQUAL 0 ) ( VBL_TEST CIT_COUNT_TIME LESS_THAN GAME_TIME )) ) THEN
	(

		IF ( VBL_TEST P1_CIT_COUNT EQUAL 3 ) THEN
		(
			SHOW_BILLBOARD {PLAYER ONE OWNS THREE OF THE FOUR CITADELS} 10
			CHANGE_VBL CENTER_PU_TIME ADD 10
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 1
		)
		IF ( VBL_TEST P2_CIT_COUNT EQUAL 3 ) THEN
		(
			SHOW_BILLBOARD {PLAYER TWO OWNS THREE OF THE FOUR CITADELS} 10
			CHANGE_VBL CENTER_PU_TIME ADD 10
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 1
		)
		IF ( VBL_TEST P3_CIT_COUNT EQUAL 3 ) THEN
		(
			SHOW_BILLBOARD {PLAYER THREE OWNS THREE OF THE FOUR CITADELS} 10
			CHANGE_VBL CENTER_PU_TIME ADD 10
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 1
		)
		IF ( VBL_TEST P4_CIT_COUNT EQUAL 3 ) THEN
		(
			SHOW_BILLBOARD {PLAYER FOUR OWNS THREE OF THE FOUR CITADELS} 10
			CHANGE_VBL CENTER_PU_TIME ADD 10
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 1
		)
		IF ( VBL_TEST IM_CIT_COUNT EQUAL 3 ) THEN
		(
			SHOW_BILLBOARD {THE IMPERIUM OWNS THREE OF THE FOUR CITADELS} 10
			CHANGE_VBL CENTER_PU_TIME ADD 10
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 1
		)
	)
	ELSE
	(
		IF ( VBL_TEST P1_CIT_COUNT EQUAL 2 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
		IF ( VBL_TEST P2_CIT_COUNT EQUAL 2 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
		IF ( VBL_TEST P3_CIT_COUNT EQUAL 2 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
		IF ( VBL_TEST P4_CIT_COUNT EQUAL 2 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
		IF ( VBL_TEST IM_CIT_COUNT EQUAL 2 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
	)



	IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
	(
		CHANGE_VBL MISSION_FAILED SET 1
	)
	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT ALL ) THEN
		(
			END_MISSION PLAYER_SLOT 1 10 {MISSION ACCOMPLISHED}
			CHANGE_VBL MISSION_FAILED SET 1
		)
	)



	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
		(

			IF ( NOT ( CITADEL_OWNED PLAYER_SLOT 0 ) ) THEN
			(
				END_MISSION PLAYER_SLOT 0 10 {MISSION FAILED}
			)
		)
	)



END_SCRIPT_FILE