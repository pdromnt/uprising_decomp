START_SCRIPT_FILE


VDECL VINT SLOT_NUMBER 	   	0
VDECL VINT WHICH_CIT   	   	0
VDECL VINT AAA        	   	0
VDECL VINT BOMBER_ATTACK	0
VDECL VINT POWERUP1  		0
VDECL VINT POWERUP2		0
VDECL VINT PLAYER_SLOT     	0
VDECL VINT MISSION_FAILED  	0    

VDECL VINT SET_BOMBER_DELAY_TIME  0
VDECL VINT BOMBER_DELAY_TIME      0






IF (VBL_TEST POWERUP1 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_A 0 LOC( 12, 233, 0 ) PU_MONEY 500
	CHANGE_VBL POWERUP1 SET 1
)

IF (VBL_TEST POWERUP2 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_B 0 LOC( 244, 114, 0 ) PU_MONEY 800
	CHANGE_VBL POWERUP2 SET 1
)


	IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
	(
		CHANGE_VBL MISSION_FAILED SET 1
	)
	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT ALL ) THEN
		(
			END_MISSION PLAYER_SLOT 1 5 {MISSION ACCOMPLISHED}
			CHANGE_VBL MISSION_FAILED SET 1
		)
	)


	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
		(

			IF ( NOT ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT 0 ) ) THEN
			(
				END_MISSION PLAYER_SLOT 0 5 {MISSION FAILED}
			)
		)
	)


START_SECTION_SP_ONLY

	IF ( AND (( CITADEL_OWNED 0 4 )( VBL_TEST BOMBER_ATTACK EQUAL 0 )) ) THEN
	(
		IF ( VBL_TEST SET_BOMBER_DELAY_TIME EQUAL 0 ) THEN
		(
			CHANGE_VBL BOMBER_DELAY_TIME SET GAME_TIME
			CHANGE_VBL BOMBER_DELAY_TIME ADD 30
			CHANGE_VBL SET_BOMBER_DELAY_TIME SET 1
		)
	

			IF ( VBL_TEST GAME_TIME GREATER_THAN_EQUAL BOMBER_DELAY_TIME ) THEN
			(
				CHANGE_VBL BOMBER_ATTACK SET 1

			)

	)

	IF ( VBL_TEST BOMBER_ATTACK EQUAL 1 ) THEN
	(
		CHANGE_VBL WHICH_CIT SET RANDOM_INT 6

		FOR AAA EQUAL 0 TO 5 DO
		(
			IF ( AND (( CITADEL_OWNED_W_TOWER 0 AAA ) ( VBL_TEST WHICH_CIT EQUAL AAA )) ) THEN
			(				
				CREATE_UNIT BOMBER0 4 BOMBER LOC ( 90, 126, 0 ) YAW (0) NULL NULL
				CREATE_UNIT BOMBER1 4 BOMBER LOC ( 123, 120, 0 ) YAW (0) NULL NULL
				CREATE_UNIT BOMBER2 4 BOMBER LOC ( 133, 89, 0 ) YAW (0) NULL NULL
				CREATE_UNIT BOMBER3 4 BOMBER LOC ( 153, 146, 110 ) YAW (0) NULL NULL
				CREATE_UNIT BOMBER4 4 BOMBER LOC ( 131, 98, 0 )  YAW (0) NULL NULL


				IF ( VBL_TEST WHICH_CIT EQUAL 0 ) THEN
				(
					SET_MOVEMENT_PATH BOMBER0 PATH0
					SET_MOVEMENT_PATH BOMBER1 PATH0
					SET_MOVEMENT_PATH BOMBER2 PATH0					
					SET_MOVEMENT_PATH BOMBER3 PATH0
					SET_MOVEMENT_PATH BOMBER4 PATH0
					SHOW_BILLBOARD {LARGE-SCALE BOMBER STRIKE DETECTED \n CIT LOC 'I9'}
				)


				IF ( VBL_TEST WHICH_CIT EQUAL 1 ) THEN
				(
					SET_MOVEMENT_PATH BOMBER0 PATH1
					SET_MOVEMENT_PATH BOMBER1 PATH1
					SET_MOVEMENT_PATH BOMBER2 PATH1
					SET_MOVEMENT_PATH BOMBER3 PATH1
					SET_MOVEMENT_PATH BOMBER4 PATH1
					SHOW_BILLBOARD {LARGE-SCALE BOMBER STRIKE DETECTED \n CIT LOC 'B9'}
				)


				IF ( VBL_TEST WHICH_CIT EQUAL 2 ) THEN
				(
					SET_MOVEMENT_PATH BOMBER0 PATH2
					SET_MOVEMENT_PATH BOMBER1 PATH2
					SET_MOVEMENT_PATH BOMBER2 PATH2
					SET_MOVEMENT_PATH BOMBER3 PATH2
					SET_MOVEMENT_PATH BOMBER4 PATH2
					SHOW_BILLBOARD {LARGE-SCALE BOMBER ATTACK DETECTED \n CIT LOC 'C2'}
				)


				IF ( VBL_TEST WHICH_CIT EQUAL 3 ) THEN
				(
					SET_MOVEMENT_PATH BOMBER0 PATH3
					SET_MOVEMENT_PATH BOMBER1 PATH3
					SET_MOVEMENT_PATH BOMBER2 PATH3
					SET_MOVEMENT_PATH BOMBER3 PATH3
					SET_MOVEMENT_PATH BOMBER4 PATH3
					SHOW_BILLBOARD {LARGE-SCALE BOMBER ATTACK DETECTED \n CIT LOC 'B7'}
				)


				IF ( VBL_TEST WHICH_CIT EQUAL 4 ) THEN
				(
					SET_MOVEMENT_PATH BOMBER0 PATH4
					SET_MOVEMENT_PATH BOMBER1 PATH4
					SET_MOVEMENT_PATH BOMBER2 PATH4
					SET_MOVEMENT_PATH BOMBER3 PATH4
					SET_MOVEMENT_PATH BOMBER4 PATH4
					SHOW_BILLBOARD {LARGE-SCALE BOMBER ATTACK DETECTED \n CIT LOC 'G2'}
				)


				IF ( VBL_TEST WHICH_CIT EQUAL 5 ) THEN
				(
					SET_MOVEMENT_PATH BOMBER0 PATH5
					SET_MOVEMENT_PATH BOMBER1 PATH5
					SET_MOVEMENT_PATH BOMBER2 PATH5
					SET_MOVEMENT_PATH BOMBER3 PATH5
					SET_MOVEMENT_PATH BOMBER4 PATH5
					SHOW_BILLBOARD {LARGE-SCALE BOMBER ATTACK DETECTED \n CIT LOC 'I3'}
				)

				CHANGE_VBL BOMBER_ATTACK SET 2
			)
		)
	)


END_SECTION


END_SCRIPT_FILE





