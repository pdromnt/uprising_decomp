START_SCRIPT_FILE

VDECL VINT DONE_SETUP 		0
VDECL VINT SLOT_NUMBER 		0
VDECL VINT BOMBER			0
VDECL VINT TURRET			0
VDECL VINT POWERUP1		0
VDECL VINT POWERUP2		0
VDECL VINT POWERUP3		0
VDECL VINT PLAYER_SLOT     	0
VDECL VINT MISSION_FAILED  	0

VDECL VLOC FINAL_CLOSEPT LOC (74, 221, 400)
VDECL VLOC BOMBER1 LOC (21, 231, 0)
VDECL VLOC BOMBER2 LOC (21, 225, 0)
VDECL VLOC BOMBER3 LOC (21, 218, 0)
VDECL VLOC BOMBER4 LOC (21, 210, 0)
VDECL VLOC BOMBER5 LOC (22, 203, 0)
VDECL VLOC TUR_CLOSEPT LOC (56, 218, 0)
VDECL VLOC TURRET1 LOC (42, 220, 100)
VDECL VLOC TURRET2 LOC (42, 216, 100)



IF ( VBL_TEST DONE_SETUP EQUAL 0 ) THEN
(
	SET_USE_DEFAULT_VICTORY 0
	CHANGE_VBL DONE_SETUP SET 1
)

START_SECTION_SP_ONLY

IF ( AND ((VBL_TEST BOMBER EQUAL 0)(CLOSE_PT HTANK 0 FINAL_CLOSEPT 15 )) ) THEN
(

	CREATE_UNIT BOMBER1 4 BOMBER BOMBER1 YAW (0) NULL NULL
	CREATE_UNIT BOMBER2 4 BOMBER BOMBER2 YAW (0) NULL NULL
	CREATE_UNIT BOMBER3 4 BOMBER BOMBER3 YAW (0) NULL NULL
	CREATE_UNIT BOMBER4 4 BOMBER BOMBER4 YAW (0) NULL NULL
	CREATE_UNIT BOMBER5 4 BOMBER BOMBER5 YAW (0) NULL NULL

	SET_MOVEMENT_PATH BOMBER1 BOMBER1 
	SET_MOVEMENT_PATH BOMBER2 BOMBER2 
	SET_MOVEMENT_PATH BOMBER3 BOMBER3 
	SET_MOVEMENT_PATH BOMBER4 BOMBER4 
	SET_MOVEMENT_PATH BOMBER5 BOMBER5 

	CHANGE_VBL BOMBER SET 1
)

IF ( AND ((VBL_TEST TURRET EQUAL 0)(CLOSE_PT HTANK 0 TUR_CLOSEPT 4 )) ) THEN
(		
	CREATE_UNIT TURRET1 5 HEAVY_TURRET TURRET1 YAW (0) NULL NULL
	CREATE_UNIT TURRET2 5 HEAVY_TURRET TURRET2 YAW (0) NULL NULL
	CHANGE_VBL TURRET SET 1
)

END_SECTION


	IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
	(
		CHANGE_VBL MISSION_FAILED SET 1
	)
	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT ALL ) THEN
		(
			END_MISSION PLAYER_SLOT 1 5 {MISSION ACCOMPLISHED}
			CHANGE_VBL MISSION_FAILED SET 1
		)
	)


	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
		(

			IF ( NOT ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT 0 ) ) THEN
			(
				END_MISSION PLAYER_SLOT 0 5 {MISSION FAILED}
			)
		)
	)




IF (VBL_TEST POWERUP1 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_A 0 LOC( 246, 10, 0 ) PU_BOMBERS 1
	CHANGE_VBL POWERUP1 SET 1
)

IF (VBL_TEST POWERUP2 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_B 0 LOC( 212, 233, 0 ) PU_SPECIAL_WEAPON_BOOST 1
	CHANGE_VBL POWERUP2 SET 1
)

IF (VBL_TEST POWERUP3 EQUAL 0) THEN
(
	CREATE_FIXED_PU PU_C 0 LOC( 18, 76, 0 ) PU_SOLDIERS 1
	CHANGE_VBL POWERUP3 SET 1
)

END_SCRIPT_FILE
