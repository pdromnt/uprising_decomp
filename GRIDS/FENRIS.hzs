##### BONUS 01 #################################################################
IF ( AND ( NOT ( IS_ALIVE BONUS01 ) VBL_TEST GEN_BONUS01 EQUAL 1 )) THEN 
(
	CHANGE_VBL BONUS_TIME01 SET GAME_TIME
	CHANGE_VBL BONUS_TIME01 ADD BONUS_RECYCLE
	CHANGE_VBL GEN_BONUS01 SET 0
)


IF ( NOT ( IS_ALIVE BONUS01 )) THEN
(
	IF ( VBL_TEST BONUS_TIME01 LESS_THAN_EQUAL GAME_TIME ) THEN
	(
		CHANGE_VBL BONUS_LOC_INDEX01 SET RANDOM_INT 8
		CHANGE_VBL BONUS_LOC_INDEX01 ADD 1
		CHANGE_VBL LOOP01 SET 1
	
		FOR LOOP01 EQUAL 1 TO 4 DO 
		(
			IF ( VBL_TEST BONUS_LOC_INDEX01 EQUAL 1 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC01 SET BONUS_AREA_LOC01
			)
			IF ( VBL_TEST BONUS_LOC_INDEX01 EQUAL 2 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC01 SET BONUS_AREA_LOC02
			)
			IF ( VBL_TEST BONUS_LOC_INDEX01 EQUAL 3 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC01 SET BONUS_AREA_LOC03
			)
			IF ( VBL_TEST BONUS_LOC_INDEX01 EQUAL 4 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC01 SET BONUS_AREA_LOC04
			)
			IF ( VBL_TEST BONUS_LOC_INDEX01 EQUAL 5 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC01 SET BONUS_AREA_LOC05
			)
			IF ( VBL_TEST BONUS_LOC_INDEX01 EQUAL 6 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC01 SET BONUS_AREA_LOC06
			)
			IF ( VBL_TEST BONUS_LOC_INDEX01 EQUAL 7 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC01 SET BONUS_AREA_LOC07
			) 	
			IF ( VBL_TEST BONUS_LOC_INDEX01 EQUAL 8 ) THEN
			(
				CHANGE_LOC_VBL BONUS_LOC01 SET BONUS_AREA_LOC08
			)

			IF (
				OR ( CLOSE_PT HTANK 0 BONUS_LOC01 5
				OR ( CLOSE_PT HTANK 1 BONUS_LOC01 5
				OR ( CLOSE_PT HTANK 2 BONUS_LOC01 5
				OR ( CLOSE_PT HTANK 3 BONUS_LOC01 5
				OR ( VBL_TEST BONUS_LOC_INDEX01 EQUAL BONUS_LOC_INDEX02
				OR ( VBL_TEST BONUS_LOC_INDEX01 EQUAL BONUS_LOC_INDEX03 				VBL_TEST BONUS_LOC_INDEX01 EQUAL BONUS_LOC_INDEX04 ))))))) THEN
			(
				CHANGE_VBL BONUS_LOC_INDEX01 ADD 1
				IF ( VBL_TEST BONUS_LOC_INDEX01 GREATER_THAN 8 ) THEN
				(
					CHANGE_VBL BONUS_LOC_INDEX01 SUB 8
				)

			)
			ELSE
			(
				CHANGE_VBL LOOP01 SET 5
			)
		)
	
		CREATE_FIXED_PU BONUS01 0 BONUS_LOC01 PU_RANDOM 1
		CHANGE_VBL GEN_BONUS01 SET 1

	)
)

