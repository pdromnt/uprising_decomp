###### GENERATION OF BONUS BOXES AT TPORT INHIBIT SITE 1 #######################
IF ( VBL_TEST BONUS_RESET01 EQUAL 0 ) THEN
( 
	IF ( NOT ( IS_ALIVE FTLD01 )) THEN
	(

		CHANGE_VBL BONUS_RESET01 SET 1
		CHANGE_VBL BONUS_TIME01 SET GAME_TIME
		CHANGE_VBL BONUS_TIME01 ADD BONUS_DELAY
		CHANGE_VBL BONUS_COLLECTED01 SET 0

	)
)

IF ( VBL_TEST BONUS_COLLECTED01 EQUAL 0 ) THEN
(
	IF ( VBL_TEST BONUS_TIME01 LESS_THAN_EQUAL GAME_TIME ) THEN
	(

		IF ( NOT ( IS_ALIVE AMMO01 )) THEN
		(
			CREATE_FIXED_PU AMMO01  0  DROP11 PU_SOLDIERS  BONUS01
