#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D upscaled;
layout(set=0,binding=1) uniform sampler2D scene;
layout(set=0,binding=2) uniform sampler2D native_final;
layout(set=0,binding=3,rgba8) uniform writeonly image2D output_color;
layout(push_constant) uniform View {ivec4 crop;} view;
void main(){
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(pixel,imageSize(output_color))))return;
    ivec2 source=pixel/2,local=pixel-view.crop.xy*2;
    vec4 final_color=texelFetch(native_final,source,0);
    vec4 current_scene=texelFetch(scene,source,0);
    bool covered=current_scene.a>0.0 || any(notEqual(current_scene.rgb,vec3(0)));
    if(all(greaterThanEqual(local,ivec2(0))) && all(lessThan(local,view.crop.zw*2)) && covered){
        // Both MRTs receive identical RGB blending. Their difference is the
        // surviving pre-scene artwork contribution, never temporal HUD data.
        vec3 artwork=max(final_color.rgb-current_scene.rgb,vec3(0));
        final_color=vec4(texelFetch(upscaled,local,0).rgb+artwork,1);
    }
    imageStore(output_color,pixel,final_color);
}
