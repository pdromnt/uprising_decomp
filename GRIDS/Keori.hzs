START_SCRIPT_FILE
VDECL VINT PU_TIME_DELAY 30
VDECL VINT PU_TIME 0
VDECL VINT RANDOM_LOC 0
VDECL VINT RANDOM_POINT 0

VDECL VINT SPU_RANDOM_LOC 0




VDECL VINT CITADEL         0
VDECL VINT PLAYER_SLOT     0
VDECL VINT MISSION_FAILED  0

VDECL VINT P1_CIT_COUNT 0
VDECL VINT P2_CIT_COUNT 0
VDECL VINT P3_CIT_COUNT 0
VDECL VINT P4_CIT_COUNT 0
VDECL VINT IM_CIT_COUNT 0

VDECL VINT CIT_COUNT_TIME      0
VDECL VINT CIT_MESSAGE_SWITCH  0





VDECL VLOC SPU1 LOC(95,170,0)
VDECL VLOC SPU2 LOC(183,158,0)
VDECL VLOC SPU3 LOC(195,70,0)
VDECL VLOC SPU4 LOC(113,71,0)

VDECL VLOC PU_1_0 LOC(34,162,0)
VDECL VLOC PU_1_1 LOC(54,162,0)

VDECL VLOC PU_2_0 LOC(98,218,0)
VDECL VLOC PU_2_1 LOC(98,198,0)

VDECL VLOC PU_3_0 LOC(185,218,0)
VDECL VLOC PU_3_1 LOC(186,118,0)

VDECL VLOC PU_4_0 LOC(238,166,0)
VDECL VLOC PU_4_1 LOC(218,166,0)

VDECL VLOC PU_5_0 LOC(198,130,0)
VDECL VLOC PU_5_1 LOC(198,110,0)

VDECL VLOC PU_6_0 LOC(218,82,0)
VDECL VLOC PU_6_1 LOC(238,82,0)

VDECL VLOC PU_7_0 LOC(202,46,0)
VDECL VLOC PU_7_1 LOC(202,26,0)

VDECL VLOC PU_8_0 LOC(110,50,0)
VDECL VLOC PU_8_1 LOC(110,30,0)

VDECL VLOC PU_9_0 LOC(38,86,0)
VDECL VLOC PU_9_1 LOC(58,86,0)

VDECL VLOC PU_10_0 LOC(106,130,0)
VDECL VLOC PU_10_1 LOC(106,110,0)

VDECL VLOC PU_11_0 LOC(142,162,0)
VDECL VLOC PU_11_1 LOC(162,162,0)

VDECL VLOC PU_12_0 LOC(150,82,0)
VDECL VLOC PU_12_1 LOC(170,82,0)



IF(VBL_TEST PU_TIME LESS_THAN GAME_TIME) THEN
(

        CHANGE_VBL PU_TIME SET GAME_TIME
        CHANGE_VBL PU_TIME ADD PU_TIME_DELAY

        CHANGE_VBL RANDOM_LOC SET RANDOM_INT 11
        CHANGE_VBL RANDOM_POINT SET RANDOM_INT 1
        CHANGE_VBL SPU_RANDOM_LOC SET RANDOM_INT 3

        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 0)  (NOT( IS_ALIVE LOC_0)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_0 0 PU_1_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT  EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_0 0 PU_1_1 PU_RANDOM 1
                )
        )
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 1)  (NOT( IS_ALIVE LOC_1)) ))THEN
        #IF(VBL_TEST RANDOM_LOC EQUAL 1) THEN
        (
               IF(VBL_TEST RANDOM_POINT  EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_1 0 PU_2_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT  EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_1 0 PU_2_1 PU_RANDOM 1
                )
        )
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 2)  (NOT( IS_ALIVE LOC_2)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT  EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_2 0 PU_3_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_2 0 PU_3_1 PU_RANDOM 1
                )
        )
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 3)  (NOT( IS_ALIVE LOC_3)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_3 0 PU_4_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_3 0 PU_4_1 PU_RANDOM 1
                )
        )
        #IF(VBL_TEST RANDOM_LOC EQUAL 4) THEN
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 4)  (NOT( IS_ALIVE LOC_4)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT  EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_4 0 PU_5_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT  EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_4 0 PU_5_1 PU_RANDOM 1
                )
        )
#        IF(VBL_TEST RANDOM_LOC EQUAL 5) THEN
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 5)  (NOT( IS_ALIVE LOC_5)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT  EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_5 0 PU_6_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT  EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_5 0 PU_6_1 PU_RANDOM 1
                )
        )
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 6)  (NOT( IS_ALIVE LOC_6)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT  EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_6 0 PU_7_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT  EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_6 0 PU_7_1 PU_RANDOM 1
                )
        )
        #IF(VBL_TEST RANDOM_LOC EQUAL 7) THEN
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 7)  (NOT( IS_ALIVE LOC_7)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT  EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_7 0 PU_8_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_7 0 PU_8_1 PU_RANDOM 1
                )
        )
#        IF(VBL_TEST RANDOM_LOC EQUAL 8) THEN
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 8)  (NOT( IS_ALIVE LOC_8)) ))THEN
         (
               IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_8 0 PU_9_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_8 0 PU_9_1 PU_RANDOM 1
                )
        )
#        IF(VBL_TEST RANDOM_LOC EQUAL 9) THEN
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 9)  (NOT( IS_ALIVE LOC_9)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_9 0 PU_10_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_9 0 PU_10_1 PU_RANDOM 1
                )
        )
#        IF(VBL_TEST RANDOM_LOC EQUAL 10) THEN
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 10)  (NOT( IS_ALIVE LOC_10)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_10 0 PU_11_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_10 0 PU_11_1 PU_RANDOM 1
                )
        )
#        IF(VBL_TEST RANDOM_LOC EQUAL 11) THEN
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 11)  (NOT( IS_ALIVE LOC_11)) ))THEN
        (
               IF(VBL_TEST RANDOM_POINT EQUAL 0) THEN
               (
                        CREATE_FIXED_PU LOC_11 0 PU_12_0 PU_RANDOM 1
                )
               IF(VBL_TEST RANDOM_POINT EQUAL 1) THEN
               (
                        CREATE_FIXED_PU LOC_11 0 PU_12_1 PU_RANDOM 1
                )
        )
#Special PUs in center structures...
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 0)  (NOT( IS_ALIVE SLOC_0)) ))THEN
        (
                CREATE_FIXED_PU SLOC_0 0 SPU1 PU_RANDOM 1
        )
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 1)  (NOT( IS_ALIVE SLOC_1)) ))THEN
        (
                CREATE_FIXED_PU SLOC_1 0 SPU2 PU_RANDOM 1
        )
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 2)  (NOT( IS_ALIVE SLOC_2)) ))THEN
        (
                CREATE_FIXED_PU SLOC_2 0 SPU3 PU_RANDOM 1
        )
#        IF(VBL_TEST SPU_RANDOM_LOC EQUAL 3) THEN
        IF( AND ((VBL_TEST RANDOM_LOC EQUAL 3)  (NOT( IS_ALIVE SLOC_3)) ))THEN
        (
                CREATE_FIXED_PU SLOC_3 0 SPU4 PU_RANDOM 1
        )
)




	CHANGE_VBL P1_CIT_COUNT SET 0
	CHANGE_VBL P2_CIT_COUNT SET 0
	CHANGE_VBL P3_CIT_COUNT SET 0
	CHANGE_VBL P4_CIT_COUNT SET 0
	CHANGE_VBL IM_CIT_COUNT SET 0

	FOR CITADEL EQUAL 0 TO 9 DO
	(

		IF ( CITADEL_OWNED 0 CITADEL ) THEN
		(
			CHANGE_VBL P1_CIT_COUNT ADD 1
		)
		IF ( CITADEL_OWNED 1 CITADEL ) THEN
		(
			CHANGE_VBL P2_CIT_COUNT ADD 1
		)
		IF ( CITADEL_OWNED 2 CITADEL ) THEN
		(
			CHANGE_VBL P3_CIT_COUNT ADD 1
		)
		IF ( CITADEL_OWNED 3 CITADEL ) THEN
		(
			CHANGE_VBL P4_CIT_COUNT ADD 1
		)
		IF ( CITADEL_OWNED 4 CITADEL ) THEN
		(
			CHANGE_VBL IM_CIT_COUNT ADD 1
		)
	)


	IF ( VBL_TEST CIT_MESSAGE_SWITCH EQUAL 0 ) THEN
	(

		IF ( VBL_TEST P1_CIT_COUNT EQUAL 6 ) THEN
		(
			SHOW_BILLBOARD {PLAYER ONE OWNS TWO THIRDS OF THE CITADELS}
		)
		IF ( VBL_TEST P2_CIT_COUNT EQUAL 6 ) THEN
		(
			SHOW_BILLBOARD {PLAYER TWO OWNS TWO THIRDS OF THE CITADELS}
		)
		IF ( VBL_TEST P3_CIT_COUNT EQUAL 6 ) THEN
		(
			SHOW_BILLBOARD {PLAYER THREE OWNS TWO THIRDS OF THE CITADELS}
		)
		IF ( VBL_TEST P4_CIT_COUNT EQUAL 3 ) THEN
		(
			SHOW_BILLBOARD {PLAYER FOUR OWNS TWO THIRDS OF THE CITADELS}
		)
		IF ( VBL_TEST IM_CIT_COUNT EQUAL 3 ) THEN
		(
			SHOW_BILLBOARD {THE IMPERIUM OWNS TWO THIRDS OF THE CITADELS}
		)
	)
	ELSE
	(
		IF ( VBL_TEST P1_CIT_COUNT EQUAL 5 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
		IF ( VBL_TEST P2_CIT_COUNT EQUAL 5 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
		IF ( VBL_TEST P3_CIT_COUNT EQUAL 5 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
		IF ( VBL_TEST P4_CIT_COUNT EQUAL 5 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
		IF ( VBL_TEST IM_CIT_COUNT EQUAL 5 ) THEN
		(
			CHANGE_VBL CIT_MESSAGE_SWITCH SET 0
		)
	)




	IF ( CITADEL_OWNED_W_STRG_TOWER 4 ALL ) THEN
	(
		CHANGE_VBL MISSION_FAILED SET 1
	)
	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( CITADEL_OWNED_W_STRG_TOWER PLAYER_SLOT ALL ) THEN
		(
			END_MISSION PLAYER_SLOT 1 10 {MISSION ACCOMPLISHED}
			CHANGE_VBL MISSION_FAILED SET 1
		)
	)



	FOR PLAYER_SLOT EQUAL 0 TO 4 DO
	(
		IF ( VBL_TEST MISSION_FAILED EQUAL 1 ) THEN
		(

			IF ( NOT ( CITADEL_OWNED PLAYER_SLOT 0 ) ) THEN
			(
				END_MISSION PLAYER_SLOT 0 10 {MISSION FAILED}
			)
		)
	)










END_SCRIPT_FILE









































END_SCRIPT_FILE