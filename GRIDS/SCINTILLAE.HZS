				)

				IF ( NOT (CLOSE_PT HTANK 0 DROP61 4 )) THEN
				(
					CREATE_UNIT FTLD06  5  NP_BLDG_TECHCENTER DROP61 YAW (0)  NULL  NULL 

					CHANGE_VBL BONUS_RESET06 SET 0

				)

