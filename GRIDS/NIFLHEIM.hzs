START_SCRIPT_FILE

START_SECTION_OPTIONAL 


VDECL VINT TOTAL_IMP_UNITS 0
VDECL VINT TEMP_IMP_UNITS 0
VDECL VINT ACTION_TIME 0
VDECL VINT BONUS_TIME 0

IF ( VBL_TEST ACTION_TIME EQUAL 0 ) THEN
(
	IF ( OR ( ( IS_ALIVE TURRET01 ) ( IS_ALIVE TURRET02 ) ) ) THEN
	(
		IF ( AND ( ( NOT ( IS_ALIVE BAIT01 )) ( CLOSE_PT HTANK  0  LOC ( 237, 74, 0 ) 20 ) ) ) THEN
		(
			CREATE_FIXED_PU  BAIT01  0  LOC ( 237, 74, 10000 ) PU_HEALTH  150
			CHANGE_VBL ACTION_TIME SET GAME_TIME
			CHANGE_VBL ACTION_TIME ADD 45
		)
	)
)

IF ( VBL_TEST ACTION_TIME LESS_THAN GAME_TIME ) THEN
(
	CHANGE_VBL ACTION_TIME SET 0
)





IF ( VBL_TEST BONUS_TIME EQUAL 0 ) THEN
(

	IF ( NOT ( IS_ALIVE BONUS01 ) ) THEN
	(
		CREATE_FIXED_PU  BONUS01  0  LOC ( 114, 117, 10000 ) PU_SPECIAL_WEAPON_BOOST  2
		CHANGE_VBL BONUS_TIME SET GAME_TIME
		CHANGE_VBL BONUS_TIME ADD 120
	)
	
)

IF ( VBL_TEST BONUS_TIME LESS_THAN GAME_TIME ) THEN
(
	CHANGE_VBL BONUS_TIME SET 0
)







START_SECTION_SP_ONLY

# VICTORY CONDITIONS
IF ( VBL_TEST GAME_TIME GREATER_THAN 120 ) THEN
(
	IF ( NOT ( PLAYER_HAS_UNITS 4 )) THEN
	(
	
		# ENDING THE MISSION
		END_MISSION 0 1 10 { YOU'VE CAPTURED ALL THE ENEMY CITADELS AND THWARTED THEIR ATTACKS }
		SHOW_BILLBOARD { YOU WIN !!!!!!!!!!!! YOU WIN !!!!!!!!!!!! }
	
	)

)



END_SECTION

START_SECTION_MP_ONLY

END_SECTION

END_SECTION 


END_SCRIPT_FILE
